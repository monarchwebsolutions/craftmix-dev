<script defer>
(function () {
  function select36PackWithoutScroll() {
    // Find an input/option that represents "36 Pack"
    const radios = document.querySelectorAll(
      'fieldset.product-form__input input[type="radio"], .variant-selects input[type="radio"]'
    );

    let input = null;

    radios.forEach((r) => {
      // Match either the value or the label text
      const valueText = (r.value || '').trim().toLowerCase();
      if (valueText === '36 pack') input = r;
    });

    if (!input) return;

    const x = window.scrollX;
    const y = window.scrollY;
    const active = document.activeElement;

    // Set checked + dispatch change (most themes listen to change)
    input.checked = true;
    input.dispatchEvent(new Event('change', { bubbles: true }));

    // Restore scroll/focus
    window.scrollTo(x, y);
    requestAnimationFrame(() => window.scrollTo(x, y));
    if (active && typeof active.focus === 'function') active.focus({ preventScroll: true });
  }

  document.addEventListener('DOMContentLoaded', function () {
    setTimeout(select36PackWithoutScroll, 250);
  });
})();
</script>

