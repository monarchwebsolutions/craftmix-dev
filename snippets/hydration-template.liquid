{% comment %}JS Workaround for sticky .product-media-container |JT|{% endcomment %}
<script defer>
  document.addEventListener('DOMContentLoaded', () => {
    const parent = document.querySelector('.product-media-container');
    const stickyElem = document.querySelector('.pdp-images-section');
  
    function updateSticky() {
      // If viewport is less than 1024px, use normal static positioning.
      if (window.innerWidth < 1024) {
        stickyElem.style.position = 'static';
        stickyElem.style.top = '';
        stickyElem.style.right = '';
        stickyElem.style.width = '';
        return;
      }
  
      const parentRect = parent.getBoundingClientRect();
      const parentStyle = window.getComputedStyle(parent);
      const paddingLeft = parseFloat(parentStyle.paddingLeft) || 0;
      const paddingRight = parseFloat(parentStyle.paddingRight) || 0;
      const stickyHeight = stickyElem.offsetHeight;
      const innerWidth = parentRect.width - paddingLeft - paddingRight;
  
      // When parent's top is offscreen and there's room at the bottom...
      if (parentRect.top <= 0 && parentRect.bottom > stickyHeight) {
        stickyElem.style.position = 'fixed';
        stickyElem.style.top = '0';
        // Align right edge with parent's inner right edge.
        const isChrome = /Chrome/.test(navigator.userAgent) && !!window.chrome;
        const chromeAdjustment = isChrome ? 3 : 0;
        stickyElem.style.right = (window.innerWidth - parentRect.right + paddingRight - chromeAdjustment) + 'px';
        stickyElem.style.width = innerWidth + 'px';
      }
      // When parent's bottom is reached, switch to absolute positioning.
      else if (parentRect.bottom <= stickyHeight) {
        stickyElem.style.position = 'absolute';
        stickyElem.style.top = (parent.offsetHeight - stickyHeight) + 'px';
        stickyElem.style.right = paddingRight + 'px';
        stickyElem.style.width = (parent.offsetWidth - paddingLeft - paddingRight) + 'px';
      }
      // Otherwise, use normal static positioning.
      else {
        stickyElem.style.position = 'static';
        stickyElem.style.top = '';
        stickyElem.style.right = '';
        stickyElem.style.width = '';
      }
    }
  
    window.addEventListener('scroll', updateSticky);
    window.addEventListener('resize', updateSticky);
    updateSticky();
  });
</script>
<script defer>
  // Toggle subscription discounts and one-time discounts
  document.addEventListener('DOMContentLoaded', function () {
    const subscribeInput = document.getElementById('subscribe');
    const oneTimeInput = document.getElementById('one_time');

    const subscriptionDiscounts = document.querySelector('.subscription-discounts');
    const regularDiscounts = document.querySelector('.regular-discounts');

    function toggleDiscounts() {
      if (subscribeInput.checked) {
        subscriptionDiscounts.style.display = 'flex';
        regularDiscounts.style.display = 'none';
      } else if (oneTimeInput.checked) {
        subscriptionDiscounts.style.display = 'none';
        regularDiscounts.style.display = 'flex';
      }
    }

    // Initial check
    toggleDiscounts();

    // Add event listeners
    subscribeInput.addEventListener('change', toggleDiscounts);
    oneTimeInput.addEventListener('change', toggleDiscounts);
  });
</script>

