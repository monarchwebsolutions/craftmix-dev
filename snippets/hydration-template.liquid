<script defer>
  function jumpToReviewsAndFocus() {
    const section = document.querySelector('.custom-review-section');
    if (!section) return;

    section.scrollIntoView({ behavior: 'smooth', block: 'start' });

    const focusSelector = '#stamped-reviews-widget .stamped-products-reviews-title a[href], #stamped-reviews-widget .stamped-pagination a[tabindex="0"]';

    // Wait until scrolling stops (scroll position stable for a few frames)
    let lastY = window.scrollY;
    let stableFrames = 0;

    function afterScrollSettles() {
      const y = window.scrollY;

      if (Math.abs(y - lastY) < 2) {
        stableFrames += 1;
      } else {
        stableFrames = 0;
        lastY = y;
      }

      if (stableFrames >= 6) {
        const target = document.querySelector(focusSelector);

        if (target) {
          target.focus({ preventScroll: true });
        } else {
          // Fallback: focus the widget container so focus definitely moves
          const widget = document.getElementById('stamped-reviews-widget');
          if (widget) {
            widget.setAttribute('tabindex', '-1');
            widget.focus({ preventScroll: true });
          }
        }
        return;
      }

      requestAnimationFrame(afterScrollSettles);
    }

    requestAnimationFrame(afterScrollSettles);
  }

  document.addEventListener('keydown', (e) => {
    const trigger = document.activeElement?.closest('.stamped-product-reviews-badge');
    if (!trigger) return;

    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      jumpToReviewsAndFocus();
    }
  });

</script>
