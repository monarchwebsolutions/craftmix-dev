  selector.addEventListener('mouseleave', () => {
    const arrow = selector.querySelector('.navigation-arrow');
    if (arrow) arrow.style.display = 'none';
  });
});
</script>
<script>
// Focus trap logic
document.addEventListener('DOMContentLoaded', () => {
  const shopBtn = document.getElementById('header-shop-button');
  const megaMenu = document.querySelector('.mega-menu-container');
  if (!shopBtn || !megaMenu) return;

  // Add basic ARIA without changing your markup structure
  if (!megaMenu.id) megaMenu.id = 'header-mega-menu';
  shopBtn.setAttribute('aria-controls', megaMenu.id);
  shopBtn.setAttribute('aria-expanded', 'false');

  let lastFocusedEl = null;
  let trapActive = false;

  const focusableSelector = [
    'a[href]',
    'button:not([disabled])',
    'input:not([disabled])',
    'select:not([disabled])',
    'textarea:not([disabled])',
    '[tabindex]:not([tabindex="-1"])'
  ].join(',');

  function getFocusable(container) {
    return Array.from(container.querySelectorAll(focusableSelector))
      .filter(el => el.offsetParent !== null);
  }

  function isMenuOpen() {
    const style = getComputedStyle(megaMenu);
    return style.visibility !== 'hidden' && style.display !== 'none';
  }

  function activateTrap() {
    if (trapActive) return;
    trapActive = true;

    lastFocusedEl = document.activeElement;
    shopBtn.setAttribute('aria-expanded', 'true');

    // Move focus into menu (first focusable element)
    const focusables = getFocusable(megaMenu);
    if (focusables.length) {
      focusables[0].focus();
    }

    document.addEventListener('keydown', onKeyDown, true);
  }

  function deactivateTrap() {
    if (!trapActive) return;
    trapActive = false;

    shopBtn.setAttribute('aria-expanded', 'false');
    document.removeEventListener('keydown', onKeyDown, true);

    // Restore focus to the trigger (or previous focus)
    if (lastFocusedEl && typeof lastFocusedEl.focus === 'function') {
      lastFocusedEl.focus();
    } else {
      shopBtn.focus();
    }
  }

  function onKeyDown(e) {
    if (!isMenuOpen()) return;

    if (e.key === 'Escape') {
      e.preventDefault();
      shopBtn.click(); // uses your existing close logic
      return;
    }

    if (e.key !== 'Tab') return;

    const focusables = getFocusable(megaMenu);
    if (!focusables.length) {
      e.preventDefault();
      return;
    }

    const first = focusables[0];
    const last = focusables[focusables.length - 1];

    // If focus escaped, bring it back
    if (!megaMenu.contains(document.activeElement)) {
      e.preventDefault();
      first.focus();
      return;
    }

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
      return;
    }

    if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
      return;
    }
  }

  // Watch for open/close after your existing click handler runs
  shopBtn.addEventListener('click', () => {
    setTimeout(() => {
      if (isMenuOpen()) activateTrap();
      else deactivateTrap();
    }, 0);
  });

  // Safety: if something else closes the menu, ensure trap is removed
  const observer = new MutationObserver(() => {
    if (!isMenuOpen() && trapActive) deactivateTrap();
  });
  observer.observe(megaMenu, { attributes: true, attributeFilter: ['style', 'class'] });
});
</script>