<!doctype html>
<html
  class="no-js{% if settings.theme_mode_default == "dark" %} dark{% endif %}"
  lang="{{ request.locale.iso_code }}"
  {% if settings.lang_direction contains request.locale.iso_code %}
    dir="rtl"
  {% endif %}
>
  <head>
    {% if page.metafields.custom.og_image != blank %}
      {% assign og_image_url = page.metafields.custom.og_image | img_url: '1200x1200' %}
      <meta property="og:image" content="https:{{ og_image_url }}">
      <meta property="og:image:secure_url" content="https:{{ og_image_url }}">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="1200">
    {% endif %}
    <link
      rel="preload"
      as="style"
      href="{{ 'theme.min.css' | asset_url }}"
      onload="this.onload=null;this.rel='stylesheet'"
    >
    <link
      rel="preload"
      as="style"
      href="{{ 'universal-custom.css' | asset_url }}"
      onload="this.onload=null;this.rel='stylesheet'"
    >
    <link
      rel="preload"
      as="style"
      href="{{ 'keyboard-nav.css' | asset_url }}"
      onload="this.onload=null;this.rel='stylesheet'"
    >
    <link rel="preload" as="font" href="{{ 'Appetite-Regular.woff2' | asset_url }}" type="font/woff2" crossorigin>

    {% if template == 'index' %}
      <link
        rel="preload"
        as="style"
        href="{{ 'homepage-hero-custom.css' | asset_url }}"
        onload="this.onload=null;this.rel='stylesheet'"
      >
      <link
        rel="preload"
        as="image"
        href="{{ settings.hero_image | image_url }}"
        imagesrcset="{{ settings.hero_image | image_url: width: 1200 }}"
        fetchpriority="high"
        type="image/webp"
      >
      <link
        rel="preload"
        as="image"
        href="/cdn/shop/{{ settings.hero_badges.src | replace: '.png', '_1024x.png' }}"
        fetchpriority="high"
        type="image/png"
      >
      <!--
        <link rel="preload" as="image" href="{{ 'pineapple.svg' | asset_url }}" type="image/svg+xml">
        <link rel="preload" as="image" href="{{ 'wave-placeholder.png' | asset_url }}" type="image/png">
      -->
      <link
        rel="preload"
        as="image"
        href="{{ all_products[settings.hero_tool_tip_product_global].featured_image | image_url: width: 200 }}"
        imagesrcset="{{ all_products[settings.hero_tool_tip_product_global].featured_image | image_url: width: 200 }} 1x"
        imagesizes="86px"
      >
      {% comment %} <link rel="stylesheet" href="{{ 'homepage.min.css' | asset_url }}"> {% endcomment %}
    {% elsif request.path == '/products' %}
      <script>
        window.location.href = '/collections/flavors-2024';
      </script>
    {% endif %}
    <script>
      window.Eurus = {
        sliderScript: '{{ 'splide4.1.3.js' | asset_url }}',
        cart_error: `{{ 'sections.cart.cart_error' | t }}`,
        cart_quantity_error_html: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
        loadedScript: [],
        cart_add_url: '{{ routes.cart_add_url }}'
      };
    </script>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=1.0"
    >
    <meta name="theme-color" content="">
    <script src="{{ 'custom.js' | asset_url }}"></script>
    <script src="{{ 'keyboard-nav.js' | asset_url }}" defer></script>

    {% if settings.show_canonical_url_collection and template.name == 'collection' %}
      <link rel="canonical" href="{{ canonical_url | split: '?' | first }}">
    {% else %}
      <link rel="canonical" href="{{ canonical_url }}">
    {% endif %}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if settings.enable_organization_schema and template.name == 'index' -%}
      {% liquid
        if settings.business_address_1 != null
          assign first_business_addr = settings.business_address_1 | split: ','
        endif
        if settings.business_address_2 != null
          assign second_business_addr = settings.business_address_2 | split: ','
        endif
      %}
      <script type="application/ld+json">
        {
          "@context": "http://schema.org",
          "@type": "{{ settings.site_type }}",
          "name": "{{ settings.business_name }}",
          "description": "{{ settings.business_description }}",
          {% if settings.business_logo != blank %}
          "logo": {{ settings.business_logo | image_url: width: 112 | prepend: "https:" | json }},
          {% endif %}
          "telephone": "{{ settings.business_phone }}",
          "address": [{
            "@type": "PostalAddress",
            "streetAddress": "{{ first_business_addr[0] }}",
            "addressLocality": "{{ first_business_addr[1] }}",
            "addressRegion": "{{ first_business_addr[2] }}",
            "postalCode": "{{ first_business_addr[3] }}",
            "addressCountry": "{{ first_business_addr[4] }}"
          },{
            "streetAddress": "{{ second_business_addr[0] }}",
            "addressLocality": "{{ second_business_addr[1] }}",
            "addressRegion": "{{ second_business_addr[2] }}",
            "postalCode": "{{ second_business_addr[3] }}",
            "addressCountry": "{{ second_business_addr[4] }}"
          }],
          "email": "{{ settings.business_email }}"
        }
      </script>
    {%- endif -%}

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% liquid
      render 'meta-tags'
      render 'font-face'
      echo 'theme.min.css' | asset_url | stylesheet_tag: preload: true
      render 'css-variables'
      render 'theme-mode-control'
    %}
    {% if request.page_type == 'policy' %}
      {{ 'page.css' | asset_url | stylesheet_tag: preload: true }}
    {% endif %}
    <!-- Preload Images -->
    {% if template == 'page.about' %}
      <link
        rel="preload"
        as="image"
        href="https://cdn.shopify.com/s/files/1/2340/1623/files/about-hero-bg.png?v=1740166249"
      >
    {% elsif template == 'page.faq' %}
      <link rel="preload" as="image" href="{{ 'faq-main-hero-img.png' | asset_url }}">
    {% endif %}
    {{ content_for_header }} 
    {{ settings.additional_head }}
    <style>
      /* for klayvio discount widget */
      body.overflow-hidden.padding-scrollbar .kl-teaser-XYRmyK,
      body.rebuy-cart-visible .kl-teaser-XYRmyK {
        z-index: 49 !important;
      }

      /* Sticky Announcement Bar and Header Wrapper */
      .sticky-announcement-header-wrapper {
        position: relative;
        z-index: 50;
      }
      .sticky-announcement-header-wrapper.is-sticky {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        z-index: 50;
        box-shadow: 0 5px 15px 0 rgba(0, 0, 0, 0.1);
        animation: slideDown 0.4s ease-out;
      }
      @keyframes slideDown {
        from {
          transform: translateY(-100%);
        }
        to {
          transform: translateY(0); 
        }
      }
      /* Override header's own sticky behavior when wrapper is sticky */
      .sticky-announcement-header-wrapper #sticky-header.sticky-header {
        position: static !important;
        box-shadow: none !important;
      }
      .sticky-announcement-header-wrapper #x-header-container {
        position: static !important;
      }
      /* Ensure header content stays visible */
      .sticky-announcement-header-wrapper .sticky-header-content {
        position: relative !important;
      }
    </style>
    <script>
      window.Shopify = window.Shopify || {theme: {id: {{ theme.id }}, role: '{{ theme.role }}' } };
      window._template = {
          directory: "{{ template.directory }}",
          name: "{{ template.name }}",
          suffix: "{{ template.suffix }}"
      };
    </script>
    <script
      type="module"
      blocking="render"
      fetchpriority="high"
      src="https://cdn.intelligems.io/esm/29ae23c11802/bundle.js"
      async
    ></script>
    <script type="text/javascript">
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', 'tiw1y68h8q');
    </script>
  </head>
  <body
    class="gradient scrollbar-body overflow-x-hidden text-[{{ settings.text_base_size | times: 0.007875 }}rem] md:text-[{{ settings.text_base_size | times: 0.00875 }}rem]{% if settings.lang_direction contains request.locale.iso_code %} rtl{% endif %}"
    x-data="{ runDispatch: true }"
    :class="($store.xPopup.open || $store.xPopup.openVideoShopping) && 'overflow-hidden padding-scrollbar'"
    x-init="$store.xPopup.setWidthScrollbar();{% if request.design_mode %} document.addEventListener('shopify:section:load', ()=>{ runDispatch = true }){% endif %}"
    x-on:mouseover="if (runDispatch) { $dispatch('init-run'); runDispatch = false; }"
    x-on:touchstart="
      if (runDispatch) {
        if (event.target.parentNode.parentNode.id == 'SearchOpen' || event.target.parentNode.id == 'SearchOpen') { setTimeout(() => {  document.querySelector('#SearchOpen').click() }, 200) }
        if (event.target.parentNode.parentNode.id == 'cart-icon' || event.target.parentNode.id == 'cart-icon') { setTimeout(() => {  document.querySelector('#cart-icon').click() }, 200) }
        if (event.target.parentNode.id == 'mobile-navigation' || event.target.id == 'mobile-navigation') { setTimeout(() => {  document.querySelector('#mobile-navigation').click() }, 200) }
        $dispatch('init-run'); runDispatch = false;
      }
    "
  >
    <div class="main-container flex flex-col min-h-screen relative">
      <a
        class="skip-to-content absolute -z-10 button button-solid lg:block pt-2.5 pb-2.5 pl-6 pr-6 lg:pt-3 lg:pb-3 mt-0.5 ml-0.5 leading-normal justify-center cursor-pointer focus-visible:z-60"
        href="#MainContent"
      >
        {{ 'accessibility.skip_to_text' | t }}
      </a>

      <div id="sticky-announcement-header-wrapper" class="sticky-announcement-header-wrapper">
        {% case settings.selected_preset %}
          {% when 'breath' %}
            {% sections 'header-group-breath' %}
          {% when 'swirl' %}
            {% sections 'header-group-swirl' %}
          {% when 'whiff' %}
            {% sections 'header-group-whiff' %}
          {% when 'puff' %}
            {% sections 'header-group-puff' %}
          {% else %}
            {% sections 'header-group' %}
        {% endcase %}
      </div>

      {% case settings.selected_preset %}
        {% when 'breath' %}
          {% sections 'aside-group-breath' %}
        {% when 'swirl' %}
          {% sections 'aside-group-swirl' %}
        {% when 'whiff' %}
          {% sections 'aside-group-whiff' %}
        {% when 'puff' %}
          {% sections 'aside-group-puff' %}
        {% else %}
          {% sections 'aside-group' %}
      {% endcase %}

      <main
        id="MainContent"
        class="content-for-layout focus-none outline-none grow theme-template-{{ template.name }} theme-template-suffix-{{ template.suffix | default: 'none' }}"
        role="main"
        tabindex="-1"
      >
        {{ content_for_layout }}
      </main>
      {% if template == 'index' %}
        <link fetchpriority="high" rel="stylesheet" href="{{ 'homepage.css' | asset_url }}">
        {{- 'flickity.css' | asset_url | stylesheet_tag -}}
      {% endif %}
      {% unless template contains 'lander' or template contains 'landing' %}
        {% case settings.selected_preset %}
          {% when 'breath' %}
            {% sections 'footer-group-breath' %}
          {% when 'swirl' %}
            {% sections 'footer-group-swirl' %}
          {% when 'whiff' %}
            {% sections 'footer-group-whiff' %}
          {% when 'puff' %}
            {% sections 'footer-group-puff' %}
          {% else %}
            {% sections 'footer-group' %}
        {% endcase %}
      {% endunless %}

      {% render 'popups' %}

      {% if settings.enable_scroll_top_desktop or settings.enable_scroll_top_mobile %}
        {% render 'scroll-to-top' %}
      {% endif %}

      {% render 'popup-price-detail' %}
      
      {% comment %} Sticky Add to Cart - Only show on product pages {% endcomment %}
      {% if template contains 'product' %}
        {% render 'sticky-atc' %}
      {% endif %}
    </div>
    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    {%- if settings.enable_featured_discount -%}
      <script src="{{ 'coupon-code.js' | asset_url }}" defer></script>
    {%- endif -%}
    {%- if settings.show_cart_custom_field and settings.cart_custom_field_label != blank -%}
      <script src="{{ 'cart-fields.js' | asset_url }}" defer></script>
    {%- endif -%}
    {%- if settings.cart_enable_terms_and_conditions -%}
      <script src="{{ 'cart-term.js' | asset_url }}" defer></script>
    {%- endif -%}
    {% if settings.enable_upsell_minicart %}
      <script src="{{ 'product-recommendations.js' | asset_url }}" defer></script>
    {% endif %}
    {%- if settings.enable_estimate_shipping -%}
      <script src="{{ 'estimate-shipping-rate.js' | asset_url }}" defer></script>
    {%- endif -%}
    {% if settings.swatches_type == 'both_text_and_color' %}
      <script src="{{ 'preview-color-swatches.js' | asset_url }}" defer></script>
    {%- endif -%}
    {%- if request.design_mode -%}
      <script src="{{ 'theme-editor-alpine-custom.js' | asset_url }}" defer></script>
      <script src="{{ 'theme-editor.js' | asset_url }}" defer></script>
    {%- endif -%}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'vendors.js' | asset_url }}" defer></script>
    <script src="https://cdn1.stamped.io/files/widget.min.js" defer></script>
    <script>
      console.log('[Stamped Debug] This theme.liquid is definitely loading.');
    </script>
    <script>
      window.addEventListener("load", (event) => {
        deferScriptLoad('instant.page', '{{ 'instant.page.v5.1.1.js' | asset_url }}', () => {}, true);
      });
    </script>

    {%- comment -%}
      Adds a background color to the section containing the Stamped full-page reviews widget.
      Supports both modern browsers (via CSS :has) and Firefox (via JS class fallback).
      This script runs only on product pages and the /pages/reviews page.
    {%- endcomment -%}
    {% if template contains 'product' or template == 'page.reviews' %}
      <script>
        document.addEventListener('DOMContentLoaded', function () {
          const stamped = document.querySelector('#stamped-reviews-widget[data-widget-type="full-page"]');
          if (stamped) {
            const section = stamped.closest('section');
            if (section) {
              section.classList.add('has-full-page-reviews');
            }
          }
        });
      </script>
    {% endif %}
    {% if template == 'index' %}
      <script src="{{ 'flickity.pkgd.min.js' | asset_url }}" defer></script>
      <script src="{{ 'custom-carousel-card-video.js' | asset_url }}" defer></script>
      <script src="{{ 'custom-carousel.js' | asset_url }}" defer="defer"></script>
      <!-- <script src="{{ 'swiper.js' | asset_url }}" defer></script> -->
      <script src="https://cdn.jsdelivr.net/npm/swiper@6.8.4/swiper-bundle.min.js" defer></script>
    {% endif %}
    <script src="{{ 'lottie.js' | asset_url }}" defer></script>
    <script src="{{ 'lottie-lazy.js' | asset_url }}" defer></script>
    <script>
      // Sticky Announcement Bar and Header Wrapper Script
      (function() {
        let stickyWrapper = null;
        let isStickyEnabled = false;
        let ticking = false;
        let wrapperHeight = 0;
        let placeholder = null;

        function initStickyWrapper() {
          stickyWrapper = document.getElementById('sticky-announcement-header-wrapper');
          if (!stickyWrapper) return;

          // Check if sticky is enabled
          const headerContainer = document.getElementById('x-header-container');
          isStickyEnabled = headerContainer && headerContainer.hasAttribute('data-is-sticky');

          if (!isStickyEnabled) return;

          // Create placeholder to prevent content jump
          placeholder = document.createElement('div');
          placeholder.id = 'sticky-wrapper-placeholder';
          placeholder.style.display = 'none';
          stickyWrapper.parentNode.insertBefore(placeholder, stickyWrapper);

          // Initialize
          wrapperHeight = stickyWrapper.offsetHeight;

          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onResize);
          
          // Initial check
          handleScroll();
        }

        function onScroll() {
          if (!ticking) {
            window.requestAnimationFrame(function() {
              handleScroll();
              ticking = false;
            });
            ticking = true;
          }
        }

        function onResize() {
          if (stickyWrapper) {
            wrapperHeight = stickyWrapper.offsetHeight;
            if (placeholder && stickyWrapper.classList.contains('is-sticky')) {
              placeholder.style.height = wrapperHeight + 'px';
            }
          }
        }

        function handleScroll() {
          if (!stickyWrapper || !isStickyEnabled) return;

          const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
          
          // Immediate sticky behavior - becomes sticky as soon as user scrolls
          if (scrollTop > 0) {
            if (!stickyWrapper.classList.contains('is-sticky')) {
              stickyWrapper.classList.add('is-sticky');
              placeholder.style.display = 'block';
              placeholder.style.height = wrapperHeight + 'px';
            }
          } else {
            stickyWrapper.classList.remove('is-sticky');
            placeholder.style.display = 'none';
          }
        }

        // Initialize when DOM is ready
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initStickyWrapper);
        } else {
          initStickyWrapper();
        }
      })();
    </script>
  </body>
</html>
