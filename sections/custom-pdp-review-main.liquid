<div class="custom-review-section">
  <div class="main-review-container">
    <div class="main-review-main">
      <div class="main-review-header">
        <div 
          class="stamped-product-reviews-badge" 
          data-id="{{ product.id }}" 
          data-name="{{ product.title | escape }}" 
          data-url="{{ shop.url }}{{ product.url }}"
          style="display: none;">
        </div>
        <div class="main-review-info"  data-product-id="{{ product.id }}">
          <h2 class="main-review-header-title">Product Reviews</h2>
          <div class="main-review-header-stars">
            <img src="{{ 'stars-dark.png' | asset_url   }}"  width="105" height="18" alt="Review Stars" loading="lazy">
             <p class="main-review-average">0.0</p>
          </div>
          <p class="main-reviews-header-number">0 reviews</p>
          <div class="main-review-header-gallery">
            <img class="main-review-gallery-image" src="https://cdn.shopify.com/s/files/1/2340/1623/files/test-gallery-img-1.png?v=1739298888" width="116" height="116" alt="Gallery image of cocktails and mocktails" loading="lazy">
            <img class="main-review-gallery-image" src="https://cdn.shopify.com/s/files/1/2340/1623/files/test-gallery-img-2.png?v=1739298889" width="116" height="116" alt="Gallery image of cocktails and mocktails" loading="lazy">
            <img class="main-review-gallery-image" src="https://cdn.shopify.com/s/files/1/2340/1623/files/test-gallery-img-3.png?v=1739298888" width="116" height="116" alt="Gallery image of cocktails and mocktails" loading="lazy">
            <img class="main-review-gallery-image" src="https://cdn.shopify.com/s/files/1/2340/1623/files/test-gallery-img-4.png?v=1739298888" width="116" height="116" alt="Gallery image of cocktails and mocktails" loading="lazy">
            <img class="main-review-gallery-image" src="https://cdn.shopify.com/s/files/1/2340/1623/files/test-gallery-img-5.png?v=1739298888" width="116" height="116" alt="Gallery image of cocktails and mocktails" loading="lazy">
            <img class="main-review-gallery-image" src="https://cdn.shopify.com/s/files/1/2340/1623/files/test-gallery-img-6.png?v=1739298888" width="116" height="116" alt="Gallery image of cocktails and mocktails" loading="lazy">
          </div>
        </div>
    
      </div>
    </div>
  </div>
</div>
{% style %}
*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

ul {
  list-style: none;
}

a {
  text-decoration: none;
}

img {
  max-width: 100%;
}

.custom-review-section {
  padding-top: 50px;
  /* padding-bottom: 50px; */
  background-color: #fff9f5;
}
.main-review-container {
  margin: 0 auto;
  max-width: 1400px;
}
.main-review-main {
  width: 753px;
  margin: 0 auto;
}

.main-review-header {
}
.main-review-info {
}
.main-review-header-title {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 64px;
  font-weight: 700;
  font-style: Bold;
  letter-spacing: -1.68px;
  text-align: center;
  line-height: 54px;
  margin-bottom: 30px;
}

.main-review-header-stars {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  font-family: 'Goldplay';
  color: #002657;
  margin-bottom: 15px;
}

.main-review-header-stars p {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.43px;
  text-align: left;
  line-height: 17px;
  text-transform: uppercase;
  margin-left: 12px;
}

.main-reviews-header-number {
  opacity: 1;
  color: #002657;
  font-family: 'Goldplay';
  font-size: 15px;
  font-weight: 600;
  font-style: SemiBold;
  letter-spacing: -0.09px;
  text-align: center;
  line-height: 16px;
}

.main-review-header-gallery {
  width: 100%;
  padding-top: 47px;
  padding-bottom: 32px;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 11px;
  border-bottom: 1.5px solid #002657;
}

.main-review-gallery-image {
  height: 116px;
  width: 116px;
  border-radius: 12px;
  object-fit: cover;
}

.main-review {
  display: flex;
  flex-direction: row;
  padding-top: 37px;
  padding-bottom: 33px;
  border-bottom: 1.5px solid rgba(0, 38, 87, 0.08);
  opacity: 1;
}



@media screen and (max-width: 798px) {
