    border-radius: 8px;
  }
}


@media screen and (max-width: 600px) {
  .main-review-header-gallery {
    justify-content: start;
   
  }
}

@media screen and (max-width: 410px) {
  .main-review-header-gallery {
    justify-content: center;
  }
}
  
@media screen and (max-width: 400px) {
  .main-review-main {
    padding: 0 10px;
  }

  .main-review-header-title {
    font-size: 28px;
    line-height: 32px;
  }
}


{% endstyle %}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function updateMainReviewInfo() {
      const section = document.querySelector('.main-review-info');
      if (!section) return;

      const productId = section.dataset.productId;
      const badgeEl = document.querySelector(`.stamped-product-reviews-badge[data-id="${productId}"] .stamped-badge`);
      if (!badgeEl) {
        console.warn('[Stamped Debug] No badge found on product page');
        return;
      }

      const avg = badgeEl.getAttribute('data-rating') || '0.0';
      const label = badgeEl.getAttribute('aria-label') || '';
      const match = label.match(/(\d+)\s+review/);
      const count = match ? match[1] : '0';

      const avgEl = section.querySelector('.main-review-average');
      const countEl = section.querySelector('.main-reviews-header-number');

      if (avgEl) avgEl.textContent = avg;
      if (countEl) countEl.textContent = `${count} review${count !== '1' ? 's' : ''}`;
    }

    const badgeEl = document.querySelector('.stamped-product-reviews-badge');
    const observer = new MutationObserver(() => {
      updateMainReviewInfo();
    });

    if (badgeEl) {
      observer.observe(badgeEl, { childList: true, subtree: true });
    }

    // Fallback if mutation doesn't fire
    setTimeout(updateMainReviewInfo, 1500);
  });
</script>
