  }
  .main-review-header-title {
    font-size: 40px;
    letter-spacing: -1.05px;
    line-height: 40px;
  }
  .main-review-header-stars {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    font-family: 'Goldplay';
    color: #002657;
    margin-bottom: 15px;
  }

  .main-review {
    display: flex;
    flex-direction: column;
  }
}

@media screen and (max-width: 798px) {
  .main-review-main {
    max-width: 389px;
  }

  .main-review-header-gallery {
    justify-content: center;
    gap: 5px;
  }

  .main-review-gallery-image {
    height: 91px;
    width: 91px;
    border-radius: 12px;
  }
}

@media screen and (max-width: 798px) {
  .main-review-main {
    max-width: 100%;
    padding: 0 15px;
    box-sizing: border-box;
  }

  .main-review-header-title {
    font-size: 32px;
    letter-spacing: -0.84px;
    line-height: 36px;
  }

  .main-review-header-stars {
    flex-wrap: wrap;
    justify-content: center;
  }

  .main-review {
    flex-direction: column;
  }

  .main-review-client-details,
  .main-review-client-review {
