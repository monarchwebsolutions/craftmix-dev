{%  liquid 
if settings.lang_direction contains request.locale.iso_code
  assign is_rtl = true
else
  assign is_rtl = false
endif
%}
<div class="customer-login">
  <div class="customer-login-form_container"
    x-data="{ currentTab: 'login' }"
    x-init="() => {
      if (window.location.href.includes('#recover')) {
        currentTab = 'recover';
      }
    }"
  >
    <img class="background-fruit fruit-blueberry" src="https://cdn.shopify.com/s/files/1/2340/1623/files/blueberry.svg?v=1738881007" width="106" height="110" alt="Blueberry illustration">
    <img class="background-fruit fruit-pinapple" src="https://cdn.shopify.com/s/files/1/2340/1623/files/pineapple.svg?v=1738879807" width="418" height="400" alt="Pinapple illustration">
    <img class="background-fruit fruit-cherry"  src="https://cdn.shopify.com/s/files/1/2340/1623/files/cherry.svg?v=1738879947" width="144" height="200" alt="Cherry illustration">
    <img class="background-fruit fruit-passionfruit" src="https://cdn.shopify.com/s/files/1/2340/1623/files/passionfruit.svg?v=1738880574" width="207" height="210" alt="Passionfruit illustration">
    <img class="background-fruit fruit-tropical-leaf" src="https://cdn.shopify.com/s/files/1/2340/1623/files/tropical-leaf.svg?v=1738880888" width="280" height="270" alt="Tropical leaf illustration">
    <img class="background-fruit fruit-orangepeel" src="https://cdn.shopify.com/s/files/1/2340/1623/files/orangepeel.svg?v=1738880141" width="239" height="210" alt="Orange peel illustration">
    
    <h2 class="customer-login-form-title" x-text="currentTab === 'login' ? 'Log in' : (currentTab === 'recover' ? 'Reset your password' : 'Create account')"></h2>
    <!-- Recover Password Form -->
    <div id="recover" x-show="currentTab === 'recover'" x-cloak>
      <div>
        <p class="form-links">
          {{ 'customer.recover_password.subtext' | t }}
        </p>
        {%- form 'recover_customer_password' -%}
          {% assign recover_success = form.posted_successfully? %}
          <label for="RecoverEmail" class="visually-hidden">Recover Email</label>
          <div class="form-group">
            <input type="email"
              id="RecoverEmail"
              class="w-full"
              value=""
              name="email"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              aria-required="true"
              required="required" 
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="RecoverEmail-email-error"
                autofocus
              {% endif %}
              placeholder="{{ 'customer.login_page.email' | t }}"
            >
          </div>
          {%- if form.errors -%}
            <small id="RecoverEmail-email-error" class="customer-login-form_error-container">
              {{ form.errors.messages.form }}
            </small>
          {%- endif -%}
          <div class="form-login">
            <button type="submit" class="btn-login">
              {{ 'customer.login_page.submit' | t }}
            </button>
          </div>
          <div class="form-links">
            <p>
              <a href="#" @click.prevent="currentTab = 'login'" data-no-instant>
                {{ 'customer.login_page.cancel' | t }}
              </a>
            </p>
          </div>
        {%- endform -%}
      </div>
    </div>
    <!-- Login Form -->
    <div id="login" x-show="currentTab === 'login'">
      {%- form 'customer_login' -%}
        {% if form.errors %}
          <div class="customer-login-form_error-container">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
        <div class="form-group">
          <label for="customerEmail">
            <span class="visually-hidden">Email Address</span>
            <input type="email"
            name="customer[email]"
            id="customerEmail"
            placeholder="Username"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email">
          </label>
        </div>
        <div class="form-group">
          <label for="customerPassword">
            <span class="visually-hidden">Password</span>
            <input type="password"
            placeholder="Password"
            name="customer[password]"
            id="customerPassword">
          </label>
        </div>
        <div class="form-login">
          <input class="btn-login" type="submit" value="Log In" />
        </div>
        
        <div class="form-links">
          <p>
            {{ 'Register for an account' | customer_register_link }}
          </p>
          <div class="break">
            <hr>
          </div>
          <p>
            <a href="#" @click.prevent="currentTab = 'recover'">Forgot your password?</a>
          </p>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>


<div class="subscribe-card-section">
  <div class="subscribe-card">
    <img class="subscribe-card-image" src="https://cdn.shopify.com/s/files/1/2340/1623/files/subscribe-card.svg?v=1737762251" width="297" height="175" alt="Cocktail illustration">

    <div class="subscribe-card-text">
      <h2>Never get left dry!</h2>
      <p>Subscribe & save 15% today</p>
    </div>
    <div class="subscribe-card-cta">
      <a href="/pages/subscriptions" class="subscribe-card-btn">
        Subscribe today - Learn more
      </a>
    </div>
  </div>
</div>

{% style %}

/* ****************** */
/* ***** Start ******* */
/* ****************** */
/* * * Login Form * * */
/* ****************** */
.customer-login #recover {
  width: 100%;
  max-width: 500px;
  margin: 0 auto;
}

.customer-login #recover .form-links {
  text-align: center;
  margin-top: 20px;
}

.customer-login #recover .form-links a {
  color: #002657;
  text-decoration: underline;
}

  .customer-login {
    background-color: #ddf7f7;
  }
  section.customer-login {
    background-color: #ddf7f7;
    min-height: 500px;
  }
  /* position relative for placement of background svgs */
  .customer-login {
    position: relative;
  }

  .customer-login-form-title {
    opacity: 1;
    color: rgba(0, 38, 87, 1);
    font-family: "Hornbill";
    font-size: 64px;
    font-weight: 700;
    letter-spacing: -1.68px;
    text-align: center;
    line-height: 54px;
    position: relative; 
    z-index: 2;
  }

  
  .customer-login-form_container {
    position: relative;
    margin: 0 auto;
    padding-top: 70px;
    padding-bottom: 65px;
    padding: 70px 10px 65px 10px;
    max-width: 500px;
    display: flex;
    flex-direction: column;
    /* justify-content: center; */
    align-items: center;
    text-align: center;
  }

  .customer-login-form_error-container {
    font-family: "Hornbill";
    color: red;
  }
  
  .customer-login-form-title {
    font-size: 64px;
    text-align: center;
    margin-bottom: 60px;
  }

   .form-group input {
    border-radius: 30px;
    border: 1.5px solid #002657;
    opacity: 1;
    background-color: #ffffff;
    width: 480px;
    padding-top: 18px;
    padding-bottom: 17px;
    padding-left: 33px;
    padding-right: auto;
    margin-bottom: 20px;
    color: rgba(0, 38, 87, 1);
    font-family: 'Goldplay';
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.11px;
    text-align: left;
    line-height: 24px;
  }

  .form-group input::placeholder {
    opacity: 0.5;
    color: rgba(0, 38, 87, 1);
    font-family: 'Goldplay';
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.11px;
    text-align: left;
    line-height: 24px;
  }


  .form-login .btn-login {
    border-radius: 33px;
    border: 1.5px solid #002657;
    box-shadow: 2px 6px 0px #002657;
    opacity: 1;
    background-color: #60d3f8;
    font-family: 'Goldplay';
    font-weight: 600;
    font-size: 20px;
    margin-top: 25px;
    margin-bottom: 74px;
    width: 388px;
    padding-top: 20px;
    padding-bottom: 20px;
    cursor: pointer;
    transition: box-shadow 0.4s ease;
  }

  .form-login .btn-login:hover {
    box-shadow: none; 
  }
  
  .form-links p {
    font-family: 'Goldplay';
    font-weight: 600;
    font-size: 18px;
    color: #002657;
    display: block;
    text-align: center;
}
  .form-links .break hr {
    width: 213px;
    margin: 14px auto;
    color: #002657;
    border: 1.5px solid #002657;
    opacity: 1;
}

/* ****************** */
/* ***** Start ******* */
/* *  Login Form * */
  /* Media Queries */
/* ****************** */

  
@media screen and (max-width: 578px) {

  h2.customer-login-form-title {
