/* * Subscribe Card * */
/* ****************** */
.subscribe-card-section {
  background-color: #ddf7f7;
  padding: 50px 0;
  position: relative;
}

.subscribe-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1390px;
  height: 122px;
  font-family: 'Goldplay', sans-serif;
  font-weight: 600;
  margin: 0 auto;
  padding: 0 20px;
  background-color: #fff0bd;
  border-radius: 20px;
  box-shadow: 10px 10px 20px rgba(0, 0, 0, 0.13);
  opacity: 1;
  overflow: hidden;
  z-index: 2;
}

.subscribe-card-image {
  width: auto;
  height: 175px;
  align-self: flex-end;
  overflow: hidden;
  margin-bottom: -70px;
}

.subscribe-card-text {
  flex: 1;
  padding-left: 20px;
}

.subscribe-card-text h2 {
  font-size: 30px;
  color: #002657;
  margin: 0;
}

.subscribe-card-text p {
  font-size: 18px;
  color: #002657;
  margin: 0;
}

.subscribe-card-btn {
  display: inline-block;
  padding: 10px 30px;
  border-radius: 33px;
  font-family: 'Goldplay', sans-serif;
  font-size: 20px;
  border: 1.5px solid rgba(0, 38, 87, 1);
  box-shadow: 2px 6px 0px rgba(0, 38, 87, 1);
  background-color: #60d3f8;
  color: #002657;
  cursor: pointer;
  transition: all 0.2s;
}

.subscribe-card-btn:hover {
  box-shadow: none;
}

