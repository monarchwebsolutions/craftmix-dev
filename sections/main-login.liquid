  }

  h2.customer-login-form-title {
    font-size: 40px;
    line-height: 32px;
    margin-bottom: 46px;
  }

  .form-group input {
    padding: 18px 15px;
    font-size: 14px;
  }

  .form-login .btn-login {
    padding: 20px 12px;
    font-size: 16px;
    margin-top: 0;
  }

  .form-links p {
    font-size: 16px;
  }

  .form-login .btn-login {
    margin-bottom: 32px;
  }

 .form-links .break hr {
    width: 177px;
  }
}

@media screen and (max-width: 370px) {
  .customer-login-form_container {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  h2.customer-login-form-title {
    font-size: 24px;
    line-height: 28px;
    margin-bottom: 60px;
  }

  .form-group {
    width: 100%;
  }

  .form-group input {
    width: 100%;
    max-width: 100%;
    padding: 10px 12px;
    margin: 0 0 15px 0;
    font-size: 13px;
    box-sizing: border-box;
  }

  #login, 
  .form-login {
    width: 100%;
  }

  .form-login .btn-login {
    width: 100%;
    max-width: 100%;
    margin-top: 20px;
    margin-bottom: 40px;
    padding: 10px;
    font-size: 15px;
    box-sizing: border-box;
  }

  .form-links {
    width: 100%;
  }

  .form-links p {
    font-size: 13px;
  }

  .form-links .break hr {
