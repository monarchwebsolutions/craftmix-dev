{% liquid
  assign s = section.settings
  assign bullet_blocks = section.blocks | where: 'type', 'bullet'
  assign hero_image_count = 0
  for block in section.blocks
    if block.type == 'image_slide' and (block.settings.image != blank or block.settings.asset_image != blank)
      assign hero_image_count = hero_image_count | plus: 1
    endif
  endfor
%}
<style>
