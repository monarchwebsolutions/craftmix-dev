      position: relative;
      overflow: hidden;
      padding: 51px 137px  26px 193px ;
      background: {{ s.background | default: 'linear-gradient(180deg, #FFF5EB 0%, #EDC6A4 100%)' }};
    }
    #espresso-hero-{{ section.id }} .espresso-hero__grid {
      display: grid;
      gap: clamp(1.75rem, 3vw, 3.25rem);
      align-items: center;
      grid-template-columns: 1fr;
      padding:0;
    }

