  }
}

@media screen and (max-width: 798px) {
  .product-review-main {
    max-width: 389px;
  }

  .product-review-header-gallery {
    justify-content: start;
    gap: 5px;
  }

  .product-review-gallery-image {
    height: 91px;
    width: 91px;
    border-radius: 12px;
  }
}

@media screen and (max-width: 798px) {
  .product-review-main {
    max-width: 100%;
    padding: 0 15px;
    box-sizing: border-box;
  }

  .product-review-header-title {
    font-size: 32px;
    letter-spacing: -0.84px;
    line-height: 36px;
  }

  .product-review-header-stars {
    flex-wrap: wrap;
    justify-content: center;
  }

  .product-review {
    flex-direction: column;
  }

  .product-review-client-details,
  .product-review-client-review {
    width: 100%;
    max-width: 100%;
  }

  .product-review-client-review {
    margin-top: 20px;
  }

  .review-text {
    padding-right: 0;
  }

  .product-review-header-gallery {
    justify-content: start;
    gap: 5px;
  }

  .product-review-gallery-image {
    border-radius: 8px;
  }
}

@media screen and (max-width: 400px) {
  .product-review-main {
    padding: 0 10px;
  }

  .product-review-header-title {
    font-size: 28px;
    line-height: 32px;
  }
}


{% endstyle %}

{% javascript %}
  document.addEventListener("DOMContentLoaded", function () {
    const productId = "{{ product.id }}"; 
    const apiKey = "pubkey-h1PPDjY5cY7uYdSLPag1Hy61c4mXa3"; 
    const storeUrl = "craftmix.myshopify.com"; 
    const apiUrl = `https://stamped.io/api/widget/reviews?store=${storeUrl}&productId=${productId}&apiKey=${apiKey}`;

    fetch(apiUrl)
      .then(response => response.json())
      .then(data => {
        const reviewsContainer = document.getElementById("custom-reviews");
        reviewsContainer.innerHTML = ""; // Clear existing content

        if (data.reviews && data.reviews.length > 0) {
          data.reviews.forEach(review => {
            const verifiedBadge = review.verified ? `
              <div class="verified">
                <img src="https://cdn.shopify.com/s/files/1/2340/1623/files/tick-icon.png?v=1739131445" alt="Verified">
                <p>Verified buyer</p>
              </div>` : '';

            const recommendedBadge = review.recommend ? `
              <div class="recommend">
                <img src="https://cdn.shopify.com/s/files/1/2340/1623/files/tick-icon.png?v=1739131445" alt="Recommended">
                <p>I recommend this product</p>
              </div>` : '';

            const reviewHtml = `
              <div class="product-review">
                <div class="product-review-client-details">
                  <h5 class="client-name">${review.author}</h5>
                  <div class="credentials">
                    ${verifiedBadge}
                    ${recommendedBadge}
                  </div>
                </div>
                <div class="product-review-client-review">
                  <div class="stars">${renderStars(review.rating)}</div>
                  <h5 class="review-title">${review.title}</h5>
                  <p class="review-text">${review.message}</p>
                </div>
              </div>
            `;
            reviewsContainer.innerHTML += reviewHtml;
          });
        } else {
          reviewsContainer.innerHTML = "<p>No reviews yet. Be the first to review this product!</p>";
        }
      })
      .catch(error => {
        console.error("Error fetching reviews:", error);
        document.getElementById("custom-reviews").innerHTML = "<p>Failed to load reviews.</p>";
      });

    // Helper function to render stars dynamically
    function renderStars(rating) {
      let starHtml = '';
      for (let i = 0; i < 5; i++) {
        if (i < rating) {
          starHtml += '<img src="https://cdn.shopify.com/s/files/1/2340/1623/files/star-filled.svg?v=123456789" alt="★">';
        } else {
          starHtml += '<img src="https://cdn.shopify.com/s/files/1/2340/1623/files/star-empty.svg?v=123456789" alt="☆">';
        }
      }
      return starHtml;
    }
  });
{% endjavascript %}

