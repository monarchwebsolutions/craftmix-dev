{%- liquid
  if section.settings.enable == false
    assign show = false
  else
    assign show = true
  endif
  assign check_text_color = section.settings.text_color | color_extract: 'alpha'
  assign check_text_color_dark = section.settings.text_color_dark | color_extract: 'alpha'
  assign check_backgound_color = section.settings.backgound_color | color_extract: 'alpha'
  assign check_backgound_color_dark = section.settings.backgound_color_dark | color_extract: 'alpha'
-%}

{%- style -%}
  .announcement-bar-slider-container-{{ section.id }} {
    {% if section.settings.backgound_color != blank and check_backgound_color and check_backgound_color != 0.0 %}
      background: {{ section.settings.backgound_color }};
    {% else %}
      background: rgba(var(--colors-background));
    {% endif %}
  }
  .dark .announcement-bar-slider-container-{{ section.id }} {
    {% if section.settings.backgound_color_dark != blank and check_backgound_color_dark and check_backgound_color_dark != 0.0 %}
      background: {{ section.settings.backgound_color_dark }};
    {% else %}
      background: rgba(var(--colors-background));
    {% endif %}
  }
  .announcement-bar-slider-text-{{ section.id }} {
    {% if section.settings.text_color != blank and check_text_color and check_text_color != 0.0 %}
      color: {{ section.settings.text_color }};
    {% else %}
      color: rgb(var(--colors-text));
    {% endif %}
  }
  .dark .announcement-bar-slider-text-{{ section.id }} {
    {% if section.settings.text_color_dark != blank and check_text_color_dark and check_text_color_dark != 0.0 %}
      color: {{ section.settings.text_color_dark }};
    {% else %}
      color: rgb(var(--colors-text));
    {% endif %}
  }
  {% if section.settings.enable_sticky_bar %}
    .section-announcement-bar-slider {
      position: sticky;
      top: 0;
      z-index: 30;
    }
  {% endif %}
  
  /* Custom Swiper Container */
  .announcement-swiper-container-{{ section.id }} {
    position: relative;
    overflow: hidden;
    {% if section.blocks.size > 1 %}
    cursor: grab;
    {% else %}
    cursor: default;
    {% endif %}
  }
  
  {% if section.blocks.size > 1 %}
  .announcement-swiper-container-{{ section.id }}:active {
    cursor: grabbing;
  }
  
  .announcement-swiper-container-{{ section.id }}.swiper-initialized {
    cursor: grab;
  }
  
  .announcement-swiper-container-{{ section.id }}.swiper-initialized:active {
    cursor: grabbing;
  }
  {% endif %}
  
  /* Custom Swiper Wrapper */
  .announcement-swiper-wrapper-{{ section.id }} {
    display: flex;
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 1;
    transition-property: transform;
    box-sizing: content-box;
  }
  
  /* Custom Swiper Slide */
  .announcement-swiper-slide-{{ section.id }} {
    flex-shrink: 0;
    width: 100%;
    height: 100%;
    position: relative;
    transition-property: transform;
  }
  
  /* Navigation Arrows */
  .announcement-nav-prev-{{ section.id }},
  .announcement-nav-next-{{ section.id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 30px;
    height: 30px;
    background: transparent;
    border: 0;
    box-shadow: none;
    cursor: pointer;
    transition: opacity 0.3s ease;
    z-index: 10;
  }

  .announcement-nav-prev-{{ section.id }}.swiper-button-disabled,
  .announcement-nav-next-{{ section.id }}.swiper-button-disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  .announcement-nav-prev-{{ section.id }} {
    left: 5px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .announcement-nav-next-{{ section.id }} {
    right: 5px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .announcement-nav-prev-{{ section.id }} svg {
    transform: rotate(180deg);
  }
  .announcement-nav-prev-{{ section.id }}::after,
  .announcement-nav-next-{{ section.id }}::after {
    content: none;
  }

  .announcement-nav-prev-{{ section.id }}> svg {
    width: 15px;
    height: 15px;
    fill: #002657;
  }

  .announcement-nav-next-{{ section.id }}> svg {
    width: 15px;
    height: 15px;
    fill: #002657;
  }

  .custom-swiper-slide-announcement-bar {
    padding: 8.5px 29px;
  }
  
  /* Text styling */ 
  .announcement-bar-slider-{{ section.id }} .rte {
    text-align: center;
  }
  .announcement-bar-slider-{{ section.id }} .rte p {
    margin: 0;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: 0; 
    font-weight: 500;
    font-family: Goldplay;
  }
  .announcement-bar-slider-{{ section.id }} .rte a {
    text-decoration: underline;
  }

  .announcement-bar-slider-{{ section.id }} .rte a:hover {
    text-decoration: underline;
    background: unset;
  }

  .custom-svg-announcement-bar {
    fill: #002657 !important;
  }
  
  @media (max-width: 769px) {
  .custom-swiper-slide-announcement-bar {
    padding: 12.5px 29px;
  }

  .announcement-bar-slider-{{ section.id }} .rte p { 
    font-size: 12px;
  }

  .announcement-nav-prev-{{ section.id }} {
    left: 10px;
    justify-content: flex-start;
  }
  .announcement-nav-next-{{ section.id }} {
    right: 10px;
    justify-content: flex-end;
  }
  } 


  
{%- endstyle -%}
{% unless template contains 'lander' or template contains 'landing' %}
  {%- if show -%}
    <!-- Swiper CSS CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
    
    <div 
      class="announcement-bar-slider-container-{{ section.id }} announcement-bar-slider-text-{{ section.id }} relative overflow-hidden"
      {% if section.settings.enable_sticky_bar %}
        data-is-sticky="true"
      {% endif %}
    >
      {% if section.blocks.size > 0 %}
        <div class="announcement-bar-slider-{{ section.id }} announcement-swiper-container-{{ section.id }} swiper">
          <div class="announcement-swiper-wrapper-{{ section.id }}">
            {%- for block in section.blocks -%}
              <div class="custom-swiper-slide-announcement-bar announcement-swiper-slide-{{ section.id }} py-3 px-5 flex items-center justify-center" {{ block.shopify_attributes }}>
                {%- if block.settings.text != blank -%}
                  <div class="rte">
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
          
          <!-- Navigation arrows -->
          {% if section.settings.show_navigation and section.blocks.size > 1 %}
            <div class="announcement-nav-prev-{{ section.id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="40" height="40" focusable="false"><path d="m15.5 0.932-4.3 4.38 14.5 14.6-14.5 14.5 4.3 4.4 14.6-14.6 4.4-4.3-4.4-4.4-14.6-14.6z"></path></svg>
            </div>
            <div class="announcement-nav-next-{{ section.id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="40" height="40" focusable="false"><path d="m15.5 0.932-4.3 4.38 14.5 14.6-14.5 14.5 4.3 4.4 14.6-14.6 4.4-4.3-4.4-4.4-14.6-14.6z"></path></svg>
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <!-- Swiper JS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    
    <!-- Initialize Swiper with Custom Classes -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const swiperElement = document.querySelector('.announcement-bar-slider-{{ section.id }}');
        if (swiperElement) {
          new Swiper('.announcement-bar-slider-{{ section.id }}', {
            // Custom class names to avoid conflicts
            wrapperClass: 'announcement-swiper-wrapper-{{ section.id }}',
            slideClass: 'announcement-swiper-slide-{{ section.id }}',
            
            loop: {{ section.blocks.size | default: 0 }} > 1 ? true : false,
            speed: 600,
            {% if section.settings.auto_switch_bar and section.blocks.size > 1 %}
            autoplay: {
              delay: {{ section.settings.change_bar_every | times: 1000 }},
              disableOnInteraction: false,
            },
            {% endif %}
            navigation: {
              nextEl: '.announcement-nav-next-{{ section.id }}',
              prevEl: '.announcement-nav-prev-{{ section.id }}',
            },
            {% if section.blocks.size <= 1 %}
            allowTouchMove: false,
            {% endif %}
          });
        }
      });
    </script>
    <script>
      (function () {
        const SLIDE_SELECTOR = '.custom-swiper-slide-announcement-bar';
        const FOCUS_SELECTOR = 'a, button';

        // If you ONLY want ".active", keep just ["active"].
        // I strongly recommend including Swiper's built-ins unless you're certain.
        const ACTIVE_CLASS_CANDIDATES = ['active', 'swiper-slide-active', 'is-active'];

        function isSlideActive(slide) {
          return ACTIVE_CLASS_CANDIDATES.some(cls => slide.classList.contains(cls));
        }

        function setFocusable(el, on) {
          if (on) {
            // Restore default focus behavior
            el.removeAttribute('tabindex');
            el.removeAttribute('aria-hidden');
          } else {
            el.setAttribute('tabindex', '-1');
            el.setAttribute('aria-hidden', 'true');
          }
        }

        function syncSlides() {
          const slides = document.querySelectorAll(SLIDE_SELECTOR);
          if (!slides.length) return;

          // Determine active slide(s)
          slides.forEach(slide => {
            const active = isSlideActive(slide);

            // Optional: keep slide aria-hidden consistent too
            if (active) slide.removeAttribute('aria-hidden');
            else slide.setAttribute('aria-hidden', 'true');

            slide.querySelectorAll(FOCUS_SELECTOR).forEach(el => setFocusable(el, active));
          });
        }

        function init() {
          const slides = document.querySelectorAll(SLIDE_SELECTOR);
          if (!slides.length) return;

          // Initial sync (page load)
          syncSlides();

          let scheduled = false;
          const scheduleSync = () => {
            if (scheduled) return;
            scheduled = true;
            requestAnimationFrame(() => {
              scheduled = false;
              syncSlides();
            });
          };

          // Observe class changes on each slide AND DOM changes inside slides.
          // Also watch tabindex/aria-hidden changes because other scripts sometimes fight this.
          const observer = new MutationObserver(() => {
            scheduleSync();
          });

          slides.forEach(slide => {
            observer.observe(slide, {
              attributes: true,
              attributeFilter: ['class', 'tabindex', 'aria-hidden'],
              childList: true,
              subtree: true
            });
          });

          // If your slider replaces slides entirely (common), also observe the parent container.
          const container = slides[0].parentElement || document.body;
          observer.observe(container, { childList: true, subtree: true });

          // Safety: run again shortly after load in case slider initializes after DOMContentLoaded.
          setTimeout(syncSlides, 50);
          setTimeout(syncSlides, 250);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
  {%- endif -%}
{% endunless %}

{% schema %}
{
  "name": "Announcement Bar Slider",
  "class": "section-announcement-bar-slider",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color",
      "id": "backgound_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "backgound_color_dark", 
      "label": "Background color (Dark mode)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color_dark",
      "label": "Text color (Dark mode)",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "auto_switch_bar",
      "label": "Auto switch slides",
      "default": true
    },
    {
      "type": "range",
      "id": "change_bar_every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change slide every",
      "info": "Only applies when auto switch is enabled",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation arrows",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Welcome to our store!</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar Slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}

