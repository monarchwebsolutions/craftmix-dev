{%- liquid
  assign show_custom_menu = false
  for block in section.blocks
    if block.type == 'menu'
      assign show_custom_menu = true
    endif
  endfor
  if section.settings.show_currency_selector or section.settings.show_language_selector
    assign show_language = true
  else
    assign show_language = false
  endif
  assign base_size = settings.text_base_size | times: 0.00875
  if section.settings.enable_highlight
    assign menus = section.settings.menus | newline_to_br | strip_newlines | split: '<br />'
  endif
-%}
{%- style -%}
  #mobile-navigation * {
    {%- if section.settings.divider_color.alpha != 0.0 -%}
      border-color: {{ section.settings.divider_color }};
    {%- else -%}
      border-color: rgba(var(--colors-line-header));
    {%- endif -%}
  }
  .dark #mobile-navigation * {
    {%- if section.settings.divider_color_dark.alpha != 0.0 -%}
      border-color: {{ section.settings.divider_color_dark }};
    {%- else -%}
      border-color: rgba(var(--colors-line-header));
    {%- endif -%}
  } 
  #mobile-navigation .text-color,
  #mobile-navigation .background-header {
    {%- if section.settings.background_color.alpha != 0.0 -%}
      background: {{ section.settings.background_color }};
    {%- else -%}
      background: rgba(var(--background-color-header));
    {%- endif -%}
    {%- if section.settings.text_color.alpha != 0.0 -%}
      --colors-heading: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
      color: {{ section.settings.text_color }};
      --colors-text-header: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
      {%- else -%}
      --colors-text: {{ settings.colors_text.red }}, {{ settings.colors_text.green }}, {{ settings.colors_text.blue }};
      --colors-heading: {{ settings.colors_heading.red }}, {{ settings.colors_heading.green }}, {{ settings.colors_heading.blue }};
      {%- endif -%}
      {%- if section.settings.colors_text_link.alpha != 0.0 -%}
        --colors-text-link: {{ section.settings.colors_text_link.red }}, {{ section.settings.colors_text_link.green }}, {{ section.settings.colors_text_link.blue }};
      {% else %}  
        --colors-text-link: {{ settings.colors_text_link.red }}, {{ settings.colors_text_link.green }}, {{ settings.colors_text_link.blue }};
      {% endif %}
  }
  .dark #mobile-navigation .text-color,
  .dark #mobile-navigation .background-header {
    {%- if section.settings.background_color_dark.alpha != 0.0 -%}
      background: {{ section.settings.background_color_dark }};
    {%- endif -%}
    {%- if section.settings.text_color_dark.alpha != 0.0 -%}
      --colors-heading: {{ section.settings.text_color_dark.red }}, {{ section.settings.text_color_dark.green }}, {{ section.settings.text_color_dark.blue }};
      color: {{ section.settings.text_color_dark }};
      --colors-text-header: {{ section.settings.text_color_dark.red }}, {{ section.settings.text_color_dark.green }}, {{ section.settings.text_color_dark.blue }};
      --colors-text-link: {{ section.settings.text_color_dark.red }}, {{ section.settings.text_color_dark.green }}, {{ section.settings.text_color_dark.blue }};
    {%- else -%}
      --colors-text: {{ settings.colors_dark_text.red }}, {{ settings.colors_dark_text.green }}, {{ settings.colors_dark_text.blue }};
      --colors-heading: {{ settings.colors_dark_heading.red }}, {{ settings.colors_dark_heading.green }}, {{ settings.colors_dark_heading.blue }};
    {%- endif -%}
    {%- if section.settings.colors_text_link_dark.alpha != 0.0 -%}
      --colors-text-link: {{ section.settings.colors_text_link_dark.red }}, {{ section.settings.colors_text_link_dark.green }}, {{ section.settings.colors_text_link_dark.blue }};
    {% else %}  
      --colors-text-link: {{ settings.colors_dark_text_link.red }}, {{ settings.colors_dark_text_link.green }}, {{ settings.colors_dark_text_link.blue }};
    {% endif %}
  }
  {% if section.settings.enable_highlight %}
    .svg-highlight-{{ section.id }} {
    {% if section.settings.highlight_color_light != blank and section.settings.highlight_color_light.alpha != 0.0 %}
      --color-highlight: {{ section.settings.highlight_color_light }};
    {% endif %}
    }
    .dark .svg-highlight-{{ section.id }} {
      {% if section.settings.highlight_color_dark != blank and section.settings.highlight_color_dark.alpha != 0.0 %}
        --color-highlight: {{ section.settings.highlight_color_dark }};
      {% else %}
        --color-highlight: {{ settings.colors_dark_heading_highlight }};
      {% endif %}
    }
  {% endif %}
{%- endstyle -%}
<link rel="stylesheet" href="{{ 'mobile-navigation-custom.css' | asset_url }}"><div
  class="z-[60] fixed top-0 h-full w-full opacity-60 bg-black"
  x-show="$store.xMobileNav.show"
  x-cloak
  @click="$store.xMobileNav.close()"
></div>
<template x-if="!runDispatch">
  <div
    id="mobile-navigation"
    :class="{ 'menu-opening': $store.xMobileNav.show, 'rtl right-0 translate-x-full{% if settings.edges_type == 'rounded_corners' %} rounded-l-[10px]{% endif %}': $store.xHeaderMenu.mobileHeaderLayout.includes('right'), 'ltr left-0 -translate-x-full{% if settings.edges_type == 'rounded_corners' %} rounded-r-[10px]{% endif %}': !$store.xHeaderMenu.mobileHeaderLayout.includes('right') }" 
    class="menu-drawer fixed z-[60] top-0 bottom-0 w-10/12 max-w-sm motion-reduce invisible overflow-x-hidden"
    aria-label="Open navigation menu"
  >
    <div class="background-header gradient menu-drawer duration-300 ease-in-out pt-5 overflow-hidden h-full flex flex-col">
      <div class="h-10 w-full px-2"
        :class="{ 'text-left': $store.xHeaderMenu.mobileHeaderLayout.includes('right'), 'text-right': !$store.xHeaderMenu.mobileHeaderLayout.includes('right')}" 
        aria-label="{{ 'accessibility.close' | t }}"
      >
        <button
          class="cursor-pointer inline-block p-2"
          @click="$store.xMobileNav.close()"
          aria-label="Close menu"
        >{% render 'icon-alls', icon: 'icon-close' %}</button>
      </div>
      <div class="mobile-nav-content-wrapper">
        <div class="bestsellers-container-mobile">
          <h2 class="bestsellers-mobile-header">BESTSELLERS</h2>

          {% assign bestseller_collection = collections['megamenu-bestsellers'].products %}
          
          {% for product in bestseller_collection limit: 2 %}
            {% unless product.tags contains "price_test" %}
            {% if product.images.last %}
              <a class="mega-menu-bestseller" id="shop-all-bestseller-{{ forloop.index }}" style="background-color: {{ product.metafields.custom.color_2 }}" href="{{ product.url }}">
                <div class="bestseller-img-container">
                
                  <img class="bestseller-img" height="100px" width="100px" src="{{ product.images | last | map: 'src' | first | img_url: '500x' }}" alt="{{ product.title }}">


                </div>
                <div class="bestseller-text">
                  <div class="header-bestseller-badge">
                    Bestseller
                  </div>
                  <h2>{{ product.title }}</h2>
                  <p class="bestseller-benefits">Get 25% OFF For a Limited Time</p>
                </div>
              </a>
            {% else %}
              <p>Bestseller {{ forloop.index }} image not available.</p>
            {% endif %}
            {% endunless %}
          {% endfor %}
        </div>

        <div class="flavors-dropdown-mobile">
          <div class="mobile-menu-dropdowns-container">
            <div class="accordion">
              <div class="accordion-item">
                <button id="accordion-button-1" aria-expanded="false"><h2 class="accordion-title">Flavors</h2><span class="icon" aria-hidden="true"></span></button>
                <div class="accordion-content">
                  <div class="mega-menu-grid-container">
                    {% for product in collections['mobile-flavors'].products %}
                      {% unless product.tags contains "price_test" %}
                      <a href="{{ product.url }}" class="mega-menu-grid-cell">
                        <!-- Featured Image -->
                        <img height="100px" width="100px" src="{{ product.metafields.custom.product_icon | img_url: '100x' }}" alt="{{ product.title }}">

                        
                        <!-- Product Title -->
                        <h2>{{ product.title }}</h2>
                      </a>
                      {% if forloop.index == 12 %}
                        {% break %}
                      {% endif %}
                      {% endunless %}
                    {% endfor %}
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button id="accordion-button-2" aria-expanded="true"><h2 class="accordion-title">Variety Packs</h2><span class="icon" aria-hidden="true"></span></button>
                <div class="accordion-content">
                  <div class="mega-menu-grid-container variety-pack-grid-container">
                    {% comment %} <a class="mega-menu-grid-cell featured" href="/pages/party-pack">
                      <img src="https://cdn.shopify.com/s/files/1/2340/1623/files/1-_61_2_-min.jpg?v=1753408460" alt="Colorful assortment of Craftmix cocktails in various glasses garnished with fruit and mint on a light blue background.">
                      <div class="featured-variety-text">
                        <h2>Special Offer</h2>
                        <img class="special-offer-price-tag" height=40 width=112 src="https://cdn.shopify.com/s/files/1/2340/1623/files/Screenshot_2025-08-26_at_3.11.53_PM-removebg-preview.png?v=1756235570" alt="Orange price tag reading '$45.59'">
                        <p class="featured-variety-original-price">$75.99</p>
                        <p class="featured-variety-title">Party Pack (Club)</p>
                      </div>
                    </a> {% endcomment %}
                    {% for product in collections['mobile-variety-packs'].products %}
                      {% unless product.tags contains "price_test" %}
                        <a href="{{ product.url }}" class="mega-menu-grid-cell">
                          <img height="100px" width="100px" src="{{ product.metafields.custom.product_icon | img_url: '100x' }}" alt="{{ product.title }}">
                          <h2>{{ product.title }}</h2>
                        </a>
                      {% if forloop.index == 5 %}
                        {% break %}
                      {% endif %}
                      {% endunless %}
                    {% endfor %}
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button id="accordion-button-3" aria-expanded="false"><h2 class="accordion-title">About</h2><span class="icon" aria-hidden="true"></span></button>
                <div class="accordion-content">
                  <a href="/pages/about-us" class="about-accordion-button"><h3>About us</h3></a>
                  <a href="/blogs/craftmix-blog" class="about-accordion-button"><h3>Blog</h3></a>
                  <a href="/pages/reviews" class="about-accordion-button"><h3>Reviews</h3></a>
                  <a href="/pages/store-locator" class="about-accordion-button"><h3>Find In Store</h3></a>
                  <a href="/pages/faq" class="about-accordion-button"><h3>FAQs</h3></a>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="mobile-menu-cta-container">
          <a href="/collections/all-products" id="mobile-menu-cta-1" class="primary-cta">Shop All Flavors</a>
          <a href="/pages/subscriptions" id="mobile-menu-cta-2" class="primary-cta">Subscribe Today - Learn More</a>
        </div>
      </div>
      
      
      {%- if show_language -%}
        <div class="pt-1.5 pb-1.5 pl-5 pr-5 lg:flex lg:items-center z-50 background-header justify-center lg:justify-end bottom-0 left-0 max-w-sm border-t">
          {%- render 'toolbar', 
            mobile: true, 
            show_currency_selector: section.settings.show_currency_selector, 
            show_language_selector: section.settings.show_language_selector
          -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</template>
<script>
  document.addEventListener('DOMContentLoaded', () => {
  const observer = new MutationObserver(() => {
    const mobileDropdowns = document.querySelectorAll(".accordion button");

    if (mobileDropdowns.length > 0) {
      observer.disconnect(); // Stop observing once elements are found
      console.log(mobileDropdowns);

      function toggleAccordion() {
        console.log('test');
        const itemToggle = this.getAttribute('aria-expanded');

        mobileDropdowns.forEach(button => button.setAttribute('aria-expanded', 'false'));

        if (itemToggle === 'false') {
          this.setAttribute('aria-expanded', 'true');
        }
      }

      mobileDropdowns.forEach(item => item.addEventListener('click', toggleAccordion));
    }
  });

  // Observe changes in the entire document
  observer.observe(document.body, { childList: true, subtree: true });
});

</script>

<style>
  #mobile-navigation{
    z-index:101;
  }
  @media screen and (max-width:479px){
    width:100%;
  }
