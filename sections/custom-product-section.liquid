                  <div class="subscribe-price-before">$44.47</div>
                  <div class="subscribe-price-after">$26.68</div>
                </div>
                <div class="subscribe-drink-price">$2.24/drink</div>
              </div>
            </div>
            <div class="delivery-option">
              <h5 class="delivery-option-heading">Deliver Every</h5>
              <div class="delivery-option-btns">
                <button class="delivery active" data-frequency="2">2 weeks</button>
                <button class="delivery" data-frequency="4">4 weeks</button>
                <button class="delivery" data-frequency="8">8 weeks</button>
              </div>
              <div class="subscription-benefits">
                <div class="benefit">
                  <img class="benifit-img"
                    src="https://cdn.shopify.com/s/files/1/2340/1623/files/tick-icon.png?v=1739131445" alt="">
                  <span class="benifit-text">Save up to 40%</span>
                </div>
                <div class="benefit">
                  <img class="benifit-img"
                    src="https://cdn.shopify.com/s/files/1/2340/1623/files/tick-icon.png?v=1739131445" alt="">
                  <span class="benifit-text">No commitments, cancel anytime</span>
                </div>
              </div>
            </div>

          </div>

          <div class="pdp-info-otp-section">
            <div class="purchase-option">
              <input type="radio" id="one-time-purchase" name="purchase-option" value="one-time" checked>
              <label for="one-time-purchase">One-time purchase</label>
            </div>
            <div class="otp-price-box">
              <div class="otp-price">{{ product.price | money }}</div>
              <div class="otp-drink-price">$2.24/drink</div>
            </div>
          </div>

          <div class="pdp-info-cta-section">
            <a href="#" class="add-to-cart-btn">Add to Cart</a>
          </div>

          <hr class="break-line">
          <div class="pdp-info-flavor-section"></div>
          <div class="pdp-info-text-and-badges">
            <p class="info-text">Lorem ipsum dolor sit amet consectetur adipisicing elit. Non maxime quas assumenda
              blanditiis velit.
              Minima veniam magnam, placeat voluptatem numquam nulla quas cupiditate veritatis maiores aliquid quam
              repellat, architecto alias! <a href="">Read more</a></p>
            <div class="product-badge-container">
              <div class="product-badge"><img src="all-natural.png" alt=""></div>
              <div class="product-badge"><img src="low-sugar.png" alt=""></div>
              <div class="product-badge"><img src="gluten-free.png" alt=""></div>
              <div class="product-badge"><img src="vegan.png" alt=""></div>
            </div>
            <div class="make-a-drink">
              <img src="https://cdn.shopify.com/s/files/1/2340/1623/files/timer-icon.png?v=1739046913" alt="">
              <p>Make a drink in under 1 minute! <a href="#">See how</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
