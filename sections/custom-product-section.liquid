{% style %}
:root {
  --light-color: {{ product.metafields.custom.color_3 }};
  --medium-color: {{ product.metafields.custom.color_2  }};
  --dark-color: {{ product.metafields.custom.color_1 }};
}

  *,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

ul {
  list-style: none;
}

a {
  text-decoration: none;
}

img {
  display: block;
  max-width: 100%;
}

.custom-pdp-section {
  background-color: var(--light-color);
  padding: 50px 0px;
}

.custom-pdp-section-container {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  flex-direction: row;
  gap: 100px;
  padding: 0 45px;
}

.pdp-images-section {
  max-width: 640px;
  display: flex;
  flex-direction: column;
  gap: 25px;
}

.pdp-main-img-container {
  width: 638px;
  height: 638px;
  padding: 52px 50px 48px 50px;
  border-radius: 30px;
  border: 1.5px solid rgba(0, 38, 87, 1);
  opacity: 1;
  background-image: linear-gradient(
    184deg,
    var(--light-color) 0%,
   var(--medium-color) 100%
  );
}

.pdp-secondary-images-container {
  width: 640px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.secondary-img-container {
  width: 202px;
  height: 202px;
  border-radius: 20px;
  border: 1.5px solid rgba(0, 38, 87, 1);
  opacity: 1;
  background-image: linear-gradient(
    184deg,
    var(--light-color) 0%,
   var(--medium-color) 100%
  );
  overflow: hidden;
  max-width: 100%;
  max-height: 100%;
}

.product-img {
  object-fit: cover;
  width: 100%;
  height: 100%;
}

.pdp-info-section {
  max-width: 510px;
  display: flex;
  flex-direction: column;
  /* gap: 25px;  */
}

.pdp-info-section-header {
  width: 510px;
  margin-bottom: 26px;
}

.pdp-info-section-header-items {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: start;
  gap: 12px;
  margin-bottom: 22px;
}

.bestseller-badge {
  opacity: 1;
  color: rgba(255, 255, 255, 1);
  font-family: 'Goldplay';
  font-size: 15px;
  font-weight: 600;
  font-style: SemiBold;
  letter-spacing: -0.09px;
  text-align: left;
  line-height: 16px;
  background-color: #ff5f00;
  padding: 8px 16px;
  border: 1px solid #002657;
  border-radius: 16px;
}

.num-reviews {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 14px;
  font-weight: 700;
  font-style: Bold;
  letter-spacing: 0.3px;
  text-align: left;
  line-height: 18px;
  text-transform: uppercase;
}

.pdp-product-title {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 64px;
  font-weight: 700;
  font-style: Bold;
  letter-spacing: -1.68px;
  text-align: left;
  line-height: 54px;
  margin-bottom: 32px;
}

.product-text {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 500;
  font-style: Medium;
  letter-spacing: -0.11px;
  text-align: left;
  line-height: 24px;
}

.pdp-info-quantity-section {
  margin-bottom: 20px;
}

.pdp-info-quantity-title {
  font-family: 'Goldplay', sans-serif;
  font-size: 16px;
  font-weight: 600;
  color: rgba(0, 38, 87, 1);
  margin-bottom: 10px;
}

.pdp-info-quantity-btns {
  display: flex;
  justify-content: space-between;
  gap: 10px;
}

.quantity {
  flex: 1;
  min-width: 80px;
  padding: 11px 20px;
  font-family: 'Goldplay', sans-serif;
  font-size: 18px;
  font-weight: 600;
  text-align: center;
  line-height: 22px;
  letter-spacing: -0.11px;
  color: rgba(0, 38, 87, 1);
  background-color: var(--medium-color);
  border: 1.5px solid rgba(0, 38, 87, 1);
  border-radius: 33px;
  cursor: pointer;
  transition: background-color 0.3s, color 0.3s;
}
.quantity.active {
  background-color: var(--dark-color);;
  color: #fff;
}
.quantity:hover {
  background-color: var(--dark-color);
  color: #fff;
}

.pdp-info-subscription-section {
  width: 510px;
