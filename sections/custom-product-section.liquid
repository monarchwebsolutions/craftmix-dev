  font-size: 12px;
  font-weight: 700;
  font-style: Bold;
  letter-spacing: -0.08px;
  text-align: right;
  line-height: 12px;
  text-transform: uppercase;
}

.purchase-option {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.delivery-option {
  margin-left: 35px;
}

.delivery-option-heading {
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 12px;
  font-weight: 700;
  font-style: Bold;
  letter-spacing: -0.08px;
