{% schema %}
{
  "name": "Hydration Landing Facts",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Hydration product",
      "info": "Uses hydration-variety when empty."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Hydration Landing Nutrition"
    }
  ]
}
{% endschema %}

{% javascript %}
(() => {
 function init(root) { root.querySelectorAll('[data-hydration-nutrition]').forEach(section => {
 if (section.dataset.hydrationInitialized) return;
 section.dataset.hydrationInitialized = 'true';
 const selectors = section.querySelectorAll('.nutrition-card-selector');
 const containers = section.querySelectorAll('.nutrition-facts-container');
 selectors.forEach(button => button.addEventListener('click', () => {
  const slugClass = Array.from(button.classList).find(name => name.endsWith('-nutrition-card-selector'));
  if (!slugClass) return;
  const slug = slugClass.replace('-nutrition-card-selector', '');
  selectors.forEach(item => item.classList.toggle('selected', item.classList.contains(slugClass)));
  containers.forEach(item => item.classList.toggle('active', item.classList.contains(slug + '-nutrition-facts-container')));
 }));
 section.querySelectorAll('.flavor-bar').forEach(bar => {
  const percentage = Math.max(0, Math.min(100, parseInt(bar.dataset.flavor, 10) || 0));
  const fill = bar.querySelector('.flavor-range-fill'), icon = bar.querySelector('.flavor-icon');
  if (fill && icon) { fill.style.width = percentage + '%'; icon.style.left = percentage + '%'; }
 });
 }); }
 if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => init(document), {once:true}); else init(document);
 document.addEventListener('shopify:section:load', event => init(event.target));
})();
{% endjavascript %}
