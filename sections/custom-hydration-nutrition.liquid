{% assign product = section.settings.product | default: all_products['hydration-variety'] %}
{% if product != blank %}
<div class="custom-nutrition-section" data-hydration-nutrition>
<img src="{{ 'tropicalleaf.svg' | asset_url }}" class="background-fruit-nutrition-lower bg-tropical-leaf" width="268" height="289" alt="Tropical Leaf Illustration" loading="lazy">
<img src="{{ 'mint-light.svg' | asset_url }}"  class="background-fruit-nutrition-lower bg-mint-leaf" width="294" height="350" alt="Mint Leaf Illustration" loading="lazy">
<div class="custom-nutrition-section-container">
   {% assign is_variety_pack = false %}
   {% if product.metafields.custom.variety_pack_products.value != blank %}
   {% assign is_variety_pack = true %}
   {% assign variety_pack_products = product.metafields.custom.variety_pack_products.value %}
   {% endif %}
   <div>
      {% if is_variety_pack %}
      <div class="nutrition-card-selectors-container nutrition-card-selectors-desktop">
      {% for product in variety_pack_products %}
        <button class="nutrition-card-selector {{ product.title | downcase | replace: ' ', '-' | replace: '_', '-' }}-nutrition-card-selector {% if forloop.index == 1 %}selected{% endif %}">{{product.title }}</button>
      {% endfor %}
      </div>
      {% for product in variety_pack_products %}
      <div class="nutrition-facts-container {{ product.title | downcase | replace: ' ', '-' | replace: '_', '-' }}-nutrition-facts-container {% if forloop.index == 1 %}active{% endif %}">
        {% assign nutrition_card_bg = product.metafields.custom.color_3 | default: '#ffffff' %}
        {% assign nutrition_card_text = product.metafields.custom.color_1 | default: '#000000' %}
        {% if product.metafields.custom.illustration_b %}
        {% assign flavor_icon = product.metafields.custom.illustration_b | file_url %}
        {% else %}
        {% assign flavor_icon = 'https://cdn.shopify.com/s/files/1/2340/1623/files/lime2.svg?v=1738881712' %}
        {% endif %}
        <div class="top-section">
          <img src="{{ flavor_icon }}" class="bg-nutrition-fruit flavor-bg" alt="Flavor illustration" width="114" height="118" loading="lazy">
          <div class="whats-in-craftmix">
              <h4 class="whats-in-craftmix-subheading">What's in CraftMix</h4>
              <h3 class="whats-in-craftmix-heading">Quality Ingredients, Amazing Taste</h3>
              <p class="whats-in-craftmix-paragraph whats-in-craftmix-paragraph-variety">Craftmix never uses artificial flavors, sweeteners, or preservatives and each flavor is made from real-fruit powders.</p>
              <div class="flavor-bar flavor-bar-desktop" data-flavor="{{ product.metafields.custom.flavor_measure.value }}">
                <div class="flavor-range">
                    <div class="flavor-range-fill"></div>
                    <img src="{{ flavor_icon }}" width="40" height="32" alt="Flavor Icon" class="flavor-icon" loading="lazy">
                </div>
                <div class="flavor-labels">
                    <span class="sweet-label">{{ product.metafields.custom.sweet_alt.value | default: 'Sweet' }}</span>
                    <span class="flavor-label">Flavor</span>
                    <span class="sour-label">{{ product.metafields.custom.flavor_type.value | default: 'Sour' }}</span>
                </div>
              </div>
          </div>
          <div class="nutrition-card-selectors-container nutrition-card-selectors-mobile">
          {% for product in variety_pack_products %}
            <button class="nutrition-card-selector {{ product.title | downcase | replace: ' ', '-' | replace: '_', '-' }}-nutrition-card-selector {% if forloop.index == 1 %}selected{% endif %}">{{product.title }}</button>
          {% endfor %}
          </div>
          <div class="nutrition-fact-card-container">
              <div class="nutrition-fact-card card-single" style=" border: 1.5px solid {{ nutrition_card_text }};  color: {{ nutrition_card_text }}; background-color: {{ nutrition_card_bg }};">
                <div class="nutrition-fact-card-header">
                    <div class="nutrition-fact-card-head">
                      <h3 class="nutrition-product-title" style="color: {{ nutrition_card_text }};">{{ product.title | remove_first: '2025 - ' }}</h3>
                      <div class="calories-box">
                          <h4 class="cal-num" style="color: {{ nutrition_card_text }};">{{ product.metafields.custom.calorie_total.value | default: '—' }}</h4>
                          <p class="cal-text" style="color: {{ nutrition_card_text }};">Calories</p>
                      </div>
                    </div>
                </div>
                <div class="nutrition-fact-card-body">
                    <table class="nutrition-table" style=" color: {{ nutrition_card_text }};">
                      <tr>
                          <th><span class="visually-hidden">Blank header</span></th>
                          <th class="table-th">Per 7g Packet</th>
                          <th class="table-th">DV%</th>
                      </tr>
                      <tr>
                          <td>Total Fat</td>
                          <td>{{ product.metafields.custom.total_fat_mass.value | default: '—' }}g</td>
                          <td>{{ product.metafields.custom.total_fat_dv.value | default: '—' }}%</td>
                      </tr>
                      <tr>
                          <td>Sodium</td>
                          <td>{{ product.metafields.custom.sodium_mass.value | default: '—' }}mg</td>
                          <td>{{ product.metafields.custom.table_sodium_dv.value | default: '—' }}%</td>
                      </tr>
                      <tr>
                          <td>Carbohydrate</td>
                          <td>{{ product.metafields.custom.carbs_mass.value | default: '—' }}g</td>
                          <td>{{ product.metafields.custom.carbs_dv.value | default: '—' }}%</td>
                      </tr>
                      <tr>
                          <td>Total Sugars <br> <span class="sugar-text-sm">Includes {{ product.metafields.custom.sugar_mass.value | default: '—' }}g <br> Added Sugars</span></td>
                          <td>5g</td>
                          <td>{{ product.metafields.custom.sugar_dv.value | default: '—' }}%</td>
                      </tr>
                      <tr>
                          <td>Protein</td>
                          <td>{{ product.metafields.custom.protein_mass.value | default: '—' }}mg</td>
                          <td>{{ product.metafields.custom.protein_dv.value | default: '—' }}%</td>
                      </tr>
                      <tr>
                          <td>Potassium</td>
                          <td>{{ product.metafields.custom.potassium_mass.value | default: '—' }}mg</td>
                          <td>{{ product.metafields.custom.potassium_dv.value | default: '—' }}%</td>
                      </tr>
                      <tr>
                          <td>Chloride</td>
                          <td>345mg</td>
                          <td>15%</td>
                      </tr>
                      <tr>
                          <td>Magnesium</td>
                          <td>60mg</td>
                          <td>14%</td>
                      </tr>
                      <tr>
                          <td>Calcium</td>
                          <td>60mg</td>
                          <td>5%</td>
                      </tr>
                      <tr class="ingredients-row">
                          <td colspan="3" style="text-align: left; border-bottom: none; padding: 20px">
                            <strong>Ingredients:</strong> {{ product.metafields.custom.ingredients }}
                          </td>
                      </tr>
                    </table>
                </div>
              </div>
              <style>
                #shopify-section-{{ section.id }} .card-single .nutrition-table th,
                #shopify-section-{{ section.id }} .card-single .nutrition-table td,
                #shopify-section-{{ section.id }} .card-single .nutrition-table tr {
                border-bottom: 1px solid {{ nutrition_card_text }};
                }
              </style>
          </div>
          <div class="flavor-bar flavor-bar-mobile" data-flavor="{{ product.metafields.custom.flavor_measure.value }}">
              <div class="flavor-range">
                <div class="flavor-range-fill"></div>
                <img src="{{ flavor_icon }}" width="40" height="32" alt="Flavor Icon" class="flavor-icon" loading="lazy">
              </div>
              <div class="flavor-labels">
                <span class="sweet-label">{{ product.metafields.custom.sweet_alt.value | default: 'Sweet' }}</span>
                <span class="flavor-label">Flavor</span>
                <span class="sour-label">{{ product.metafields.custom.flavor_type.value | default: 'Sour' }}</span>
              </div>
          </div>
        </div>
      </div>
      {% endfor %}
      {% else %}
      <!-- This is a SINGLE PRODUCT -->
      {% assign nutrition_card_bg = product.metafields.custom.color_3 | default: '#ffffff' %}
      {% assign nutrition_card_text = product.metafields.custom.color_1 | default: '#000000' %}
      {% if product.metafields.custom.illustration_b %}
      {% assign flavor_icon = product.metafields.custom.illustration_b | file_url %}
      {% else %}
      {% assign flavor_icon = 'https://cdn.shopify.com/s/files/1/2340/1623/files/lime2.svg?v=1738881712' %}
      {% endif %}
      <div class="top-section">
         <img src="{{ flavor_icon }}" class="bg-nutrition-fruit flavor-bg" alt="Flavor illustration" width="114" height="118" loading="lazy">
         <div class="whats-in-craftmix">
            <h4 class="whats-in-craftmix-subheading">What's in CraftMix</h4>
            <h3 class="whats-in-craftmix-heading">Quality Ingredients, Amazing Taste</h3>
            <p class="whats-in-craftmix-paragraph">Craftmix never uses artificial flavors, sweeteners, or preservatives and each flavor is made from real-fruit powders.</p>
            <div class="flavor-bar" data-flavor="{{ product.metafields.custom.flavor_measure.value }}">
               <div class="flavor-range">
                  <div class="flavor-range-fill"></div>
                  <img src="{{ flavor_icon }}" width="40" height="32" alt="Flavor Icon" class="flavor-icon" loading="lazy">
               </div>
               <div class="flavor-labels">
                  <span class="sweet-label">{{ product.metafields.custom.sweet_alt.value | default: 'Sweet' }}</span>
                  <span class="flavor-label">Flavor</span>
                  <span class="sour-label">{{ product.metafields.custom.flavor_type.value | default: 'Sour' }}</span>
               </div>
            </div>
         </div>
         <div class="nutrition-fact-card-container">
            <div class="nutrition-fact-card card-single" style=" border: 1.5px solid {{ nutrition_card_text }};  color: {{ nutrition_card_text }}; background-color: {{ nutrition_card_bg }};">
               <div class="nutrition-fact-card-header">
                  <div class="nutrition-fact-card-head">
                     <h3 class="nutrition-product-title" style="color: {{ nutrition_card_text }};">{{ product.title | remove_first: '2025 - ' }}</h3>
                     <div class="calories-box">
                        <h4 class="cal-num" style="color: {{ nutrition_card_text }};">{{ product.metafields.custom.calorie_total.value | default: '—' }}</h4>
                        <p class="cal-text" style="color: {{ nutrition_card_text }};">Calories</p>
                     </div>
                  </div>
               </div>
               <div class="nutrition-fact-card-body">
                  <table class="nutrition-table" style=" color: {{ nutrition_card_text }};">
                     <tr>
                        <th><span class="visually-hidden">Blank header</span></th>
                        <th class="table-th">Per 7g Packet</th>
                        <th class="table-th">DV%</th>
                     </tr>
                     <tr>
                        <td>Total Fat</td>
                        <td>{{ product.metafields.custom.total_fat_mass.value | default: '—' }}g</td>
                        <td>{{ product.metafields.custom.total_fat_dv.value | default: '—' }}%</td>
                     </tr>
                     <tr>
                        <td>Sodium</td>
                        <td>{{ product.metafields.custom.sodium_mass.value | default: '—' }}mg</td>
                        <td>{{ product.metafields.custom.table_sodium_dv.value | default: '—' }}%</td>
                     </tr>
                     <tr>
                        <td>Carbohydrate</td>
                        <td>{{ product.metafields.custom.carbs_mass.value | default: '—' }}g</td>
                        <td>{{ product.metafields.custom.carbs_dv.value | default: '—' }}%</td>
                     </tr>
                     <tr>
                        <td>Total Sugars <br> <span class="sugar-text-sm">Includes {{ product.metafields.custom.sugar_mass.value | default: '—' }}g <br> Added Sugars</span></td>
                        <td>5g</td>
                        <td>{{ product.metafields.custom.sugar_dv.value | default: '—' }}%</td>
                     </tr>
                     <tr>
                        <td>Protein</td>
                        <td>{{ product.metafields.custom.protein_mass.value | default: '—' }}mg</td>
                        <td>{{ product.metafields.custom.protein_dv.value | default: '—' }}%</td>
                     </tr>
                     <tr>
                        <td>Potassium</td>
                        <td>{{ product.metafields.custom.potassium_mass.value | default: '—' }}mg</td>
                        <td>{{ product.metafields.custom.potassium_dv.value | default: '—' }}%</td>
                     </tr>
                     <tr>
                        <td>Chloride</td>
                        <td>345mg</td>
                        <td>15%</td>
                     </tr>
                     <tr>
                        <td>Magnesium</td>
                        <td>60mg</td>
                        <td>14%</td>
                     </tr>
                     <tr>
                        <td>Calcium</td>
                        <td>60mg</td>
                        <td>5%</td>
                     </tr>
                     <tr class="ingredients-row">
                        <td colspan="3" style="text-align: left; border-bottom: none; padding: 20px">
                           <strong>Ingredients:</strong> {{ product.metafields.custom.ingredients }}
                        </td>
                     </tr>
                  </table>
               </div>
            </div>
            <style>
               #shopify-section-{{ section.id }} .card-single .nutrition-table th,
               #shopify-section-{{ section.id }} .card-single .nutrition-table td,
               #shopify-section-{{ section.id }} .card-single .nutrition-table tr {
               border-bottom: 1px solid {{ nutrition_card_text }};
               }
            </style>
         </div>
      </div>
      {% endif %}
   </div>
</div>
</div>
<div class="section-wave-container">
   <div
      class="lazy-lottie-container section-wave"
      data-src="{{ product.metafields.custom.secondary_product_wave | asset_url }}"
      data-background="transparent"
      data-speed="1"
      data-autoplay="true"
      data-loop="true"
      >
      <!-- lottie-player will be injected here -->
   </div>
</div>

{% endif %}
{% style %}

#shopify-section-{{ section.id }} .nutrition-card-selectors-container {
  margin-bottom: 44px;
}
#shopify-section-{{ section.id }} .nutrition-card-selector {
  border: 1px solid var(--craftmix-dark-blue);
  padding: 8px 10px;
  border-radius: 100px;
  font-family: Goldplay;
  font-weight: 600;
  font-size:18px;
  white-space:nowrap;
}
#shopify-section-{{ section.id }} .nutrition-card-selectors-desktop {
    display:flex;
    gap: 30px;
    justify-content: center;
}
#shopify-section-{{ section.id }} .nutrition-card-selectors-mobile {
  display:none;
  gap: 16px;
  justify-content: left;
  overflow-x:scroll;
}
#shopify-section-{{ section.id }} .nutrition-card-selectors-mobile::-webkit-scrollbar {
  display:none;
}
#shopify-section-{{ section.id }} .nutrition-card-selector.selected {
  background-color:var(--craftmix-dark-blue);
  color:white;
}
#shopify-section-{{ section.id }} .nutrition-facts-container {
  display:none;
  background:unset;
}
#shopify-section-{{ section.id }} .nutrition-facts-container.active {
  display:block;
  border:none;
}
#shopify-section-{{ section.id }} .ingredients-row td {
  font-weight: 500 !important;
}
#shopify-section-{{ section.id }} .custom-nutrition-section {
  padding-top: 60px;
  background-color: var(--craftmix-sky-blue);
  position: relative;
}
#shopify-section-{{ section.id }} .custom-nutrition-section-container {
  margin: 0 auto;
  padding: 0 45px;
  max-width: 1400px;
  position: relative;
}
#shopify-section-{{ section.id }} .top-section {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  position: relative;
}
#shopify-section-{{ section.id }} .variety-pack-heading {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 2rem;
}
#shopify-section-{{ section.id }} .variety-pack-subheading {
  color: rgba(0, 38, 87, 1);
  font-family: "Goldplay";
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.43px;
  line-height: 17px;
  text-transform: uppercase;
  margin-bottom: 8px;
}
#shopify-section-{{ section.id }} .variety-pack-title {
  color: rgba(0, 38, 87, 1);
  font-family: "Hornbill";
  font-size: 64px;
  font-weight: 700;
  letter-spacing: -1.68px;
  line-height: 54px;
  margin-bottom: 40px;
}
#shopify-section-{{ section.id }} .variety-pack-description {
  opacity: 0.9;
  color: #002657;
  font-family: "Goldplay";
  font-size: 1.125rem;
  font-weight: 500;
  letter-spacing: -0.11px;
  line-height: 1.5rem;
}
#shopify-section-{{ section.id }} .variety-pack-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
  margin-top: 2rem;
}

@media (max-width: 1156px) {
#shopify-section-{{ section.id }} .variety-pack-grid {
    grid-template-columns: 1fr;
  }
}
#shopify-section-{{ section.id }} .variety-pack-item {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  padding: 1.5rem 0;
}
#shopify-section-{{ section.id }} .whats-in-craftmix {
  width: 451px;
  margin-left: 20px;
  margin-right: 12px;
}
#shopify-section-{{ section.id }} .whats-in-craftmix-subheading {
  color: rgba(0, 38, 87, 1);
