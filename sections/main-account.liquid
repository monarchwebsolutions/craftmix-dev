{% liquid 
if settings.lang_direction contains request.locale.iso_code
  assign is_rtl = true
else
  assign is_rtl = false
endif
%}
 
<div class="customer-account-section">

  <div class="customer-account-container">
    <img class="background-fruit fruit-cherry" src="https://cdn.shopify.com/s/files/1/2340/1623/files/cherrycherry.png?v=1739182967"  width="171" height="218" alt="Cherry" >
    <img class="background-fruit fruit-blueberry" src="https://cdn.shopify.com/s/files/1/2340/1623/files/blueberry.png?v=1739183661" width="108" height="110" alt="Blueberry">
    <img class="background-fruit fruit-mint" src="https://cdn.shopify.com/s/files/1/2340/1623/files/mint.svg?v=1738881269" width="294" height="270" alt="Mint">
    <img class="background-fruit fruit-grapefruit" src="https://cdn.shopify.com/s/files/1/2340/1623/files/grapefruit.png?v=1739183425" width="220" height="220" alt="Grapefruit">
    <img class="background-fruit fruit-strawberry" src="https://cdn.shopify.com/s/files/1/2340/1623/files/strawberry.png?v=1739183172" width="169" height="160" alt="Strawberry">
    <img class="background-fruit fruit-lime" src="https://cdn.shopify.com/s/files/1/2340/1623/files/lime2lime.png?v=1739183072" width="218" height="185" alt="Lime">
    <div class="customer-account_container-header">
      <h5 class="customer-account_container-subheading">Your Account</h5>
      <h2 class="customer-account_container-heading">Hey, {{ customer.first_name }}</h2>
    </div>

   
    <div class="account-page">
      <div class="account-details-wrapper">
        <div class="account-details">
          
          <div class="account-details_nav">
            <nav class="account-nav">
              <ul class="account-ul tabs">
                <li data-tab-target="#profile" class="account-li tab active" tabindex="0">Profile</li>
                <li data-tab-target="#orders" class="account-li tab" tabindex="0">Past orders</li>
                <li data-tab-target="#returns" class="account-li tab" tabindex="0">Returns</li>
                <li data-tab-target="#subscriptions" class="account-li tab" tabindex="0">Subscription</li>
              </ul>
            </nav>
          </div>

          <div class="account-details_main tab-content">
    

            <div id="profile" class="content-body profile active" data-tab-content>
              <div class="profile-content">
                <div class="general">
                  <h3 class="general-title">General</h3>
                  <div class="name">
                    <h4>Name</h4>
                    <p>{{ customer.first_name }} {{ customer.last_name }}</p>
                  </div>
                  <div class="email">
                    <h4>Email</h4>
                    <p>{{ customer.email }}</p>
                  </div>
                </div>
                <div class="address">
                  <h3 class="address-title">Address</h3>
                  <p class="account-address">{{ customer.default_address | format_address }}</p>
                </div>
              </div>
            </div>

            <!-- Past Orders  -->
          
            <div id="orders" class="content-body past-orders" data-tab-content>
              <h3 class="past-orders-title">Recent Orders</h3>
            
              {% if customer.orders.size > 0 %}
                <ul class="order-list">
                  {% for order in customer.orders limit:5 %}
                    <li class="order-item">
                      <p class="order-number">
                        <!-- <a href="{{ order.order_status_url }}">Order {{ order.name }}</a> -->
                        Order {{ order.name }}
                      </p>
                      <p class="order-date">{{ order.created_at | date: "%B %d, %Y" }}</p>
                      <p class="order-total">Total: {{ order.total_price | money }}</p>
                      <p class="order-status">Status: {{ order.fulfillment_status | capitalize }}</p>
            
                      <ul class="product-list">
                        {% for line_item in order.line_items %}
                          <li class="product-item">
                            <p class="product-title">{{ line_item.title }}</p>
                          </li>
                        {% endfor %}
                      </ul>
                    </li>
                  {% endfor %}
                </ul>
              {% else %}
                <div class="empty-orders">
                  <p>You haven't placed any orders yet.</p>
                  <a href="/collections/all" class="empty-orders-btn">Start Shopping</a>
                </div>
              {% endif %}
            </div>
            
            <div id="returns" class="content-body returns" data-tab-content>
              <h3 class="returns-title">Returns</h3>
               <p>If you would like to check the status of your active returns, please sign in <a href="https://www.craftmix.com/apps/redo/returns-portal/login" class="account-text-link" target="_blank" rel="noopener">here</a>.</p>

            </div>
            
            <div id="subscriptions" class="content-body subscriptions" data-tab-content>
              <h3 class="subscriptions-title">Subscriptions</h3>
               <p>See all details on your subscriptions <a href="https://www.craftmix.com/a/account/subscriptions" class="account-text-link" target="_blank" rel="noopener">here</a>.</p>
            </div> 
          </div>

      

        </div>
      </div>
    </div>

    
    <div class="customer-account_container-cta">
      <a href="/account/logout/" class="logout-button">Logout</a>
    </div>

  </div>
  
</div>

<div class="subscribe-card-section">
  <div class="subscribe-card">
    <img class="subscribe-card-image" src="https://cdn.shopify.com/s/files/1/2340/1623/files/subscribe-card.svg?v=1737762251" width="297" height="175" alt="Cocktail illustration">

    <div class="subscribe-card-text">
      <h2>Never get left dry!</h2>
      <p>Subscribe & save 15% today</p>
    </div>
    <div class="subscribe-card-cta">
      <a href="/pages/subscriptions" class="subscribe-card-btn">
        Subscribe today - Learn more
      </a>
    </div>
  </div>
</div>





{% style %}
/* ****************** */
/* *  Account Info  * */
/* ****************** */
*,
*::after,
*::before {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

a {
  text-decoration: none;
}

ul {
  list-style: none;
}

img {
  max-width: 100%;
}

  
.customer-account-section {
  background-color: #bfefff;
}



.account-details-wrapper {
  max-width: 1400px;
  margin: 0 auto;
  position: relative;
}

.customer-account_container-header {
  width: 100%;
  text-align: center;
  padding: 45px 0;
}

h5.customer-account_container-subheading {
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.43px;
  text-align: center;
  text-transform: uppercase;
}

h2.customer-account_container-heading {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 40px;
  font-weight: 700;
  letter-spacing: -1.05px;
  text-align: center;
}

.account-details {
  margin: 0 auto;
  width: 930px;
  height: 465px;
  background-color: #fff;
  border-radius: 20px;
  border: 1.5px solid rgba(0, 38, 87, 0.22);
  opacity: 1;
  overflow: hidden;
  position: relative;
}

.account-details_nav {
  height: 59px;
  border-bottom: 1.5px solid rgba(0, 38, 87, 0.2);
}

nav.account-nav {
  height: 59px;
}

nav ul.account-ul {
  height: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: start;
}

nav ul li.account-li {
  height: 100%; 
  display: flex; 
  align-items: center; 
  padding: 0px 34px; 
  cursor: pointer;
  transition: background-color 0.3s ease;
  color: #002657;
  font-family: "Goldplay";
  font-size: 15px;
  font-weight: 600;
  letter-spacing: -0.09px;
  text-align: left;
  line-height: 16px;
}

nav ul li.account-li:hover,
nav ul li.account-li:active,
.tab.active{
  background-color: #002657;
  color: #fff;
}

.account-details_main {
  height: 405px;
  width: 100%;
}

.profile {
  height: 404px;
  width: 100%;
  max-width: 926px; 
  margin: 0 auto;
}

.profile-content {
  display: flex;
  flex-direction: row;
  height: 100%;
}

.general {
  flex: 0 0 33%;
  height: 100%;
  border-right: 1.5px solid rgba(0, 38, 87, 0.2);
  padding-top: 37px;
  padding-left: 40px;
}

.address {
  flex: 0 0 66%;
  height: 100%;
  padding-top: 37px;
  padding-left: 40px;
}

.account-address {
    opacity: 0.9;
color: rgba(0, 38, 87, 1);
font-family: "Goldplay";
font-size: 18px;
font-weight: 500;
font-style: Medium;
letter-spacing: -0.11px;
text-align: left;
line-height: 24px;
  }

.past-orders,
.returns,
.subscriptions {
  padding: 36px 40px;
}

.general-title,
.address-title,
.past-orders-title,
.returns-title,
.subscriptions-title {
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 20px;
  font-weight: 600;
  font-style: SemiBold;
  letter-spacing: -0.13px;
  text-align: left;
  line-height: 20px;
  margin-bottom: 32px;
}

.name h4,
.email h4 {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 15px;
  font-weight: 600;
  font-style: SemiBold;
  letter-spacing: -0.09px;
  text-align: left;
  line-height: 16px;
  margin-bottom: 2px;
}

.name {
  margin-bottom: 63px;
}

.name p,
.email p {
  opacity: 0.9;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 500;
  font-style: Medium;
  letter-spacing: -0.11px;
  text-align: left;
  line-height: 24px;
}
  
.customer-account_container-cta {
  width: 928px;
  margin: 0 auto; 
  padding-top: 30px;
  padding-bottom: 118px;
}
  
.customer-account_container-cta a {
  position: relative;
    display: inline-block;
    color: rgba(0, 38, 87, 1);
    font-family: "Goldplay";
    font-size: 20px;
    font-weight: 600;
    font-style: SemiBold;
    letter-spacing: -0.13px;
    text-align: left;
    line-height: 20px;
     border-bottom: 1.5px solid rgba(0, 38, 87, 1);
    padding-bottom: 7px;
    z-index: 4;

}

/* orders section  */
.order-list {
  list-style-type: none;
  padding: 0;
}

.order-item {
  margin-bottom: 20px;
  border-bottom: 1px solid #eee;
  padding-bottom: 20px;
}

.order-number {
  font-weight: bold;
}

.order-date {
  color: #666;
}

.product-list {
  list-style-type: none;
  padding-left: 20px;
}

.product-item {
  margin-top: 10px;
}


/* Classes for nav */
[data-tab-content] {
  display: none;
}
.active[data-tab-content] {
  display: block;
}

/* media queries  */

@media screen and (max-width: 1040px) {
  .account-details {
    width: 388px;
    height: 498px;
  }

  nav ul.account-ul {
    height: 100%;
