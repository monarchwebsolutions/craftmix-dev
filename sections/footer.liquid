.custom-contact-modal {
  display: none;
  position: fixed;
  z-index: 1000;
  right: 0;
  top: 112px;
  width: 100%;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.5);

  align-items: flex-start;
  justify-content: flex-end;
}

.modal-content {
  background: #fff9f5;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 400px;
  height: calc(100vh - 112px);

  padding: 25px;
  position: relative;

  overflow-y: auto; 
  -webkit-overflow-scrolling: touch; 
}

.modal-content .form-body {
  margin-bottom: 60px;
}  
  
.close-modal {
  width: 46px;
  height: 46px;
  cursor: pointer;
}
body.modal-open {
  overflow: hidden;
  height: 100vh;
  width: 100vw;
  position: fixed;
}

.modal-content form label {
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 600;
  letter-spacing: -0.11px;
  text-align: left;
  line-height: 22px;
  display: block;
  margin-bottom: 5px;
}

.modal-content form textarea,
.modal-content form input {
  width: 100%;
  border-radius: 28px;
  padding: 15px 23px;
  border: 1px solid #002657;
  margin-bottom: 20px;
  font-size: 16px;
}

.modal-content form input::placeholder,
.modal-content form textarea::placeholder {
  opacity: 0.5;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 500;
  letter-spacing: -0.11px;
  text-align: left;
  line-height: 24px;
}

.custom-contact-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 45px;
}
.custom-contact-modal-header h2 {
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 30px;
  font-weight: 700;
  letter-spacing: -0.79px;
  text-align: left;
}

.custom-submit-button {
    display: block;
    text-align: center;
    padding: 15px;
    border-radius: 33px;
    border: 1.5px solid rgba(0, 38, 87, 1);
    box-shadow: 2px 6px 0px rgba(0, 38, 87, 1);
    background-color: rgba(96, 211, 248, 1);
    opacity: 1;
    color: rgba(0, 38, 87, 1);
    font-family: "Goldplay";
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.13px;
    text-align: center;
    line-height: 20px;
    text-decoration: none;
    width: 100%;
    cursor: pointer;
    margin-top: 10px;
}

@media (max-width: 1023px) {
  .custom-contact-modal {
    top: 108px;
  }
}
  
@media (max-width: 529px) {
  .custom-contact-modal {
    top: 0;
    height: 100vh;
  }
  .modal-content {
    height: 100vh; 
  }
  .custom-contact-modal-header {
    margin-bottom: 20px;
  }
  .custom-submit-button {
    margin-top: 0px;
  }
}
{% endstyle %}
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const modal = document.getElementById("custom-contact-modal");
    const openButtons = document.querySelectorAll("a[href='#custom-contact-modal']");
    const closeButton = modal ? modal.querySelector(".close-modal") : null;
    const body = document.body;

    if (!modal) return;

    // --- Accessibility setup ---
    // Ensure dialog semantics
    modal.setAttribute("role", "dialog");
    modal.setAttribute("aria-modal", "true");
    if (!modal.getAttribute("aria-labelledby")) modal.setAttribute("aria-labelledby", "contact-modal-title");

    // Make the close "img" act like a button
    if (closeButton) {
      if (!closeButton.hasAttribute("tabindex")) closeButton.setAttribute("tabindex", "0");
      if (!closeButton.hasAttribute("role")) closeButton.setAttribute("role", "button");
    }

    // Track last focused element to restore focus on close
    let lastActiveEl = null;

    function isModalOpen() {
      return modal.style.display !== "none" && getComputedStyle(modal).display !== "none";
    }

    function getFocusableElements() {
      const selectors = [
        'a[href]',
        'button:not([disabled])',
        'input:not([disabled])',
        'select:not([disabled])',
        'textarea:not([disabled])',
        '[tabindex]:not([tabindex="-1"])'
      ].join(',');

      return Array.from(modal.querySelectorAll(selectors)).filter((el) => {
        const style = getComputedStyle(el);
        // filter out hidden/disabled/zero-dimension elements
        if (style.display === "none" || style.visibility === "hidden") return false;
        if (el.hasAttribute("disabled")) return false;
        return !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length);
      });
    }

    function focusFirstInModal() {
      // Per your requirement, focus the close "button" first
      if (closeButton) {
        closeButton.focus();
        return;
      }

      const focusables = getFocusableElements();
      if (focusables.length) focusables[0].focus();
      else modal.focus?.();
    }

    function openModal() {
      lastActiveEl = document.activeElement;

      modal.style.display = "flex";
      body.classList.add("modal-open"); // Prevent scrolling
      modal.setAttribute("aria-hidden", "false");

      // Focus after render
      requestAnimationFrame(() => {
        focusFirstInModal();
      });
    }

    function closeModal() {
      modal.style.display = "none";
      body.classList.remove("modal-open");
      modal.setAttribute("aria-hidden", "true");

      // Restore focus to opener
      if (lastActiveEl && typeof lastActiveEl.focus === "function") {
        requestAnimationFrame(() => lastActiveEl.focus());
      }
    }

    // Ensure modal is hidden on load
    modal.style.display = "none";
    modal.setAttribute("aria-hidden", "true");

    // Open handlers
    openButtons.forEach((button) => {
      button.addEventListener("click", function (event) {
        event.preventDefault();
        openModal();
      });
    });

    // Close button handlers (click + Enter/Space)
    if (closeButton) {
      closeButton.addEventListener("click", function (e) {
        e.preventDefault();
        e.stopPropagation();
        closeModal();
      });

      closeButton.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          e.stopPropagation();
          closeModal();
        }
      });
    }

    // Click outside modal-content closes (backdrop click)
    window.addEventListener("click", function (event) {
      if (event.target === modal) closeModal();
    });

    // Trap focus + ESC close
    document.addEventListener("keydown", function (e) {
      if (!isModalOpen()) return;

      // ESC closes
      if (e.key === "Escape") {
        e.preventDefault();
        e.stopPropagation();
        closeModal();
        return;
      }

      // Trap Tab
      if (e.key !== "Tab") return;

      const focusables = getFocusableElements();
      if (!focusables.length) {
        e.preventDefault();
        return;
      }

      const first = focusables[0];
      const last = focusables[focusables.length - 1];

      // If focus is outside modal, pull it back in
      if (!modal.contains(document.activeElement)) {
        e.preventDefault();
        first.focus();
        return;
      }

      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }, true);
  });
</script>

