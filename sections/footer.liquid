<link rel="stylesheet" href="{{ 'footer-custom.css' | asset_url }}">
{% liquid 
  if settings.lang_direction contains request.locale.iso_code
    assign class_rtl = 'rtl'
    assign is_rtl = true
  else
    assign class_rtl = 'ltr'
    assign is_rtl = false
  endif
%}

{% comment %}
Change the color of the footer background depending on the page being viewed
{% endcomment %}
<style>
  {% if template.name == 'product' or template == 'page.wholesale' or request.path == '/account' %}
    .footer-shell {
      background-color: var(--craftmix-sky-blue) !important;  
    }
  {% elsif template == 'page.faq' or template == 'collection' or request.path contains '/account' %}
    .footer-shell {
      background-color: #ddf7f7 !important;  
    }
  {% elsif template == 'article' or template == 'page.store-locator-2025' %}
    .footer-shell {
      background-color: #BFEFFF !important;  
    }
  {% elsif request.path contains '/a/account' %}
    .footer-shell {
      background-color: #ffffff !important;  
    }
  {% else %}
    .footer-shell {
      background-color: #fff9f5 !important;  /* Default color for other pages */
    }
  {% endif %}
</style>

<div class="footer-shell">
  
    <div id="custom-contact-modal" class="custom-contact-modal" role="dialog" aria-labelledby="contact-modal-title" aria-modal="true">
      
      <div class="modal-content">

        <div class="custom-contact-modal-header">
          <img class="close-modal lazy-img" height="46" width="46" alt="Dark blue X icon on circular light blue background" data-src="{{ "modal-close.png" | asset_url }}" tabindex="0">
          <h2 id="contact-modal-title">Contact Us</h2>
        </div>
  
        {%- form 'contact', id: 'custom-contact-form', class: 'custom-form-class' -%}

        <div class="form-body">
            {%- if form.posted_successfully? -%}
              <p class="custom-success-message">Your message has been sent successfully!</p>
            {%- elsif form.errors -%}
              <p class="custom-error-message">{{ form.errors | default_errors }}</p>
            {%- endif -%}
          
            <label for="contact-name">Name</label>
            <input type="text" id="contact-name" name="contact[name]" class="custom-input" placeholder="First & Last Name" required>
          
            <label for="contact-email">Email Address</label>
            <input type="email" id="contact-email" name="contact[email]" class="custom-input" placeholder="Enter your Email Address" required>
          
            <label for="contact-phone">Phone</label>
            <input type="tel" id="contact-phone" name="contact[phone]" class="custom-input" placeholder="xxx-xxx-xxxx" required>
          
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="contact[body]" class="custom-textarea" rows="6" placeholder="Let us know how we can help" required></textarea>
          
            <button type="submit" class="custom-submit-button">Send</button>
        </div> 
          {%- endform -%}
      </div>
    </div>
  
  <div class="section-footer background-footer sticky-footer selection:bg-[rgba(var(--colors-text-footer),0.2)] pt-[{{ section.settings.top_padding_mobile }}px] md:pt-[{{ section.settings.top_padding }}px] pb-[{{ section.settings.bottom_padding_mobile }}px] md:pb-[{{ section.settings.bottom_padding }}px]">
    {%- if section.settings.show_social_icons -%}
      <div class="flex items-center">
        {% render 'toolbar', show_social_icons: section.settings.show_social_icons %}
      </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 or section.settings.newsletter_enable or section.settings.show_social or section.settings.enable_follow_on_shop -%}
      <div class="flex-wrap md:mb-5 md:border-b md:border-b-solid md:pt-12 md:pb-7">
        {%- if section.blocks.size > 0 -%}
          {%- liquid
            assign number_col_footer = section.settings.columns_desktop
          -%}
          <div class="pt-6 md:pt-0 md:flex justify-center md:m-auto md:pr-0 rtl:md:pr-5 rtl:md:pl-0 page-width flex-wrap">
            {%- for block in section.blocks -%}
              {%- liquid
                assign number = forloop.index | modulo: number_col_footer
              -%}
            <div class="footer-col footer-col--{{ forloop.index }}{% if is_rtl %} md:pl-5 md:first:pr-0{% else %} md:pr-5 md:first:pl-0{% endif %} md:mb-7{% if number == 1 %}{% if is_rtl %} md:pr-0{% else %} md:pl-0{% endif %}{% else %}{% if is_rtl %} md:pr-10{% else %} md:pl-10{% endif %}{% endif %} w-full md:w-1/{{ section.settings.columns_desktop }} {{ class_rtl }}" {{ block.shopify_attributes }}>
                {%- case block.type -%}
                  {%- when 'text' -%}
                    <div x-data="{ open: {{ block.settings.open_by_default }} }" class="py-4 border-b border-b-solid md:border-none">
                      {%- if block.settings.heading_text != blank -%}
                      <div @click="open = ! open" class="relative{% if is_rtl %} pl-5{% else %} pr-5{% endif %} cursor-pointer md:cursor-default duration-200 transition" tabindex="0">
                          <p class="h6 text-[115%]">{{- block.settings.heading_text | escape -}}</p>
                          <span class="md:hidden absolute w-2.5	h-2.5 top-1/2 -translate-y-1/2 flex{% if is_rtl %} left-3.5{% else %} right-3.5{% endif %}" :class="open ? 'rotate-180' : ''">{% render 'icon-alls', icon: 'icon-custom-plus' %}</span>
                        </div>
                      {%- endif -%}
                      <div {% if block.settings.heading_text != blank %} :class="open ? 'block' : 'hidden md:block'"{% endif %}>
                        {%- if block.settings.image != blank -%}
                          {%- capture sizes -%}
                            {{ block.settings.image_width | times: 1.1 | ceil }}px
                          {%- endcapture -%}
                          {% style %}
                            .image-{{ block.id }} {
                              width: {{ block.settings.image_width }}px;
                            }
                          {% endstyle %}
                          {% assign image_tags = block.settings.image_width | times: 1.1 | ceil | append: '' %}
                          {%- if block.settings.link_image_footer != blank -%}
                            <a href="{{ block.settings.link_image_footer }}"{% if block.settings.open_new_window %} target="_blank"{% endif %} class="h-full inline-block overflow-hidden{% if block.settings.heading_text != blank %} mt-6{% endif %}{% if block.settings.rounded_corner_image %} rounded-[10px]{% endif %}">
                              {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: widths: image_tags,
                                height: block.settings.image.height,
                                class: "image-hover",
                                width: block.settings.image.width,
                                sizes: sizes,
                                alt: block.settings.image.alt | escape
                              }}
                            </a>
                          {%- else -%}
                            <div class="h-full inline-block overflow-hidden{% if block.settings.heading_text != blank %} mt-6{% endif %}{% if block.settings.rounded_corner_image %} rounded-[10px]{% endif %}">
                              {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: widths: image_tags,
                                height: block.settings.image.height,
                                class: "image-hover",
                                width: block.settings.image.width,
                                sizes: sizes,
                                alt: block.settings.image.alt | escape
                              }}
                            </div>
                          {%- endif -%}
                        {%- endif -%}
                        <div class="rte{% if block.settings.image != blank %} mt-2{% else %} mt-6{% endif %}">{{ block.settings.subtext }}</div>
                        {%- if block.settings.show_social_icons -%}
                          <div class="mt-2">
                            {% render 'toolbar', enable_footer: true, show_social_icons: block.settings.show_social_icons %}
                          </div>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- when 'link_list' -%}
                    <div x-data="{ open: {{ block.settings.open_by_default }} }" class="py-4 border-b md:border-none">
                      {%- if block.settings.heading_menu != blank -%}
                        <div @click="open = ! open" class="relative{% if is_rtl %} pl-5{% else %} pr-5{% endif %} cursor-pointer md:cursor-default duration-200 transition" tabindex="0">
                          <p class="h6 text-[115%]">{{- block.settings.heading_menu | escape -}}</p>
                          <span class="md:hidden absolute w-2.5	h-2.5 top-1/2 -translate-y-1/2 flex{% if is_rtl %} left-3.5{% else %} right-3.5{% endif %}" :class="open ? 'rotate-180' : ''">{% render 'icon-alls', icon: 'icon-custom-plus' %}</span>
                        </div>
                      {%- endif -%}
                      {%- if block.settings.menu != blank -%}
                        <ul class="mt-6"{% if block.settings.heading_menu != blank %} :class="open ? 'block' : 'hidden md:block'"{% endif %}>
                          {%- for link in block.settings.menu.links -%}
                            <li class="mb-1 first:pt-0 pt-2">
                              <a href="{{ link.url }}" class="hover-text-link nav-link relative block lg:inline-block">
                                {{ link.title }}
                              </a>
                            </li>
                          {%- endfor -%}
                          {%- if block.settings.show_social_icons -%}
                            <div class="mt-2">
                              {% render 'toolbar', enable_footer: true, show_social_icons: block.settings.show_social_icons %}
                            </div>
                          {%- endif -%}
                        </ul>
                      {%- endif -%}
                    </div>
                  {%- when 'image' -%}
                    <div class="py-4 text-{{ block.settings.alignment }} flex flex-col justify-start{% if number == 1 %} md:pr-0{% endif %}{% if block.settings.alignment == 'center' %} items-center{% elsif block.settings.alignment == 'right' %} items-end{% endif %}">
                      {%- if block.settings.image != blank -%}
                        {%- capture sizes -%}
                          {{ block.settings.image_width | times: 1.1 | ceil }}px
                        {%- endcapture -%}
                        {% style %}
                          .image-{{ block.id }} {
                            width: {{ block.settings.image_width }}px;
                          }
                        {% endstyle %}
                        {% assign image_tags = block.settings.image_width | times: 1.1 | ceil | append: '' %}
                        {%- if block.settings.link_image_footer != blank -%}
                          <a href="{{ block.settings.link_image_footer }}"{% if block.settings.open_new_window %} target="_blank"{% endif %} class="image-{{ block.id }} h-full inline-block overflow-hidden{% if block.settings.rounded_corner_image %} rounded-[10px]{% endif %}">
                            {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: widths: image_tags,
                              height: 'auto',
                              class: "image-hover",
                              width: block.settings.image_width,
                              sizes: sizes,
                              alt: block.settings.image.alt | escape
                            }}
                          </a>
                        {%- else -%}
                          <div class="image-{{ block.id }} h-full inline-block overflow-hidden{% if block.settings.rounded_corner_image %} rounded-[10px]{% endif %}">
                            {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: widths: image_tags,
                              height: 'auto',
                              class: "image-hover",
                              width: block.settings.image_width,
                              sizes: sizes,
                              alt: block.settings.image.alt | escape
                            }}
                          </div>
                        {%- endif -%}
                      {%- else -%}
                        {% liquid
                          assign class_img = 'max-w-[13rem] bg-neutral-200'
                          if block.settings.rounded_corner_image 
                            assign class_img = class_img | append: ' rounded-[10px]'
                          endif
                        %}
                        {{ 'image' | placeholder_svg_tag: class_img }}  
                      {%- endif -%}
                      {% if block.settings.text != blank %}
                        {% style %}
                          .text-{{ block.id }} {
                            margin-top: {{ block.settings.spacing }}px;
                          }
                          .text-{{ block.id }}.rte p:first-child {
                            margin-top: 0px;
                          }
                        {% endstyle %}
                        <div class="text-{{ block.id }} rte">
                          {{ block.settings.text }}
                        </div>
                      {% endif %}
                    </div>
                  {%- when 'email_footer' -%}
                    <div class="klaviyo-form-S5VwZV"></div>
                  {% when 'contact' %}
                    <div x-data="{ open: {{ block.settings.open_by_default }} }" class="py-4 border-b md:border-none">
                      {%- if block.settings.heading_menu != blank -%}
                        <div @click="open = ! open" class="relative{% if is_rtl %} pl-5{% else %} pr-5{% endif %} cursor-pointer md:cursor-default duration-200 transition" tabindex="0">
                          <p class="h6 text-[115%]">{{- block.settings.heading_menu | escape -}}</p>
                        <span class="md:hidden absolute w-2.5	h-2.5 top-1/2 -translate-y-1/2 flex{% if is_rtl %} left-3.5{% else %} right-3.5{% endif %}" :class="open ? 'rotate-180' : ''">{% render 'icon-alls', icon: 'icon-custom-plus' %}</span>
                        </div>
                      {%- endif -%}
                      <div class="mt-6" :class="open ? 'block' : 'hidden md:block'">
                        {% if block.settings.icon_1 != 'none' or block.settings.title_1 or block.settings.text_1 %}
                          <div class="mb-4 flex items-center gap-x-4">
                            {% if block.settings.icon_1 != 'none' %}
                              {% unless block.settings.custom_icon == blank and block.settings.another_icon_1 == blank and block.settings.icon_1 == 'another_icon' %}
                                <span class="inline-block h-6 w-6 lg:h-9 lg:w-9 min-w-[24px] lg:min-w-[36px]">
                                  {% if block.settings.custom_icon == blank %}
                                    {% if block.settings.another_icon_1 != blank and block.settings.icon_1 == 'another_icon' %}
                                      {% render 'icon-new-alls', icon: block.settings.another_icon_1 %}
                                    {% else %}
                                      {% render 'icon-labels-bags', icon: block.settings.icon_1 %}
                                    {% endif %}
                                  {% else %}
                                    {{ block.settings.custom_icon }}
                                  {% endif %}
                                </span>
                              {% endunless %}
                            {% endif %}
                            {% if block.settings.title_1 or block.settings.text_1 %}
                              <div>
                                <p class="empty:hidden p-break-words">{{ block.settings.title_1 | escape }}</p>
                                {% if block.settings.text_link_1 != blank %}
                                  <a href="{{ block.settings.text_link_1 }}"{% if block.settings.open_new_window_1 %} target="_blank"{% endif %}
                                    class="font-semibold p-break-words empty:hidden{% if block.settings.enable_text_link_1 %} text-[rgb(var(--colors-text-link))]{% endif %} hover-text-link nav-link relative"
                                  >
                                    {{ block.settings.text_1 | escape }}
                                  </a>
                                {% else %}
                                  <p class="font-semibold p-break-words empty:hidden{% if block.settings.enable_text_link_1 %} text-[rgb(var(--colors-text-link))]{% endif %}">
                                    {{ block.settings.text_1 | escape }}
                                  </p>
                                {% endif %} 
                              </div>
                            {% endif %}
                          </div>
                        {% endif %}
                        {% if block.settings.icon_2 != 'none' or block.settings.title_2 or block.settings.text_2 %}
                          <div class="mb-4 flex items-center gap-x-4">
                            {% if block.settings.icon_2 != 'none' %}
                              {% unless block.settings.custom_icon_2 == blank and block.settings.another_icon_2 == blank and block.settings.icon_2 == 'another_icon' %}
                                <span class="inline-block min-w-[24px] lg:min-w-[36px] h-6 w-6 lg:h-9 lg:w-9">
                                  {% if block.settings.custom_icon_2 == blank %}
                                    {% if block.settings.another_icon_2 != blank and block.settings.icon_2 == 'another_icon' %}
                                      {% render 'icon-new-alls', icon: block.settings.another_icon_2 %}
                                    {% else %}
                                      {% render 'icon-labels-bags', icon: block.settings.icon_2 %}
                                    {% endif %}
                                  {% else %}
                                    {{ block.settings.custom_icon_2 }}
                                  {% endif %}
                                </span>
                              {% endunless %}
                            {% endif %}
                            {% if block.settings.title_2 or block.settings.text_2 %}
                              <div>
                                <p class="empty:hidden">{{ block.settings.title_2 | escape }}</p>
                                {% if block.settings.text_link_2 != blank %}
                                  <a href="{{ block.settings.text_link_2 }}"{% if block.settings.open_new_window_2 %} target="_blank"{% endif %}
                                    class="font-semibold p-break-words empty:hidden{% if block.settings.enable_text_link_2 %} text-[rgb(var(--colors-text-link))]{% endif %} hover-text-link nav-link relative"
                                  >
                                    {{ block.settings.text_2 | escape }}
                                  </a>
                                {% else %}
                                  <p class="font-semibold p-break-words empty:hidden{% if block.settings.enable_text_link_2 %} text-[rgb(var(--colors-text-link))]{% endif %}">
                                    {{ block.settings.text_2 | escape }}
                                  </p>
                                {% endif %} 
                              </div>
                            {% endif %}
                          </div>
                        {% endif %}
                        {% if block.settings.icon_3 != 'none' or block.settings.title_3 or block.settings.text_3 %}
                          <div class="mb-4 flex items-center gap-x-4">
                            {% if block.settings.icon_3 != 'none' %}
                              {% unless block.settings.custom_icon_3 == blank and block.settings.another_icon_3 == blank and block.settings.icon_3 == 'another_icon' %}
                                <span class="inline-block h-6 w-6 lg:h-9 lg:w-9 min-w-[24px] lg:min-w-[36px]">
                                  {% if block.settings.custom_icon_3 == blank %}
                                    {% if block.settings.another_icon_3 != blank and block.settings.icon_3 == 'another_icon' %}
                                      {% render 'icon-new-alls', icon: block.settings.another_icon_3 %}
                                    {% else %}
                                      {% render 'icon-labels-bags', icon: block.settings.icon_3 %}
                                    {% endif %}
                                  {% else %}
                                    {{ block.settings.custom_icon_3 }}
                                  {% endif %}
                                </span>
                              {% endunless %}
                            {% endif %}
                            {% if block.settings.title_3 or block.settings.text_3 %}
                              <div>
                                <p class="empty:hidden">{{ block.settings.title_3 | escape }}</p>
                                {% if block.settings.text_link_3 != blank %}
                                  <a href="{{ block.settings.text_link_3 }}"{% if block.settings.open_new_window_3 %} target="_blank"{% endif %}
                                    class="font-semibold p-break-words empty:hidden{% if block.settings.enable_text_link_3 %} text-[rgb(var(--colors-text-link))]{% endif %} hover-text-link nav-link relative"
                                  >
                                    {{ block.settings.text_3 | escape }}
                                  </a>
                                {% else %}
                                  <p class="font-semibold p-break-words empty:hidden{% if block.settings.enable_text_link_3 %} text-[rgb(var(--colors-text-link))]{% endif %}">
                                    {{ block.settings.text_3 | escape }}
                                  </p>
                                {% endif %}
                              </div>
                            {% endif %}
                          </div>
                        {% endif %}
                      </div>
                      {%- if block.settings.show_social_icons -%}
                        <div class="mt-4 md:mt-6 pb-1">
                          {% render 'toolbar', enable_footer: true, show_social_icons: block.settings.show_social_icons %}
                        </div>
                      {%- endif -%}
                    </div>
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
      <div class="page-width text-center pt-5 md:pt-3.5 md:pb-3 pb-2 change-position-popup">
      {% comment %} TODO: enable theme-check once `login_button` is accepted as valid filter {% endcomment %}
      {% comment %}theme-check-disable{% endcomment %}
        {{ shop | login_button: action: 'follow' }}
      {% comment %}theme-check-enable{% endcomment %}
      </div>
    {%- endif -%}
    <div class="additional-footer {{ class_rtl }}{% if section.settings.additional_layout == 'horizontal' %} page-width mx-auto lg:flex lg:flex-row lg:justify-between items-center{% else %} mx-5{% endif -%}"
    >
      <img class="lazy-img" width="5309" height="984" alt="Opaque Craftmix logo" data-src="https://cdn.shopify.com/s/files/1/2340/1623/files/main_4x_be510f58-c11e-48c6-b367-89375ab7f42c.png?v=1738482253">
      <div class="footer-bottom">
        <div class="social-icons-container">
          <div class="social-icon ig-icon">
            <a target="_blank" class="social-icon-link" href="https://www.instagram.com/craftmix/"><img class="lazy-img" width="28" height="28" alt="Instagram icon" data-src="{{ "ig-icon.svg" | asset_url }}"></a>
          </div>
          <div class="social-icon fb-icon">
            <a target="_blank" class="social-icon-link" href="https://www.facebook.com/craftmix"><img class="lazy-img" width="15" height="30" alt="Facebook icon" data-src="{{ "fb-icon.svg" | asset_url }}"></a>
          </div>
          <div class="social-icon tt-icon">
            <a target="_blank" class="social-icon-link" href="https://www.tiktok.com/@craftmix"><img class="lazy-img" width="25" height="30" alt="TikTok icon" data-src="{{ "tt-icon.svg" | asset_url }}"></a>
          </div>
          <div class="social-icon yt-icon">
            <a target="_blank" class="social-icon-link" href="https://www.youtube.com/@craftmix_"><img class="lazy-img" width="34" height="24" alt="Youtube icon" data-src="{{ "yt-icon.svg" | asset_url }}"></a>
          </div>
        </div>
        <div class="copyright-text">©Craftmix 2025. All Rights Reserved.</div>
        <div class="footer-badges-container">
          <img class="lazy-img" width="363" height="56" alt='Set of four white circular badges on a transparent background displaying the phrases: "Pocket-Sized Convenience" with a packet icon, "Natural Ingredients" with a strawberry icon, "Low Calorie Low Sugar" with sugar cubes and a down arrow, and "Affordable for Everyone" with clinking glasses.' data-src="https://cdn.shopify.com/s/files/1/2340/1623/files/footer-badges-natural-ingredients-2.png?v=1778103802">
        </div>
      </div>
    </div>
  </div>
</div>
<script>
document.addEventListener('keydown', (e) => {
  if (e.key !== 'Enter' && e.key !== ' ') return;

  const el = e.target;

  // Only divs acting like buttons
  if (
    el.tagName === 'DIV' &&
    el.getAttribute('tabindex') === '0' &&
    (
      el.hasAttribute('@click') ||          // literal Alpine syntax (if present)
      el.hasAttribute('x-on:click') ||       // compiled Alpine
      el.hasAttribute('data-click-toggle')   // optional future-proof hook
    )
  ) {
    e.preventDefault(); // prevent Space scroll
    el.click();
  }
});
</script>
