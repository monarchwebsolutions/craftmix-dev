    width: 16px;
  }
  .inline-svg.cry-face {
    height: 21px;
    width: 21px;
  }
  .inline-svg.paloma-simple {
    height: 20px;
    width: 22px;
  }
  .inline-svg.ice-cube {
    height: 30px;
    width: 30px;
  }
  .inline-svg.green-sachet {
    height: 18px;
    width: 18px;
  }
  .inline-svg.strawberry {
    height: 20px;
    width: 22px;
  }
}

{% endstyle %}

{% javascript %}
document.addEventListener("DOMContentLoaded", function () {
  const video = document.getElementById("about-video");
  const playIcon = document.getElementById("play-toggle");
  const volumeIcon = document.getElementById("volume-icon");
  const muteIcon = document.getElementById("mute-icon");
  const videoWrapper = document.getElementById("video-wrapper");
  const volumeToggle = document.getElementById("volume-toggle");

  // Helper: toggle play/pause state
  function togglePlayPause() {
    if (video.paused) {
      video.play();
      playIcon.style.display = "none";
      playIcon.tabIndex=-1
    } else {
      video.pause();
      playIcon.style.display = "inline";
      playIcon.tabIndex=0
    }
  }

  // Handle video click: anywhere except volume button
  videoWrapper.addEventListener("click", function (e) {
    if (!volumeToggle.contains(e.target)) {
      togglePlayPause();
    }
  });

  // Keyboard: Enter / Space

  videoWrapper.addEventListener("keydown", function (e) {
    if (e.key === "Enter" || e.key === " ") {
      // Prevent spacebar scrolling
      e.preventDefault();

      // Do not toggle if focus is on volume button
      if (!volumeToggle.contains(document.activeElement)) {
        togglePlayPause();
      }
    }
  });

  // Move focus to video wrapper when play button disappears

  playIcon.addEventListener("keydown", function (e) {
    if (e.key === "Enter" || e.key === " ") {
      requestAnimationFrame(() => {
        videoWrapper.focus();
      });
    }
  });

  // Handle volume toggle
  volumeToggle.addEventListener("click", function () {
    video.muted = !video.muted;
    volumeIcon.style.display = video.muted ? "none" : "inline";
    muteIcon.style.display = video.muted ? "inline" : "none";
  });

  volumeToggle.addEventListener("keydown", function (e) {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();

      video.muted = !video.muted;
      volumeIcon.style.display = video.muted ? "none" : "inline";
      muteIcon.style.display = video.muted ? "inline" : "none";
    }
  });

  // Pause when out of view
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) {
          if(!video.paused && !video.ended){
            togglePlayPause();
          }
        }
      });
    },
    { threshold: 0.2 }
  );

  observer.observe(video);
});
 
{% endjavascript %}

