    /* padding-left: 30px;
    padding-right: 30px; */
  }
  .image-container {
    width: 298px;
    max-width: 100%;
    height: auto;
  }
  .image-and-text .text {
    max-width: 388px;
  }
  .image-and-text .text p {
    font-size: 1, 25rem;
    letter-spacing: -0.11px;
    line-height: 1.5rem;
  }
}

/* Media query for tablet responsiveness */
@media (max-width: 768px) {
