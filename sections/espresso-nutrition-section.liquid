{% liquid
  assign selected_product = all_products[section.settings.product]
  if selected_product == blank and product
    assign selected_product = product
  endif

  assign section_bg = section.settings.background_color
  if section_bg == blank and selected_product and selected_product.metafields.custom.color_3 != blank
    assign section_bg = selected_product.metafields.custom.color_3
  endif
  if section_bg == blank
    assign section_bg = '#FFF9F5'
  endif

  assign accent_color = '#002657'
  if selected_product and selected_product.metafields.custom.color_1 != blank
    assign accent_color = selected_product.metafields.custom.color_1
  endif

  assign hide_caffeine_card = false
  if request.path contains 'variety-pack'
    assign hide_caffeine_card = true
  endif

  assign is_variety_pack = false
  assign variety_products = blank
  if selected_product and selected_product.metafields.custom.variety_pack_products.value != blank
    assign variety_products = selected_product.metafields.custom.variety_pack_products.value
    assign is_variety_pack = true
  endif

  assign hero_source_product = selected_product
  if is_variety_pack and variety_products.first
    assign hero_source_product = variety_products.first
  endif

  assign hero_image = blank
  if hero_source_product and hero_source_product.metafields.custom.nutrition_section_image != blank
    assign hero_image = hero_source_product.metafields.custom.nutrition_section_image.value
  endif
  if hero_image == blank and hero_source_product and hero_source_product.featured_image
    assign hero_image = hero_source_product.featured_image
  endif
%}

{% if selected_product %}
<section class="espresso-nutrition-section" data-section-id="{{ section.id }}">
  {% if section.settings.decor_right != blank %}
    <div class="espresso-nutrition__decor espresso-nutrition__decor--right" aria-hidden="true">
      {{ section.settings.decor_right | image_url: width: 220 | image_tag: loading: 'lazy', alt: section.settings.decor_right.alt | escape }}
    </div>
  {% endif %}
  <div class="espresso-nutrition__inner">
    {% if is_variety_pack %}
      <div class="nutrition-card-selectors nutrition-card-selectors--desktop">
        {% for vp in variety_products %}
          {% assign selector_image = blank %}
          {% if vp.metafields.custom.nutrition_section_image != blank %}
            {% assign selector_image = vp.metafields.custom.nutrition_section_image.value %}
          {% endif %}
          {% if selector_image == blank and vp.featured_image %}
            {% assign selector_image = vp.featured_image %}
          {% endif %}
          {% assign selector_image_url = blank %}
          {% if selector_image and selector_image.src %}
            {% assign selector_image_url = selector_image | image_url: width: 800 %}
          {% elsif selector_image %}
            {% assign selector_image_url = selector_image %}
          {% endif %}
          <button
            class="nutrition-card-selector selector-{{ vp.handle }} {% if forloop.first %}selected{% endif %}"
            data-image-src="{{ selector_image_url | escape }}"
            data-image-alt="{{ vp.title | escape }}"
          >
            {{ vp.title }}
          </button>
        {% endfor %}
      </div>
    {% endif %}

    {% assign glass_image = hero_image %}
    {% assign glass_image_alt = hero_source_product.title | default: selected_product.title %}
    <div class="espresso-nutrition__grid">
      <div class="espresso-nutrition__image">
        {% if glass_image %}
          {% assign glass_image_url = blank %}
          {% if glass_image.src %}
            {% assign glass_image_url = glass_image | image_url: width: 800 %}
          {% else %}
            {% assign glass_image_url = glass_image %}
          {% endif %}
          <img
            class="espresso-nutrition__main-image"
            src="{{ glass_image_url | escape }}"
            loading="lazy"
            alt="{{ glass_image_alt | escape }}"
            width="800"
          >
        {% else %}
          {{ 'image' | placeholder_svg_tag }}
        {% endif %}
      </div>

      <div class="espresso-nutrition__content">
        {% if is_variety_pack %}
          {% for vp in variety_products %}
            {% assign card_bg = vp.metafields.custom.color_3 | default: section_bg %}
            {% assign card_text = vp.metafields.custom.color_1 | default: accent_color %}
            {% if vp.handle == 'mango-margarita' %}
              {% assign card_text = '#CCAA00' %}
            {% endif %}
            {% if vp.metafields.custom.illustration_b %}
              {% assign flavor_icon = vp.metafields.custom.illustration_b | file_url %}
            {% else %}
              {% assign flavor_icon = 'https://cdn.shopify.com/s/files/1/2340/1623/files/lime2.svg?v=1738881712' %}
            {% endif %}

            <div class="espresso-nutrition__panel panel-{{ vp.handle }} {% if forloop.first %}active{% endif %}">
              <p class="eyebrow">{{ section.settings.subheading | default: "What's in CraftMix" }}</p>
              <h2 class="heading">{{ section.settings.heading | default: "Quality Ingredients, Amazing Taste" }}</h2>
              {% assign body_copy = section.settings.body %}
              {% if body_copy == blank %}
                {% assign body_copy = "<p>Craftmix never uses artificial flavors, sweeteners, or preservatives and each flavor is made from natural powders.</p>" %}
              {% endif %}
              <div class="body-text rte">
                {{ body_copy }}
              </div>

              <div class="flavor-bar" data-flavor="{{ vp.metafields.custom.flavor_measure.value }}">
                <div class="flavor-range">
                  <div class="flavor-range-fill"></div>
                  <img src="{{ flavor_icon }}" alt="Flavor icon" class="flavor-icon" width="40" height="32" loading="lazy">
                </div>
                <div class="flavor-labels">
                  <span class="sweet-label">Sweet</span>
                  <span class="flavor-label">Flavor</span>
                  <span class="sour-label">{{ vp.metafields.custom.flavor_type.value | default: 'Rich' }}</span>
                </div>
              </div>

              <div class="metrics">
                <div class="metric-card" style="border-color: {{ card_text }}; color: {{ card_text }};">
                  <div class="metric-value">{{ vp.metafields.custom.calorie_total.value | default: 25 }}</div>
                  <div class="metric-label">Calories</div>
                </div>
                {% unless hide_caffeine_card %}
                  <div class="metric-card" style="border-color: {{ card_text }}; color: {{ card_text }};">
                    <div class="metric-value">
                      {{ vp.metafields.custom.caffeine_mg.value | default: vp.metafields.custom.caffeine_mass.value | default: 30 }}
                      <span class="metric-unit">mg</span>
                    </div>
                    <div class="metric-label">Caffeine</div>
                  </div>
                {% endunless %}
                <div class="metric-card" style="border-color: {{ card_text }}; color: {{ card_text }};">
                  <div class="metric-value">{{ vp.metafields.custom.sugar_mass.value | default: 5 }}<span class="metric-unit">g</span></div>
                  <div class="metric-label">Sugar</div>
                </div>
              </div>
              <p class="per-packet">per packet</p>
            </div>
          {% endfor %}
        {% else %}
          {% assign card_bg = selected_product.metafields.custom.color_3 | default: section_bg %}
          {% assign card_text = selected_product.metafields.custom.color_1 | default: accent_color %}
          {% if selected_product.handle == 'mango-margarita' %}
            {% assign card_text = '#CCAA00' %}
          {% endif %}
          {% if selected_product.metafields.custom.illustration_b %}
            {% assign flavor_icon = selected_product.metafields.custom.illustration_b | file_url %}
          {% else %}
            {% assign flavor_icon = 'https://cdn.shopify.com/s/files/1/2340/1623/files/lime2.svg?v=1738881712' %}
          {% endif %}

          <div class="espresso-nutrition__panel active">
            <p class="eyebrow">{{ section.settings.subheading | default: "What's in CraftMix" }}</p>
            <h2 class="heading">{{ section.settings.heading | default: "Quality Ingredients, Amazing Taste" }}</h2>
            {% assign body_copy = section.settings.body %}
            {% if body_copy == blank %}
              {% assign body_copy = "<p>Craftmix never uses artificial flavors, sweeteners, or preservatives and each flavor is made from natural powders.</p>" %}
            {% endif %}
            <div class="body-text rte">
              {{ body_copy }}
            </div>

            <div class="flavor-bar" data-flavor="{{ selected_product.metafields.custom.flavor_measure.value }}">
              <div class="flavor-range">
                <div class="flavor-range-fill"></div>
                <img src="{{ flavor_icon }}" alt="Flavor icon" class="flavor-icon" width="40" height="32" loading="lazy">
              </div>
              <div class="flavor-labels">
                <span class="sweet-label">Sweet</span>
                <span class="flavor-label">Flavor</span>
                <span class="sour-label">{{ selected_product.metafields.custom.flavor_type.value | default: 'Rich' }}</span>
              </div>
            </div>

            <div class="metrics">
              <div class="metric-card" style="border-color: {{ card_text }}; color: {{ card_text }};">
                <div class="metric-value">{{ selected_product.metafields.custom.calorie_total.value | default: 25 }}</div>
                <div class="metric-label">Calories</div>
              </div>
              {% unless hide_caffeine_card %}
                <div class="metric-card" style="border-color: {{ card_text }}; color: {{ card_text }};">
                  <div class="metric-value">
                    {{ selected_product.metafields.custom.caffeine_mg.value | default: selected_product.metafields.custom.caffeine_mass.value | default: 30 }}
                    <span class="metric-unit">mg</span>
                  </div>
                  <div class="metric-label">Caffeine</div>
                </div>
              {% endunless %}
              <div class="metric-card" style="border-color: {{ card_text }}; color: {{ card_text }};">
                <div class="metric-value">{{ selected_product.metafields.custom.sugar_mass.value | default: 5 }}<span class="metric-unit">g</span></div>
                <div class="metric-label">Sugar</div>
              </div>
            </div>
            <p class="per-packet">per packet</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% else %}
<section class="espresso-nutrition-section" data-section-id="{{ section.id }}">
  <div class="espresso-nutrition__inner">
    <p class="no-product-note">Select a product in the section settings to show nutrition details.</p>
  </div>
</section>
{% endif %}
   
  <div class="section-wave-container" style="background: {{ section_bg }};">
    {% if request.path contains 'espresso-martini' %}
      <lottie-player class="section-wave" src="{{ section.settings.espresso_martini_wave_lottie_file | default: 'wave-divider-right-to-left-2400px-brown.json' | asset_url }}" background="{{ section_bg }}" speed="1" loop autoplay></lottie-player>
    {% else %}
      <lottie-player class="section-wave" src="{{ section.settings.default_wave_lottie_file | default: 'wave-divider-right-to-left-2400px-fee9e8.json' | asset_url }}" background="{{ section_bg }}" speed="1" loop autoplay></lottie-player>
    {% endif %}
  </div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('.espresso-nutrition-section[data-section-id="{{ section.id }}"]');
    if (!section) return;

    // Variety pack toggles
    const selectors = section.querySelectorAll('.nutrition-card-selector');
    const panels = section.querySelectorAll('.espresso-nutrition__panel');

    function updateHeroImageFromSelector(btn) {
      if (!btn) return;
      const nextImageSrc = btn.getAttribute('data-image-src');
      const nextImageAlt = btn.getAttribute('data-image-alt') || '';
      const heroImage = section.querySelector('.espresso-nutrition__main-image');
      if (heroImage && nextImageSrc) {
        heroImage.src = nextImageSrc;
        heroImage.srcset = '';
        heroImage.sizes = '';
        heroImage.alt = nextImageAlt;
      }
    }

    selectors.forEach(btn => {
      btn.addEventListener('click', () => {
        selectors.forEach(b => b.classList.remove('selected'));
        panels.forEach(p => p.classList.remove('active'));

        btn.classList.add('selected');
        const selectorClass = Array.from(btn.classList).find(c => c.startsWith('selector-'));
        if (!selectorClass) return;
        const slug = selectorClass.replace('selector-', '');
        const target = section.querySelector('.panel-' + slug);
        if (target) target.classList.add('active');

        updateHeroImageFromSelector(btn);
      });
    });

    const selectedSelector = section.querySelector('.nutrition-card-selector.selected');
    if (selectedSelector) {
      updateHeroImageFromSelector(selectedSelector);
    }

    // Flavor bars
    const flavorBars = section.querySelectorAll('.flavor-bar');
    flavorBars.forEach(bar => {
      let pct = parseInt(bar.dataset.flavor, 10);
      if (isNaN(pct)) pct = 0;
      pct = Math.max(0, Math.min(100, pct));
      const fill = bar.querySelector('.flavor-range-fill');
      const icon = bar.querySelector('.flavor-icon');
      if (fill) fill.style.width = pct + '%';
      if (icon) icon.style.left = pct + '%';
    });
  });
</script>

{% schema %}
{
  "name": "Espresso Nutrition",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Select the product whose metafields populate this section."
    },
    {
      "type": "text",
      "id": "espresso_martini_wave_lottie_file",
      "label": "Espresso martini wave lottie asset filename",
      "default": "wave-divider-right-to-left-2400px-brown.json",
      "info": "Enter a theme asset filename, including .json."
    },
    {
      "type": "text",
      "id": "default_wave_lottie_file",
      "label": "Default wave lottie asset filename",
      "default": "wave-divider-right-to-left-2400px-fee9e8.json",
      "info": "Enter a theme asset filename, including .json."
