{% liquid
  assign selected_product = all_products[section.settings.product]
  if selected_product == blank and product
    assign selected_product = product
  endif

  assign section_bg = section.settings.background_color
  if section_bg == blank and selected_product and selected_product.metafields.custom.color_3 != blank
    assign section_bg = selected_product.metafields.custom.color_3
  endif
  if section_bg == blank
    assign section_bg = '#FFF9F5'
  endif

  assign accent_color = '#002657'
  if selected_product and selected_product.metafields.custom.color_1 != blank
    assign accent_color = selected_product.metafields.custom.color_1
  endif
%}

{% style %}
.espresso-nutrition-section {
  background: {{ section_bg }};
  position: relative;
     padding: 48px 48px 20px 0;
    overflow: hidden;
   
     margin-bottom: -1px;
}

.espresso-nutrition-section .espresso-nutrition__decor--right {
  position: absolute;
  right: 0;
  top: 0;
  max-width:246px;
  height: auto;
  z-index: 1;
  pointer-events: none;
}

.espresso-nutrition-section .espresso-nutrition__inner {
  width: 100%;
  margin: 0 auto;
  position: relative;
}

.espresso-nutrition-section .espresso-nutrition__grid {
  display: grid;
  grid-template-columns: 500px 1fr;
  align-items: center;
  gap: 10px;
}

.espresso-nutrition-section .espresso-nutrition__image img {
  width: 100%;
  height: auto;
  display: block;

  margin: 0 auto;
}

.espresso-nutrition-section .espresso-nutrition__content {
  text-align: center;
      max-width: 690px;
}

.espresso-nutrition-section .eyebrow {
   font-family:'Goldplay';
font-weight: 600;
color:#002657;
font-size: 18px;

line-height: 17px;
letter-spacing: 0.43px;
text-align: center;

text-transform: uppercase;

  margin-bottom: 39px;
}

.espresso-nutrition-section .heading {
  font-family: 'Hornbill', sans-serif;

font-weight: 700;
color:#002657;
font-size: 39.8px;
max-width:451px;
line-height: 46px;
letter-spacing: -1.05px;
text-align: center;
    margin: 0 auto 39px;
}

.espresso-nutrition-section .body-text {
  font-family: 'Goldplay', sans-serif;

font-weight: 500;

font-size: 18px;
max-width:451px;
line-height: 24px;
letter-spacing: -0.11px;
text-align: center;
margin: 0 auto 52px;

}
.espresso-nutrition-section .body-text * {

  margin:0!important;
}
.espresso-nutrition-section .flavor-bar {
  max-width: 451px;
  margin: 0 auto;
}

.espresso-nutrition-section .flavor-range {
  width: 100%;
  height: 10px;
  background-color: rgba(0, 38, 87, 0.16);
