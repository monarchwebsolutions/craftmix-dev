.espresso-nutrition-section .metric-value {
  font-family: 'Goldplay', sans-serif;
font-weight: 600;

font-size: 70px;
display:flex;
line-height: 68px;
letter-spacing: 1.67px;
text-align: center;

text-transform: uppercase;

}

.espresso-nutrition-section .metric-unit {


font-weight: 600;

font-size: 46px;

line-height: 68px;
letter-spacing: 1.67px;


text-transform: uppercase;

  text-transform:lowercase;
}

.espresso-nutrition-section .metric-label {
  font-family: 'Hornbill', sans-serif;
font-weight: 700;
font-style: Bold;
font-size: 25.8px;

line-height: 30px;
letter-spacing: -0.68px;
text-align: center;


}

.espresso-nutrition-section .per-packet {
