}

.espresso-nutrition-section .flavor-range-fill {
  height: 12px;
  background-color: #002657;
  border-radius: 6px;
  width: 0;
}

.espresso-nutrition-section .flavor-icon {
  position: absolute;
  top: 50%;
  left: 0;
  transform: translate(-50%, -50%);
  width: 42px;
  height: auto;
}

.espresso-nutrition-section .flavor-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 14px;
  font-family: 'Goldplay', sans-serif;
  
  color: #002657;
}

.espresso-nutrition-section .flavor-label {

font-weight: 600;

font-size: 14px;
  color: #002657;
line-height: 18px;
letter-spacing: 0.3px;
text-align: center;

text-transform: uppercase;
}

.espresso-nutrition-section .sweet-label,
.espresso-nutrition-section .sour-label {
  font-family: 'Goldplay', sans-serif;
font-weight: 600;

font-size: 25px;

line-height: 16px;
letter-spacing: -0.16px;
text-align: center;


}

.espresso-nutrition-section .metrics {
  display: flex;
 flex-wrap: wrap;
    align-items: center;
    justify-content: center;
  gap: 24px;
  margin-top: 65px;
}

.espresso-nutrition-section .metric-card {
  border: 2px solid {{ accent_color }};
  border-radius: 30px;
  padding: 24px;
  background: #F0F0F0;
 max-height:170px;
 width:214px;
    display: flex;
