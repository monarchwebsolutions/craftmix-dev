  font-weight:600;
  font-size:16px;
  text-transform:uppercase;
  text-align:center;
}

.variety-lander-benefits-container{
  display:flex;
  justify-content:space-between;
  gap:4px;
  padding-top:16px;
}
.variety-lander-benefit{
