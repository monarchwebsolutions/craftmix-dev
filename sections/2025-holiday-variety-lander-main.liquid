{% schema %}
{
  "name": "Holiday Variety Main",
  "settings": [
    {
      "type": "product",
      "id": "main_product",
      "label": "Main Product"
    },
    {
      "type": "number",
      "id": "price_per_drink",
      "label": "Price Per Drink"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Holiday Variety Main"
    }
  ]
}
{% endschema %}

{% style %}
 *,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
html,
body {
  /* overflow-x: hidden; */
  overflow-y: auto; 
  overflow:visible !important;
}
.main-container{
  overflow:visible !important;
}

a {
  text-decoration: none;
}

img {
  max-width: 100%;
}

section.landing-page-main {
  background-color: #ddf7f7;
  position: relative;
}

/* Hide carousel by default (desktop/tablet) */
.image-carousel-wrapper {
  display: none;
}

.lp-main-wrapper {
  max-width: 1400px;
  padding: 80px 20px;
  margin: 0 auto;
}

.flex-container {
  display: flex;
  flex-direction: row;
  align-items: start;
  justify-content: space-between;
  gap: 74px;
  margin-bottom: 40px;
  position:relative;
}

.flex-item-left {
  width: 100%;
  display: flex;
  max-width: 776px;
  align-items: flex-start;
  align-content: flex-start;
  gap: 12px;
  flex-wrap: wrap;
  position:sticky;
  top:120px;
}

.flex-item-right {
  max-width: 514px;
  width: 100%;
}

.lp_image_carousel_embla__viewport {
  overflow: hidden;
  width: 100%;
}

.lp_image_carousel_embla__container {
  display: flex;
  gap: 12px;
}

.lp_image_carousel_embla__slide {
  flex: 0 0 auto;
  height: auto;
  scroll-snap-align: center;
}
.lp_image_carousel_embla__slide:last-of-type {
  margin-right: 12px;
}
.small-img-container {
  border: 1px solid #002657;
  border-radius: 20px;
  overflow: hidden;
}
  
.lp-carousel-image {
  width: 100%;
  height: auto;
  display: block;
}

.img-lg-container {
  width: 100%;
  max-width: 774px;
  position: relative;
}


.img-wrapper-lg img {
  width: 100%;
  height: auto;
  display: block;
}

.imgs-sm-container {
  max-width: 776px;
  width: 100%;
  display: flex;
  gap: 6px;
  justify-content: space-between;
  cursor:pointer;
}

.img-wrapper-sm img {
  width: 100%;
  height: auto;
  display: block;
}

.img-wrapper-lg,
.img-wrapper-sm {
  position: relative;
  border: 2px solid #002657;
  border-radius: 26px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-wrapper-sm {
  width: calc(50% - 8.9195px);
  border: 2px solid #000; 
  border-radius: 16px;
  overflow: hidden;
}

.img-wrapper-lg img,
.img-wrapper-sm img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.lp-main-prev-btn,
.lp-main-next-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  z-index: 10;
  background-color: transparent;
  width: 62px;
  height: 62px;
}

.lp-main-prev-btn{
  left: 24px;
}

.lp-main-next-btn {
  right: 24px;
}

.lp-main-prev-btn img {
  transform: scaleX(-1);
}



.reviews {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  padding-bottom:12px;
}

.reviews .review-stars {
  height: 22px;
  margin-right:6px;
  width:auto;
}
.reviews .review-text {
  color: #002657;
  font-size: 16px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 30.8px;
  font-weight:normal;
}
.reviews .review-text-b{
  font-weight:600;
}
.review-text-separator{
  padding: 0 12px;
}
h1.heading-text {
  color: #002657;
  font-size: 36px;
  font-family: Hornbill;
  font-weight: 900;
  line-height: 1.2;
  margin-bottom: 24px;
}

p.paragraph-text {
  color: #002657;
  font-size: 24px;
  font-family: Goldplay;
  font-weight: 500;
  line-height: 33.6px;
  margin-bottom: 24px;
}

.buy-option-container {
  display: flex;
  flex-direction: column; 
  border-radius: 18px;
  border: 2px solid rgba(0, 38, 87, 0.1);
  background: rgba(255, 255, 255, 0.7);
  margin-bottom: 24px;
  cursor: pointer;
  overflow: hidden;
}

.buy-option-row {
  display: flex;
  flex-direction: row; /* row layout for the main content */
  align-items: flex-start;
  justify-content: space-between;
  padding: 16px 20px;
}
  
.buy-option-container-lg {
  border-radius: 18px;
  margin-bottom: 8px;
  border: 2px solid rgba(0, 38, 87, 0.1);
  overflow: hidden;
}

.buy-option-container-lg-product {
  display: flex;
  padding: 16px 20px;
  flex-direction: row;
  align-items: start;
  justify-content: space-between;
  background: rgba(255, 255, 255, 1);
  gap:2px;
}

.sale-bar {
  background-color: #FFE9DA;
  padding: 4px 10px;
  text-align: center;
  border-bottom: 2px solid rgba(0, 38, 87, 0.1)
}

.sale-bar-text {
  color: #002657;
  font-size: 24px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 28.8px;
}

.buy-option-container.selected,
.buy-option-container-lg.selected {
  border: 2px solid rgba(0, 38, 87, 1); 
}

.buy-option-container.selected .sale-bar,
.buy-option-container-lg.selected .sale-bar {
  border-bottom: 2px solid rgba(0, 38, 87, 1);
}

.buy-option-container-lg-footer {
  background: rgba(255, 255, 255, 1);
  padding: 0px 20px 16px 20px;
}

.club-benifits-items {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.club-benifits img {
  margin-right: 5px;
}

.club-benifits-items img {
  height: 10px;
  width: 17px;
}
.club-benifits span {
  color: #000;
  font-size: 20px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 28px;
}
.club-benifits-top,
.club-benifits-bottom {
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  gap: 24px;
}

.buy-option-info .product-name {
  color: #002657;
  font-size: 30px;
  font-family: Hornbill;
  font-weight: 800;
  line-height: 36px;
  padding-right:12px;
}
.buy-option-info .product-contents {
  color: #fe6b00;
  font-size: 20px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 28px;
}

.buy-option-pricing {
  display: flex;
  flex-direction: column;
}

.buy-option-pricing-comparison {
  display: flex;
  flex-direction: row;
  gap: 3px;
}

.buy-option-pricing-comparison-before {
  color: #002657;
  font-size: 26px;
  font-family: Goldplay;
  font-weight: 600;
  text-decoration: line-through;
  line-height: 31.2px;
  opacity: 0.4;
}
.buy-option-pricing-comparison-after {
  color: #002657;
  font-size: 26px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 31.2px;
}

.buy-option-pricing-per-drink-text {
  color: #002657;
  font-size: 20px;
  font-family: Goldplay;
  font-weight: 600;
  text-transform: uppercase;
  line-height: 28px;
  text-align: right;
  opacity: 0.4;
}

input[type="radio"] {
  appearance: none;
  -webkit-appearance: none;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 2px solid #002657;
  display: inline-block;
  position: relative;
  background: white;
  cursor: pointer;
}

input[type="radio"]::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12px; 
  height: 12px;
  background-color: #002657;
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.2s ease;
}

input[type="radio"]:checked::after {
  opacity: 1;
}

.buy-button {
  font-family: 'Goldplay';
  font-weight: 600;
  font-size: 22px;
  line-height: 140%;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 16px 12px;
  gap: 3px;
  width: 100%;
  height: 69px;
  background: #fe6b00;
  color: #fff;
  border: 2px solid #000000;
  box-shadow: 4px 4px 0px #000000;
  transition: box-shadow 0.4s ease;
  border-radius: 100px;
  margin: 0 auto 24px;
  text-transform: uppercase;
  cursor: pointer;
  flex: none;
  order: 1;
  flex-grow: 0;
}

.buy-button:hover {
  box-shadow: none;
}

.flavor-container {
  margin: 24px 0px;
  padding: 16px 0px;
  max-width: 100%;
}

h2.flavor-heading {
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay' !important;
  font-size: 22px;
  font-weight: 600 !important;
  letter-spacing: 0.3px;
  text-align: left;
  line-height: 18px;
  margin-bottom: 10px;
}
/* FLAVOR GRID SMALL */
.flavor-card-grid-single-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
  justify-content: center;
  place-items: center;
  gap: 16px;
}



.flavor-card-single {
  border-radius: 12px;
  overflow: hidden;
  width:25%;
  max-width:25%;
  flex: 1 0 23%;
}

.flavor-card-single-image-container {
  max-width: 118px;
  max-height: 124px;
  background-color: #fff;
  border-radius: 12px;
  border: 1.5px solid rgba(0, 38, 87, 0.08);
  padding: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flavor-card-single-image {
  width: 100%;
  height: auto;
}

.flavor-card-single-heading {
  font-family: 'Goldplay';
  font-size: 15px;
  font-weight: 600;
  text-align: center;
  line-height: 16px;
  padding-top: 10px;
}
/* END FLAVOR GRID SMALL */

/* FLAVOR GRID LARGE */
.flavor-card-grid-double-row {
  display: grid;
   grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
  justify-content: center;
  place-items: center;
  gap: 10px;
}

.flavor-card-double {
  width: 90px;
  height: 130px;
  border-radius: 12px;
  overflow: hidden;
}

.flavor-card-double-image-container {
  width: 90px;
  height: 90px;
  background-color: #fff;
  border-radius: 12px;
  border: 1.5px solid rgba(0, 38, 87, 0.08);
  padding: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flavor-card-double-image {
  width: 100%;
  height: auto;
}

.flavor-card-double-heading {
  font-family: 'Goldplay';
  font-size: 12px;
  font-weight: 600;
  text-align: center;
  line-height: 16px;
  padding-top: 10px;
}
/* END FLAVOR GRID LARGE */

/* FOR GRID DISPLAY WITH JS */
.flavor-card-grid-single-row,
.flavor-card-grid-double-row {
  display: none;
}

.flavor-card-grid-single-row.active,
.flavor-card-grid-double-row.active {
  display: grid;
}  
/* END GRID DISPLAY WITH JS */  

/* MAIN PRODUCT REVIEWS */

.main-product-reviews-container{
  margin-bottom:32px;
}
.main-product-reviews-container h2{
  font-family: 'Goldplay' !important;
  font-size: 22px;
  font-weight: 600 !important;
  letter-spacing: 0.3px;
  text-align: left;
  margin-bottom: 16px;
}
.main-product-review-stars{
  width:100px;
  height:18px;
}
.main-product-review{
  background: rgba(255, 255, 255, 0.6);
  padding: 16px;
  border-radius: 12px;
  margin-bottom:12px;
}
.main-product-review-name{
  font-size:15px;
  font-family:Goldplay;
  font-weight:500;
  line-height:1;
}

.main-product-review-headline{
  font-size: 18px;
  font-family:Hornbill;
  font-weight:600;
  line-height:1;
}

.main-product-review-content{
  font-family:Goldplay;
  font-weight:500;
  font-style: italic;
}
.main-product-review-top{
  display:flex;
  margin-bottom:14px;
  align-items:center;
  gap:16px;
}
@media screen and (max-width: 529px){
  .main-product-reviews-container h2{
    font-size:18px;
  }
}
@media screen and (max-width: 399px){
  .main-product-review-top{
    gap:12px;
  }
  .main-product-review-stars{
    width:90px;
    height:16px;
  }
  .main-product-review-headline{
    font-size: 17px;
  }
  .main-product-review-name{
    font-size:14px;
  }
}

/* FAQs */

.faq-container {
  width: 100%;
}

.faq-question-body {
  margin-bottom: 24px;
}

.faq-answer {
  display: none;
  margin-top: 8px;
}

.faq-question h6 {
  color: #002657;
  font-size: 24px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 28.8px;
}

.faq-answer p {
  color: #002657;
  font-size: 20px;
  font-family: Goldplay;
  font-weight: 500;
  line-height: 28px;
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
}

.faq-icon::before {
  content: '+';
  font-size: 18px;
  transition: transform 0.2s ease;
}

/* when open */
.faq-question.open + .faq-answer {
  display: block;
}

.faq-question.open .faq-icon::before {
  content: '−'; 
}

.landing-page-heading-section-marquee {
  position: absolute;
   top: auto !important;
  bottom: -50% !important;
  z-index:1;
  pointer-events: none;
  height:revert-layer !important;
}

/* Hide carousel by default (desktop/tablet) */
.image-carousel-wrapper {
  display: none;
}
.buy-options-wrapper [class*="buy-option-container"],
.buy-options-wrapper .buy-option-row{
  background-color:#f5fdfd;
}
.buy-options-wrapper .selected [class*="buy-option-container"],
.buy-options-wrapper .selected .buy-option-row{
  background-color:white !important;
}

/* Variety Lander CSS */

