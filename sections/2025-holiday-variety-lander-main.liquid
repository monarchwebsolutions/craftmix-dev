@media (max-width: 1040px) {
  .flex-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom:40px
  }
  .flex-item-left {
    position:relative;
    top:unset;
  }
}
@media (max-width: 829px) {
  .flex-item-right,
  .flex-item-left {
