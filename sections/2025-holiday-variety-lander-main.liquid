{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    // Mobile image carousel (Embla)
    const carouselRoot = document.querySelector('.image-carousel-wrapper');
    if (!carouselRoot) return;

    const viewport = carouselRoot.querySelector('.lp_image_carousel_embla__viewport');
    if (viewport && typeof EmblaCarousel === 'function') {
      EmblaCarousel(viewport, {
        dragFree: true,
        loop: true
      });
    }

    // --- Interactive Large Image Rotator Only ---
    const lgImg   = document.querySelector('.img-wrapper-lg img');
    const nextBtn = document.querySelector('.img-lg-container .lp-main-next-btn');
    const prevBtn = document.querySelector('.img-lg-container .lp-main-prev-btn');
    const thumbs  = Array.from(document.querySelectorAll('.img-wrapper-sm img'));

    if (lgImg) {
      // Build a unified slides array: first the main image, then all thumbs
      const slides = [
        {
          src: lgImg.getAttribute('src'),
          alt: lgImg.getAttribute('alt') || ''
        },
        ...thumbs.map(img => ({
          src: img.getAttribute('src'),
          alt: img.getAttribute('alt') || ''
        }))
      ];

      let currentIndex = 0; // start on the main image

      const updateLgImage = () => {
        const slide = slides[currentIndex];
        lgImg.src = slide.src;
        lgImg.alt = slide.alt;
      };

      const rotateForward = () => {
        currentIndex = (currentIndex + 1) % slides.length;
        updateLgImage();
      };

      const rotateBackward = () => {
        currentIndex = (currentIndex - 1 + slides.length) % slides.length;
        updateLgImage();
      };

      // Main image click
      lgImg.addEventListener('click', rotateForward);

      // Arrows (click only as before)
      if (nextBtn) nextBtn.addEventListener('click', rotateForward);
      if (prevBtn) prevBtn.addEventListener('click', rotateBackward);

      // Thumbs: add tabindex + click + keydown
      thumbs.forEach((thumb, index) => {
        thumb.style.cursor = 'pointer';
        thumb.setAttribute('tabindex', '0');

        const activateThumb = () => {
          // +1 because slides[0] is the original large image
          currentIndex = index + 1;
          updateLgImage();
        };

        thumb.addEventListener('click', activateThumb);

        thumb.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activateThumb();
          }
        });
      });

      // --- Mobile swipe on main image (max-width: 529px) ---
      if (window.matchMedia('(max-width: 529px)').matches) {
        let touchStartX = 0;
        const minSwipeDistance = 40; // px, tweak if needed

        lgImg.addEventListener(
          'touchstart',
          (e) => {
            touchStartX = e.touches[0].clientX;
          },
          { passive: true }
        );

        lgImg.addEventListener(
          'touchend',
          (e) => {
            const touchEndX = e.changedTouches[0].clientX;
            const distance = touchEndX - touchStartX;

            // Ignore tiny swipes / taps
            if (Math.abs(distance) < minSwipeDistance) return;

            if (distance > 0) {
              // swipe left → right = next image
              rotateBackward();
            } else {
              // swipe right → left = previous image
              rotateForward();
            }
          },
          { passive: true }
        );
      }
    }

    // FAQ toggle: add tabindex + click + keydown
    document.querySelectorAll('.faq-question').forEach((question) => {
      question.setAttribute('tabindex', '0');

      const toggleFAQ = () => {
        question.classList.toggle('open');
      };

      question.addEventListener('click', toggleFAQ);

      question.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleFAQ();
        }
      });
    });
  });
{% endjavascript %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const form = document.querySelector('form[action="/cart/add"]');
  if (!form) return;

  form.addEventListener('submit', e => {
    e.preventDefault();

    const fd = new FormData(form);

    fetch('/cart/add.js', {
      method: 'POST',
      body: fd
    })
    .then(res => {
      if (!res.ok) throw new Error('Add to cart failed');
      return res.json();
    })
    .then(() => {
      window.location.href = '/checkout';
    })
    .catch(err => console.error(err));
  });
});
</script>

