{% style %}
 *,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

ul {
  list-style: none;
}

a {
  text-decoration: none;
}

img {
  max-width: 100%;
}
.ingredients-row td{
    font-weight:500 !important;
}
.custom-nutrition-section {
  padding-top: 60px;
  padding-bottom: 170px;
  background-color: #ead1fa;
  position: relative;
}

.custom-nutrition-section-container {
  margin: 0 auto;
  padding: 0 45px;
  max-width: 1400px;
  position: relative; 
}

.top-section {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
/* For variety pack Grid START*/
.variety-pack-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr); 
  gap: 2rem;
  margin-top: 2rem;
}

@media (max-width: 1156px) {
  .variety-pack-grid {
    grid-template-columns: 1fr;
  }
}

.variety-pack-item {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  padding: 1.5rem 0px;
}


  
/* For variety pack Grid END*/

.whats-in-craftmix {
  width: 451px;
  min-height: 356px;
  align-self: flex-start;
  margin-left:20px;
  margin-right:12px;
}

.whats-in-craftmix-subheading {
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.43px;
  text-align: left;
  line-height: 17px;
  text-transform: uppercase;
  margin-bottom: 39px;
}
.whats-in-craftmix-heading {
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 40px;
  font-weight: 700;
  letter-spacing: -1.05px;
  text-align: left;
  line-height: 46px;
  margin-bottom: 39px;
}
.whats-in-craftmix-paragraph {
  opacity: 0.9;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 500;
  letter-spacing: -0.11px;
  text-align: left;
  line-height: 24px;
  margin-bottom: 43px;
}

/* For variety pack Heading START*/
.variety-pack-heading {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 2rem;
}

.variety-pack-subheading {
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.43px;
  text-align: center;
  line-height: 17px;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.variety-pack-title {
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 64px;
  font-weight: 700;
  letter-spacing: -1.68px;
  text-align: center;
  line-height: 54px;
  margin-bottom: 40px;
}

.variety-pack-description {
  opacity: 0.9;
  color: #002657;
  font-family: 'Goldplay';
  font-size: 1.125rem;
  font-weight: 500;
  letter-spacing: -0.11px;
  text-align: center;
  line-height: 1.5rem;
}
/* For variety pack Heading END*/
 
.flavor-bar {
  max-width: 451px;
  height: 64px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.variety-pack-flavor-bar {
  width: 100%;
  margin: 0 auto;
  margin-top: 25px;
}

.flavor-range {
  width: 100%;
  height: 12px;
  background-color: #ccc;
  border-radius: 6px;
  overflow: visible;
  position: relative;
}

.flavor-range-fill {
  height: 100%;
  background-color: #002657;
  border-radius: 6px;
  transition: width 0.3s ease;
}

.flavor-icon {
  position: absolute;
  top: 50%;
  right: -22px; /* Half the width of the icon */
  transform: translateY(-50%) translateX(-50%) rotate(0deg);
  width: 40px;
  transition: right 0.3s ease;
}

.flavor-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 15px;
  font-family: 'Goldplay';
  font-size: 14px;
  color: rgba(0, 38, 87, 0.7);
  padding: 0 15px;
}

.change-flavor-list li.active .flavor-card {
  background-color: var(--light-color); 
}

.sweet-label,
.sour-label {
 opacity: 1;
color: rgba(0, 38, 87, 1);
font-family: "Goldplay";
font-size: 25px;
font-weight: 600;
letter-spacing: -0.16px;
text-align: center;
line-height: 16px;
}

.flavor-label {
  opacity: 1;
color: rgba(0, 38, 87, 1);
font-family: "Goldplay";
font-size: 14px;
font-weight: 700;
letter-spacing: 0.3px;
text-align: center;
line-height: 18px;
text-transform: uppercase;
}

/* Nutrition card */
.nutrition-fact-card-container {
  width: 100%;
  max-width: 521px;
  min-height: 356px;
  margin: 0 auto;
}

.top-section.is-variety .nutrition-fact-card-container {
    margin: 0 0 auto;
}

.nutrition-fact-card {
  width: 100%;
  max-width: 521px;
  min-height: 356px;
  margin: 0 auto;
  border-radius: 30px;
  opacity: 1;
}

.nutrition-fact-card {
  position: relative;
  padding-bottom: 30px;
}

.nutrition-fact-card-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding-top: 32px;
  padding-left: 33px;
  padding-right: 27px;
  margin-bottom: 11px;
}

.nutrition-product-title {
  font-family: 'Hornbill', sans-serif;
  font-size: 50px;
  font-weight: 700;
  letter-spacing: -1.32px;
  line-height: 54px;
  max-width: 20rem;
}

.nutrition-calories {
  text-align: right;
}

.cal-num {
  font-family: 'Goldplay', sans-serif;
  font-size: 70px;
  font-weight: 700;
  letter-spacing: 1.67px;
  line-height: 68px;
  text-transform: uppercase;
}

.cal-text {
  font-family: 'Hornbill', sans-serif;
  font-size: 26px;
  font-weight: 700;
  letter-spacing: -0.68px;
  line-height: 30px;
}

.nutrition-table {
  width: 100%;
  border-collapse: collapse;
}

.nutrition-table th,
.nutrition-table td {
  padding: 10px 0;
  font-family: 'Goldplay', sans-serif;
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -0.1px;
  line-height: 20px;
  width: 33.33%;
  text-align: center;
}

.nutrition-table th {
  font-size: 18px;
  font-weight: 600;
  letter-spacing: -0.11px;
  line-height: 22px;
}

.nutrition-table tr:last-child {
  border-bottom: none;
}
.nutrition-table tr:not(.ingredients-row) td:first-child {
  text-align: left;
  font-weight: 600;
   padding-left: 20px;
}
span.sugar-text-sm {
  font-size: 15px;
}
.expand-btn-wrapper {
  position: absolute;
  bottom: -25px;
  left: 0;
  right: 0;
  text-align: center;
}

.expand-btn {
  display: inline-block;
  opacity: 1;
  color: rgba(255, 255, 255, 1);
  font-family: 'Goldplay', sans-serif;
  font-size: 20px;
