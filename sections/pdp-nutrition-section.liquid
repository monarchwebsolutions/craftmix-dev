<div class="custom-nutrition-section">
  <img src="{{ 'tropicalleaf.svg' | asset_url }}" class="bg-nutrition-fruit-top tropical-leaf-bg" width="268" height="289" alt="Tropical Leaf Illustration" loading="lazy">
   <img src="{{ 'tropicalleaf.svg' | asset_url }}" class="background-fruit-nutrition-lower bg-tropical-leaf" width="268" height="289" alt="Tropical Leaf Illustration" loading="lazy">
   <img src="{{ 'mint-light.svg' | asset_url }}"  class="background-fruit-nutrition-lower bg-mint-leaf" width="294" height="350" alt="Mint Leaf Illustration" loading="lazy">
  <div class="custom-nutrition-section-container">

       {% assign is_variety_pack = false %}
      {% if product.tags contains 'variety-pack' %}
        {% assign is_variety_pack = true %}
      {% endif %}
     
      <div>
        {% if is_variety_pack %}
          <!-- This is a VARIETY PACK -->
          <div class="variety-pack-heading">
            <h4 class="variety-pack-subheading">What's in CraftMix</h4>
            <h3 class="variety-pack-title">Quality Ingredients, Amazing Taste</h3>
            <p class="variety-pack-description">
              Craftmix never uses artificial flavors, sweeteners, or preservatives and each flavor is made from real-fruit powders.
            </p>
          </div>

          {% assign variety_products = product.metafields.custom.variety_pack_products.value %}

          <div class="variety-pack-grid">
            {% for p in variety_products %}
              <div class="variety-pack-item">
                {% assign nutrition_card_text = p.metafields.custom.color_1 | default: '#000000' %}
                {% assign nutrition_card_btn = p.metafields.custom.color_1 | default: '#000000' %}
                {% assign nutrition_card_bg = p.metafields.custom.color_3 | default: '#ffffff' %}
                {% assign flavor_icon = p.metafields.custom.illustration_b %}
               <div class="nutrition-fact-card-container">
                  <div class="nutrition-fact-card card-{{ forloop.index }}" style="border: 1.5px solid {{ nutrition_card_text }}; color: {{ nutrition_card_text }}; background-color: {{ nutrition_card_bg }};">
                    
                    <div class="nutrition-fact-card-header">
                      <div class="nutrition-fact-card-head">
                        <h3 class="nutrition-product-title" style="color: {{ nutrition_card_text }};">{{ p.title | remove_first: '2025 - ' }}</h3>
                        <div class="calories-box">
                          <h4 class="cal-num" style="color: {{ nutrition_card_text }};">{{ p.metafields.custom.calorie_total.value | default: 25 }}</h4>
                          <p class="cal-text" style="color: {{ nutrition_card_text }};">Calories</p>
                        </div>
                      </div>
                    </div>
                
                    <div class="nutrition-fact-card-body">
                      <table class="nutrition-table" style="color: {{ nutrition_card_text }};">
                        <tr>
                          <th><span class="visually-hidden">Blank header</span></th>
                          <th class="table-th">Per 7g Packet</th>
                          <th class="table-th">DV%</th>
                        </tr>
                        <tr>
                          <td>Total Fat</td>
                          <td>{{ p.metafields.custom.total_fat_mass.value | default: 0 }}g</td>
                          <td>{{ p.metafields.custom.total_fat_dv.value | default: 0 }}%</td>
                        </tr>
                        <tr>
                          <td>Sodium</td>
                          <td>{{ p.metafields.custom.sodium_mass.value | default: 22 }}mg</td>
                          <td>{{ p.metafields.custom.table_sodium_dv.value | default: 1 }}%</td>
                        </tr>
                        <tr>
                          <td>Carbohydrate</td>
                          <td>{{ p.metafields.custom.carbs_mass.value | default: 6 }}g</td>
                          <td>{{ p.metafields.custom.carbs_dv.value | default: 2 }}%</td>
                        </tr>
                        <tr class="expandable">
                          <td>Total Sugars <br> <span class="sugar-text-sm">Includes {{ p.metafields.custom.sugar_mass.value | default: 5 }}g <br> Added Sugars</span></td>
                          <td></td>
                          <td>{{ p.metafields.custom.sugar_dv.value | default: 10 }}%</td>
                        </tr>
                        <tr class="expandable">
                          <td>Protein</td>
                          <td>{{ p.metafields.custom.protein_mass.value | default: 0 }}mg</td>
                          <td>{{ p.metafields.custom.protein_dv.value | default: 0 }}%</td>
                        </tr>
                        <tr class="expandable">
                          <td>Potassium</td>
                          <td>{{ p.metafields.custom.potassium_mass.value | default: 11 }}mg</td>
                          <td>{{ p.metafields.custom.potassium_dv.value | default: 0 }}%</td>
                        </tr>
                        <tr class="expandable ingredients-row">
                          <td colspan="3" style="text-align: left; border-bottom: none; padding: 20px">
                            <strong>Ingredients:</strong> {{ p.metafields.custom.ingredients }}
                          </td>
                        </tr>
                      </table>
                
                      <div class="expand-btn-wrapper">
                        <div class="expand-btn" style="background-color: {{ nutrition_card_btn }};">See All Nutrition Facts</div>
                      </div>
                    </div>
                  </div>
                
                  <style>
                    .card-{{ forloop.index }} .nutrition-table th,
                    .card-{{ forloop.index }} .nutrition-table td,
                    .card-{{ forloop.index }} .nutrition-table tr {
                      border-bottom: 1px solid {{ nutrition_card_text }};
                    }
                  </style>
                </div>


                <div class="flavor-bar variety-pack-flavor-bar" data-flavor="{{ p.metafields.custom.flavor_measure.value }}">
                  <div class="flavor-range">
                    <div class="flavor-range-fill" style="background-color: {{ nutrition_card_text }};"></div>
                    <img src="{{ flavor_icon | file_url | default: 'https://cdn.shopify.com/s/files/1/2340/1623/files/lime2.svg?v=1738881712' }}" alt="Flavor Icon" class="flavor-icon" width="40" height="32" loading="lazy">
                  </div>
                  <div class="flavor-labels">
                    <span class="sweet-label">{{ product.metafields.custom.sweet_alt.value | default: 'Sweet' }}</span>
                    <span class="flavor-label">Flavor</span>
                    <span class="sour-label">{{ p.metafields.custom.flavor_type.value | default: 'Sour' }}</span>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
         
        {% else %}
          <!-- This is a SINGLE PRODUCT -->
  
            {% assign nutrition_card_bg = product.metafields.custom.color_3 | default: '#ffffff' %}
          {% assign nutrition_card_text = product.metafields.custom.color_1 | default: '#000000' %}
          {% assign nutrition_card_btn = product.metafields.custom.color_1 | default: '#000000' %}
          {% if product.metafields.custom.illustration_b %}
            {% assign flavor_icon = product.metafields.custom.illustration_b | file_url %}
          {% else %}
            {% assign flavor_icon = 'https://cdn.shopify.com/s/files/1/2340/1623/files/lime2.svg?v=1738881712' %}
          {% endif %}
      
          <div class="top-section">
            <img src="{{ 'blueberry.svg' | asset_url }}" class="bg-nutrition-fruit blueberry-bg" alt="Blueberry Illustration" width="114" height="118" loading="lazy">
      
            <div class="whats-in-craftmix">
              <h4 class="whats-in-craftmix-subheading">What's in CraftMix</h4>
              <h3 class="whats-in-craftmix-heading">Quality Ingredients, Amazing Taste</h3>
              <p class="whats-in-craftmix-paragraph">Craftmix never uses artificial flavors, sweeteners, or preservatives and each flavor is made from real-fruit powders.</p>
      
              <div class="flavor-bar" data-flavor="{{ product.metafields.custom.flavor_measure.value }}">
                <div class="flavor-range">
                  <div class="flavor-range-fill"></div>
                  <img src="{{ flavor_icon }}" width="40" height="32" alt="Flavor Icon" class="flavor-icon" loading="lazy">
                </div>
                <div class="flavor-labels">
                  <span class="sweet-label">{{ product.metafields.custom.sweet_alt.value | default: 'Sweet' }}</span>
                  <span class="flavor-label">Flavor</span>
                  <span class="sour-label">{{ product.metafields.custom.flavor_type.value | default: 'Sour' }}</span>
                </div>
              </div>
            </div>
      
            <div class="nutrition-fact-card-container">
              <div class="nutrition-fact-card card-single" style=" border: 1.5px solid {{ nutrition_card_text }};  color: {{ nutrition_card_text }}; background-color: {{ nutrition_card_bg }};">
                <div class="nutrition-fact-card-header">
                  <div class="nutrition-fact-card-head">
                    <h3 class="nutrition-product-title" style="color: {{ nutrition_card_text }};">{{ product.title | remove_first: '2025 - ' }}</h3>
                    <div class="calories-box">
                      <h4 class="cal-num" style="color: {{ nutrition_card_text }};">{{ product.metafields.custom.calorie_total.value | default: 25 }}</h4>
                      <p class="cal-text" style="color: {{ nutrition_card_text }};">Calories</p>
                    </div>
                  </div>
                </div>
      
                <div class="nutrition-fact-card-body">
                  <table class="nutrition-table" style=" color: {{ nutrition_card_text }};">
                    <tr>
                      <th><span class="visually-hidden">Blank header</span></th>
                      <th class="table-th">Per 7g Packet</th>
                      <th class="table-th">DV%</th>
                    </tr>
                    <tr>
                      <td>Total Fat</td>
                      <td>{{ product.metafields.custom.total_fat_mass.value | default: 0 }}g</td>
                      <td>{{ product.metafields.custom.total_fat_dv.value | default: 0 }}%</td>
                    </tr>
                    <tr>
                      <td>Sodium</td>
                      <td>{{ product.metafields.custom.sodium_mass.value | default: 22 }}mg</td>
                      <td>{{ product.metafields.custom.table_sodium_dv.value | default: 1 }}%</td>
                    </tr>
                    <tr>
                      <td>Carbohydrate</td>
                      <td>{{ product.metafields.custom.carbs_mass.value | default: 6 }}g</td>
                      <td>{{ product.metafields.custom.carbs_dv.value | default: 2 }}%</td>
                    </tr>
                    <tr class="expandable">
                      <td>Total Sugars <br> <span class="sugar-text-sm">Includes {{ product.metafields.custom.sugar_mass.value | default: 5 }}g <br> Added Sugars</span></td>
                      <td></td>
                      <td>{{ product.metafields.custom.sugar_dv.value | default: 10 }}%</td>
                    </tr>
                    <tr class="expandable">
                      <td>Protein</td>
                      <td>{{ product.metafields.custom.protein_mass.value | default: 0 }}mg</td>
                      <td>{{ product.metafields.custom.protein_dv.value | default: 0 }}%</td>
                    </tr>
                    <tr class="expandable">
                      <td>Potassium</td>
                      <td>{{ product.metafields.custom.potassium_mass.value | default: 11 }}mg</td>
                      <td>{{ product.metafields.custom.potassium_dv.value | default: 0 }}%</td>
                    </tr>
                    <tr class="expandable ingredients-row">
                      <td colspan="3" style="text-align: left; border-bottom: none; padding: 20px">
                        <strong>Ingredients:</strong> {{ product.metafields.custom.ingredients }}
                      </td>
                    </tr>
                  </table>
                  <div class="expand-btn-wrapper">
                    <div class="expand-btn" style="background-color: {{ nutrition_card_btn }};">See All Nutrition Facts</div>
                  </div>
                </div>
              </div>
              <style>
                .card-single .nutrition-table th,
                .card-single .nutrition-table td,
                .card-single .nutrition-table tr {
                  border-bottom: 1px solid {{ nutrition_card_text }};
                }
              </style>
            </div>
      
          </div>
        {% endif %}
      </div>



    
    <div class="lower-section" >
     
  
      <h4 class="lower-section-subheading">how we compare</h4>
      <h2 class="lower-section-heading">Why Craftmix</h2>
      <div class="main-why-craftmix-card">
        <img src="{{ 'strawberry.svg' | asset_url }}" width="156" height="143" alt="Strawberry Illustration" class="background-fruit-nutrition-lower bg-strawberry" loading="lazy">
        <img src="{{ 'grapefruit.svg' | asset_url }}" width="230" height="230" alt="Grapefruit Illustration" class="background-fruit-nutrition-lower bg-grapefruit" loading="lazy">
        <div class="main-why-craftmix-card-lg">
          <table class="craftmix-table-lg">
            <thead>
              <tr>
                <th><span class="visually-hidden">Blank header</span></th>
                <th><span class="visually-hidden">Blank header</span></th>
                <th class="right-item table-top-right"><img class="mix-bottle"
                    src="https://cdn.shopify.com/s/files/1/2340/1623/files/bottle-icon.png?v=1739046888" alt="Bottle Illustration"  width="27" height="48" loading="lazy">
