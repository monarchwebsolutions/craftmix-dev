{% schema %}
{
  "name": "Landing Page Reviews",
  "tag": "section",
  "class": "landing-page-reviews",
  "settings": [],
   "blocks": [
    {
      "type": "flavor_card",
      "name": "Flavor Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing Page Reviews",
      "blocks": []
    }
  ]
}
{% endschema %}

<section class="landing-page-reviews">

  <!-- FLAVOR CAROUSEL  (MOBILE)-->
  <div class="flavor-carousel-mobile check-out-each-flavor embla embla--flavors">
    <h2 class="check-out-each-flavor-heading">Check out each flavor!</h2>
    <div class="embla__viewport">
      <div class="embla__container check-out-each-flavor__container">
       
       {% assign flavor_blocks = section.blocks | where: "type", "flavor_card" %}
        {% for block in flavor_blocks limit: 10 %}
          {% assign product = block.settings.product %}
          <div class="embla__slide check-out-each-flavor__slide">
            <div class="craftmix-flavor-list-item-card">
              <div class="craftmix-flavor-list-item-card-img">
                <img src="{{ product.featured_image | img_url: '500x' }}" alt="{{ product.title }}" width="256" height="290" role="presentation" loading="lazy">
              </div>
              <img class="craftmix-flavor-list-item-card-stars" src="{{ 'yellow-stars.png' | asset_url }}" alt="Stars" width="256" height="290" role="presentation" loading="lazy">
              <h6 class="craftmix-flavor-list-item-card-title">{{ product.title | remove: '2025 - ' }}</h6>
            </div>
          </div>
        {% endfor %}
      

      </div>
    </div>
    <a class="check-out-each-flavor-btn" href="#">Shop Craftmix Club Pack</a>
  </div>

  <!-- FLAVOR CAROUSEL (DESKTOP SCROLL) -->
  <div class="flavor-carousel-desktop check-out-each-flavor">
    <h2 class="check-out-each-flavor-heading">Check out each flavor!</h2>
    <div class="flavor-scroll-container">
      
      {% for block in flavor_blocks limit: 10 %}
      {% assign product = block.settings.product %}
      <div class="flavor-scroll-slide">
        <div class="craftmix-flavor-list-item-card">
          <div class="craftmix-flavor-list-item-card-img">
            <img src="{{ product.images.last | img_url: '500x' }}" alt="{{ product.title }}" width="296" height="254" role="presentation" loading="lazy">
          </div>
          <img class="craftmix-flavor-list-item-card-stars" src="{{ 'yellow-stars.png' | asset_url }}" width="110" height="21" alt="Stars" role="presentation" loading="lazy">
          <h6 class="craftmix-flavor-list-item-card-title">{{ product.title | remove: '2025 - ' }}</h6>
        </div>
      </div>
      {% endfor %}
      
    </div>
    <a class="check-out-each-flavor-btn" href="#">Shop Craftmix Club Pack</a>
  </div>


  <!-- REVIEW CAROUSEL (MOBILE - Embla) -->
  <div class="craftmix-lovers embla embla--reviews review-carousel-mobile">
    <h2 class="craftmix-lovers-heading">Join Over 3000+ Craftmix Lovers</h2>
    <div class="embla__viewport">
      <div class="embla__container craftmix-lovers__container">
        
        <div class="embla__slide craftmix-lovers__slide">
          <div class="craftmix-lovers-list-item-card">
            <img class="craftmix-lovers-list-item-card-stars" src="{{ 'yellow-stars.png' | asset_url }}" alt="Starts" width="150" height="29" role="presentation" loading="lazy">
            <p class="craftmix-lovers-list-item-card-text">
              I always have excellent customer service with you. Never any issues. You go above and beyond. Thank you!
            </p>
            <p class="craftmix-lovers-list-item-card-name">- Gina G</p>
          </div>
        </div>

         <div class="embla__slide craftmix-lovers__slide">
          <div class="craftmix-lovers-list-item-card">
            <img class="craftmix-lovers-list-item-card-stars" src="{{ 'yellow-stars.png' | asset_url }}" alt="Starts" width="150" height="29" role="presentation" loading="lazy">
            <p class="craftmix-lovers-list-item-card-text">
              I was very pleased with the taste. Easy to mix. I would recommend to anyone. I plan to order more.
            </p>
            <p class="craftmix-lovers-list-item-card-name">- Cathy J</p>
