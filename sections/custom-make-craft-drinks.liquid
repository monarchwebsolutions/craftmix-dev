<div class="make-craft-drinks-section">
  <div class="craft-drinks-card-container">
    <div class="craft-drinks-card">
      <div class="craft-drinks-card-header">
        <span class="card-subheading">make</span>
        <h3 class="card-title">Craft Drinks</h3>
        <p class="card-paragraph">in under 30 seconds</p>
      </div>
      <div class="craft-drinks-card-list-container">
        <ul class="craft-drinks-card-list">
          <li class="craft-drinks-card-list-item">
            <div class="circle"><span>1</span></div>Pour 4oz water & optionally 1oz liquor
          </li>
          <li class="craft-drinks-card-list-item">
            <div class="circle"><span>2</span></div>Stir in 1 Craftmix packet (30-60s)
          </li>
          <li class="craft-drinks-card-list-item">
            <div class="circle"><span>3</span></div>Serve over a lot of ice and enjoy
          </li>
        </ul>
      </div>

      <div class="craft-drinks-card-cta">
        <a class="craft-drinks-card-cta-btn" href="/collections/flavors-2024">Find your flavor</a>
      </div>
    </div>
  </div>

  <div class="craft-drinks-image-container">
    <img src="https://cdn.shopify.com/s/files/1/2340/1623/files/makecraftdrinks-placeholder.png?v=1738008412">
  </div>

</div>

{% style %}
 
*,
*::after,
*::before {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

a {
  text-decoration: none;
}

ul {
  list-style: none;
}

img {
  max-width: 100%;
}

.make-craft-drinks-section {
  background-color: #fff9f9;
  padding: 100px 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.craft-drinks-card-container,
.craft-drinks-image-container {
  max-width: 50%;
}

.craft-drinks-card-container {
  z-index: 101;
}
.craft-drinks-card {
  background-color: #fff;
  width: 557px;
  height: 656px;
  box-shadow: 10px 10px 20px rgba(0, 0, 0, 0.13);
  border-radius: 30px;
  /* z-index: 100; */
  margin-left: 50px;
}

.craft-drinks-card-header {
  text-align: center;
  padding-top: 74px;
}
.craft-drinks-card .card-subheading {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 700;
  font-style: Bold;
  letter-spacing: 0.43px;
  line-height: 17px;
  text-transform: uppercase;
}
.craft-drinks-card .card-title {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 64px;
  font-weight: 700;
  font-style: Bold;
  letter-spacing: -1.68px;
  text-align: center;
  line-height: 54px;
  margin-top: 20px;
  margin-bottom: 23px;
}
.craft-drinks-card .card-paragraph {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 25px;
  font-weight: 500;
  font-style: Medium;
  letter-spacing: -0.16px;
  text-align: center;
  line-height: 32px;
}

.craft-drinks-card-list-container {
  width: 100%;
  text-align: center;
  margin-top: 60px;
  padding: 0 40px;
}

.craft-drinks-card-list-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  /* justify-content: center; */
  font-size: 20px;
  text-align: left;
  background-color: #fff9f5;
  padding: 8px 10px;
  margin-bottom: 10px;
  border-radius: 33px;
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: "Goldplay";
  font-weight: 600;
  font-style: SemiBold;
  letter-spacing: -0.13px;
  text-align: left;
  line-height: 20px;
}

.circle {
  width: 40px;
  height: 40px;
  background-color: #ff5f00;
  border-radius: 50%;
  margin-right: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.circle span {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 30px;
  font-weight: 700;
  font-style: Bold;
  letter-spacing: -0.79px;
  text-align: center;
  line-height: 33px;
}

.craft-drinks-card-cta {
  margin: 0 auto;
  text-align: center;
  margin-top: 40px;
}

.craft-drinks-card-cta-btn {
  display: inline-block;
  padding: 10px 30px;
  border-radius: 33px;
  font-family: 'Goldplay';
  border: 1.5px solid rgba(0, 38, 87, 1);
  box-shadow: 2px 6px 0px rgba(0, 38, 87, 1);
  background-color: #60d3f8;
  font-family: "Goldplay";
  font-size: 20px;
  font-weight: 600;
  font-style: SemiBold;
  letter-spacing: -0.13px;
  text-align: center;
  line-height: 20px;
  color: #002657;
  cursor: pointer;
  transition: all 0.2s;
}

@media (max-width: 1200px) {
  .craft-drinks-card {
    width: 388px;
    height: 462px;
  }
  .craft-drinks-card-header {
    text-align: center;
    padding-top: 50px;
  }

  .craft-drinks-card .card-title {
    font-size: 40px;
    line-height: 40px;
    margin-top: 6px;
    margin-bottom: 16px;
  }

  .craft-drinks-card .card-paragraph {
    font-size: 20px;
    line-height: 28px;
  }

  .circle {
    width: 34px;
    height: 34px;
  }

  .craft-drinks-card-list-item {
    font-size: 16px;
    line-height: 20px;
  }

  .craft-drinks-card-list-container {
    width: 100%;
    text-align: center;
    margin-top: 30px;
    margin-bottom: 28px;
    padding: 0 20px;
  }

  .circle span {
    font-size: 25px;
    line-height: 28px;
  }
  .craft-drinks-card-cta {
    margin-top: 20px;
  }
}

@media (max-width: 992px) {
  .craft-drinks-card {
    margin-left: 20px;
  }
}
@media (max-width: 873px) {
  .make-craft-drinks-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
  }
  .craft-drinks-card-container,
  .craft-drinks-image-container {
    max-width: 80%;
  }
  .craft-drinks-card {
    margin-left: 0px;
  }
}

@media (max-width: 767px) {
}

@media (max-width: 576px) {
   .craft-drinks-card-container,
  .craft-drinks-image-container {
    max-width: 100%;
  }
}
 {% endstyle %}

