{% assign section_bg = product.metafields.custom.color_2 | default: '#ffffff' %}
{% assign icon_color = product.metafields.custom.color_1 | default: '#000000' %}

<div class="custom-product-faq-section" style="background-color: {{ section_bg }};">
  <img src="{{ 'pink-umbrella.svg' | asset_url }}" width="246" height="296" class="faq-fruit bg-pink-umbrella">

  <div class="custom-product-faq-section-container">
    
    <div class="product-faq-body">
      <h2 class="product-faq-heading">{{ section.settings.heading }}</h2>



        {% assign faqs = product.metafields.custom.faqs.value %}
            {% if faqs != blank %}
              {% for faq in faqs limit:5 %}
                <div class="faq{% if forloop.index == 2 %} faq-active{% endif %}">
                  <div class="question">
                    <h3 class="question-title">{{ faq.question }}</h3>
                    <div class="question-icon">
                      <div class="icon-circle" style="background-color: {{ icon_color }}";>
                        <div class="icon-line horizontal"></div>
                        <div class="icon-line vertical"></div>
                      </div>
                    </div>
                  </div>
                  <div class="answer">
                    <p>{{ faq.answer }}</p>
                  </div>
                </div>
              {% endfor %}
            {% else %}
              <p>No FAQs available for this product.</p>
            {% endif %}
    </div>

    <div class="product-faq-image-container">
      <img class="product-faq-image" src="https://cdn.shopify.com/s/files/1/2340/1623/files/final-handpouring_mojito_2x_47e4ff4c-3946-4573-8496-6177d94f4079.png?v=1738835463" alt="">
    </div>
  </div>
 <div class="section-wave-container">
    <lottie-player class="section-wave" src="{{ 'wave-divider-right-to-left-2400px-offwhite.json' | asset_url }}" background="transparent"  speed="1"  loop autoplay></lottie-player>
  </div>
</div>

