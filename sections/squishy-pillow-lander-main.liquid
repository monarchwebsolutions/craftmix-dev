<script>
  // Product selection functionality
  document.addEventListener('DOMContentLoaded', function () {
    var form = document.querySelector('form[action="/cart/add"]');
    if (!form) return;

    var option1 = form.querySelector('.buy-option-1');
    var option2 = form.querySelector('.buy-option-2');

    var radio1 = form.querySelector('#pillow-bundle-selector');
    var radio2 = form.querySelector('#pillow-selector');

    var hiddenIdInput = form.querySelector('input[name="id"]');

    var PRODUCT_1_ID = '{{ product_1.variants.first.id }}';
    var PRODUCT_2_ID = '{{ product_2.variants.first.id }}';

    function selectOption1() {
      if (!hiddenIdInput) return;
      if (radio1) radio1.checked = true;
      if (radio2) radio2.checked = false;

      hiddenIdInput.value = PRODUCT_1_ID;

      if (option1) option1.classList.add('selected');
      if (option2) option2.classList.remove('selected');
    }

    function selectOption2() {
      if (!hiddenIdInput) return;
      if (radio2) radio2.checked = true;
      if (radio1) radio1.checked = false;

      hiddenIdInput.value = PRODUCT_2_ID;

      if (option2) option2.classList.add('selected');
      if (option1) option1.classList.remove('selected');
    }

    // Click anywhere on the container
    if (option1) {
      option1.addEventListener('click', function () {
        selectOption1();
      });
    }

    if (option2) {
      option2.addEventListener('click', function () {
        selectOption2();
      });
    }

    // Also handle direct clicks on radios (for accessibility / keyboard)
    if (radio1) {
      radio1.addEventListener('click', function (e) {
        e.stopPropagation();
        selectOption1();
      });
    }

    if (radio2) {
      radio2.addEventListener('click', function (e) {
        e.stopPropagation();
        selectOption2();
      });
    }
  });
</script>
<script>
document.addEventListener('DOMContentLoaded', () => {

  // --- Initialize each gallery independently ---
  document.querySelectorAll('.gallery').forEach((gallery) => {
    const lgImg   = gallery.querySelector('.img-wrapper-lg img');
    const nextBtn = gallery.querySelector('.img-lg-container .lp-main-next-btn');
    const prevBtn = gallery.querySelector('.img-lg-container .lp-main-prev-btn');
    const thumbs  = Array.from(gallery.querySelectorAll('.img-wrapper-sm img'));

    if (!lgImg) return;

    const slides = [
      {
        src: lgImg.getAttribute('src'),
        alt: lgImg.getAttribute('alt') || ''
      },
      ...thumbs.map(img => ({
        src: img.getAttribute('src'),
        alt: img.getAttribute('alt') || ''
      }))
    ];

    let currentIndex = 0;

    const updateLgImage = () => {
      const slide = slides[currentIndex];
      lgImg.src = slide.src;
      lgImg.alt = slide.alt;
    };

    const rotateForward = () => {
      currentIndex = (currentIndex + 1) % slides.length;
      updateLgImage();
    };

    const rotateBackward = () => {
      currentIndex = (currentIndex - 1 + slides.length) % slides.length;
      updateLgImage();
    };

    // Reset function attached to the gallery element
    gallery.resetGallery = () => {
      currentIndex = 0;
      updateLgImage();
    };

    // Main image click
    lgImg.addEventListener('click', rotateForward);

    // Arrows
    if (nextBtn) nextBtn.addEventListener('click', rotateForward);
    if (prevBtn) prevBtn.addEventListener('click', rotateBackward);

    // Thumbnails: click + keydown
    thumbs.forEach((thumb, index) => {
      thumb.style.cursor = 'pointer';
      thumb.setAttribute('tabindex', '0');

      const activateThumb = () => {
        currentIndex = index + 1;
        updateLgImage();
      };

      thumb.addEventListener('click', activateThumb);

      thumb.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activateThumb();
        }
      });
    });
  });

  // --- Toggle which gallery is visible when buy options are clicked ---
  const gallery1 = document.querySelector('.gallery-1');
  const gallery2 = document.querySelector('.gallery-2');
  const option1  = document.querySelector('.buy-option-1');
  const option2  = document.querySelector('.buy-option-2');

  function showGallery1() {
    if (!gallery1 || !gallery2) return;
    gallery1.style.display = '';
    gallery2.style.display = 'none';
    if (gallery1.resetGallery) gallery1.resetGallery();
  }

  function showGallery2() {
    if (!gallery1 || !gallery2) return;
    gallery1.style.display = 'none';
    gallery2.style.display = '';
    if (gallery2.resetGallery) gallery2.resetGallery();
  }

  if (option1) option1.addEventListener('click', showGallery1);
  if (option2) option2.addEventListener('click', showGallery2);

  // --- FAQ toggle: click + keydown, tabindex set here ---
  document.querySelectorAll('.faq-question').forEach((question) => {
    question.setAttribute('tabindex', '0');

    const toggleFAQ = () => {
      question.classList.toggle('open');
    };

    question.addEventListener('click', toggleFAQ);

    question.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleFAQ();
      }
    });
  });

});
</script>