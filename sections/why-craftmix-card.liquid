
<section style="background-color: {{ section.settings.background_color }} !important;" class="why-craftmix-card-section">
  <div class="why-craftmix-card">
    <img class="why-craftmix-card-image" src="https://cdn.shopify.com/s/files/1/2340/1623/files/why-craftmix-card-jt.svg?v=1737762238"  width="246" height="175" alt="Illustration of man with cocktail" loading="lazy">

    <div class="why-craftmix-card-text">
      <h2 class="why-craftmix-card-title">Why did we start Craftmix?</h2>
    </div>
    <div class="why-craftmix-card-cta">
      <a href="{{ section.settings.button_link }}" class="why-craftmix-card-btn">
        Read our story - Learn more
      </a>
    </div>
  </div>
</section>

{% style %}
/* ****************** */
/* Why Craftmix Card  */
/* ****************** */

.why-craftmix-card-section {
  
  padding: 50px 0;
}

.why-craftmix-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1390px;
  height: 122px;
  font-family: 'Goldplay';
  font-weight: 600;
  margin: 0 auto;
  padding: 0 20px;
  background-color: #f7ecfd;
  border-radius: 30px;
  box-shadow: 10px 10px 20px rgba(0, 0, 0, 0.13);
  opacity: 1;
  overflow: hidden;
}

/* Image Section */
.why-craftmix-card-image {
  width: auto;
  height: 175px;
  align-self: flex-end;
  overflow: hidden;
  margin-bottom: -30px;
}

/* Text Section */
.why-craftmix-card-text {
  flex: 1;
  padding-left: 20px;
}

.why-craftmix-card-text h2.why-craftmix-card-title {
  font-size: 30px;
  color: #002657;
  margin: 0;
}

/* CTA Section */

  .why-craftmix-card-btn {
    display: inline-block;
    padding: 10px 30px;
    border-radius: 33px;
    font-family: 'Goldplay';
    font-size: 20px;
    border: 1.5px solid rgba(0, 38, 87, 1);
    box-shadow: 2px 6px 0px rgba(0, 38, 87, 1);
    background-color: #60d3f8;
    color: #002657;
    cursor: pointer;
    transition: box-shadow 0.4s ease;
  }
  
  .why-craftmix-card-btn:hover {
     box-shadow: none;
  }

/* ****************** */
/* * Media Queries* * */
/* ****************** */  
 
@media (max-width: 1400px) {
  .why-craftmix-card {
    margin: 0 50px;
  }
}
  
@media (max-width: 1040px) {
  .why-craftmix-card-section {
    padding: 50px 16px; /* Add padding to the section */
  }
  
  .why-craftmix-card {
    max-width: 388px;
    width: 100%; 
    height: 331px;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
  }


  .why-craftmix-card-text {
    padding-left: 0px;
  }


  .why-craftmix-card h2,
  .why-craftmix-card p {
    text-align: center;
  }

  .why-craftmix-card-text h2.why-craftmix-card-title {
    font-size: 25px;
    color: #002657;
    margin: 0;
  }
  .why-craftmix-card-text {
    padding-top: 25px;
    margin: 0;
    flex: 0;
    order: -1;
  }

  /* Image position */
  .why-craftmix-card-image {
    margin: 0 auto;
    margin-bottom: -30px;
    order: 1;
  }

  .why-craftmix-card-cta {
    order: 3;
    padding-bottom: 40px;
  }
}


@media (max-width: 390px) {
  .why-craftmix-card-section {
    padding: 30px 15px;
  }

  .why-craftmix-card {
    max-width: 100%;
    height: auto; 
    padding: 20px 15px; 
    margin: 0 auto;
  }

  .why-craftmix-card-text h2.why-craftmix-card-title {
    font-size: 22px; 
    line-height: 1.3; 
  }

  .why-craftmix-card-image {
    height: 150px; 
    margin-bottom: -20px; 
  }

  .why-craftmix-card-btn {
    padding: 8px 20px; 
    font-size: 18px; 
  }

  .why-craftmix-card-cta {
    padding-bottom: 20px; 
  }
}
@media (max-width: 375px) {
  .why-craftmix-card-btn {
    font-size: 16px; 
  }
}
{% endstyle %}


{% schema %}
  {
    "name": "Why Craftmix Card",
    "settings": [
       {
        "type": "color",
        "id": "background_color",
        "label": "Background color",
        "default": "#ffffff"
      },
       {
        "type": "url",
        "id": "button_link",
        "label": "Button link",
        "default": "/"
      }
    ],
    "presets" : [
      {
        "name": "Why Craftmix Card"
      }
    ]
  }
{% endschema %}
