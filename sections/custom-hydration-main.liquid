{% liquid
  assign hydration_product = section.settings.product
  assign hydration_variant = hydration_product.first_available_variant
  assign hydration_form_id = 'HydrationCheckout-' | append: section.id
  assign hydration_checkout_url = routes.root_url | append: 'checkout'
  assign hydration_can_checkout = false
  if hydration_product != blank and hydration_variant.available
    assign hydration_can_checkout = true
  endif
  if hydration_product.requires_selling_plan
    assign hydration_selling_plan = hydration_variant.selling_plan_allocations.first.selling_plan
    if hydration_selling_plan == blank
      assign hydration_can_checkout = false
    endif
  endif
  assign hero = hydration_product.featured_image
%}
<section class="hydration-landing-main" data-hydration-main>
  <div class="hydration-landing-columns">
    <div class="product-media-container">
      <div class="pdp-images-section">
        <div class="pdp-main-img-wrapper">
          {% if hydration_product.metafields.custom.illustration_a != blank %}
            <img class="bg-img main-product-bg-img-1" src="{{ hydration_product.metafields.custom.illustration_a | file_url }}" width="200" height="200" alt="" role="presentation">
          {% endif %}
          {% if hydration_product.metafields.custom.illustration_b != blank %}
            <img class="bg-img main-product-bg-img-2" src="{{ hydration_product.metafields.custom.illustration_b | file_url }}" width="200" height="200" alt="" role="presentation">
          {% endif %}
          <div class="pdp-main-img-container">
            {% if hero != blank %}
              <img class="product-image" data-hydration-hero src="{{ hero | image_url: width: 1500 }}" width="{{ hero.width }}" height="{{ hero.height }}" alt="{{ hero.alt | escape }}" fetchpriority="high">
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'product-image' }}
            {% endif %}
          </div>
        </div>
        <div class="pdp-secondary-images-container">
          {% for image in hydration_product.images limit: 3 %}
            <button type="button" class="secondary-img-container" data-hydration-image="{{ image | image_url: width: 1500 }}" aria-label="View image {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
              <img class="product-image secondary-image" src="{{ image | image_url: width: 400 }}" width="200" height="200" alt="{{ image.alt | escape }}">
            </button>
          {% endfor %}
        </div>
      </div>
    </div>
    <div class="product-content-container">
      {% if section.settings.show_customer_reviews %}
        <div class="hydration-reviews">
          <img class="hydration-review-stars" src="https://cdn.shopify.com/s/files/1/2340/1623/files/stars-dark-blue.svg?v=1743061692" width="124" height="22" alt="" role="presentation">
          <span>3000+ 5-Star Reviews</span>
        </div>
      {% endif %}
      <h1 class="product-title">Amazing Tasting Hydration Has Arrived</h1>
      <div class="product-brief">
        {% if hydration_product.description != blank %}
          {{ hydration_product.description }}
        {% endif %}
      </div>
      <div id="hydration-introductory-offer" class="hydration-offer">
        <div class="hydration-offer-banner">50% Off</div>
        <div class="hydration-offer-body">
          <div class="hydration-offer-row">
            <div>
              <h2>Hydration Variety 6 Pack</h2>
              <p class="hydration-pack-details">6 Stick Packs / 3 Flavors</p>
            </div>
            <p class="hydration-offer-price"><s>$11.99</s> <span>$5.99</span></p>
          </div>
          <p class="hydration-offer-flavors">Lemon Lime, Wild Berry, Strawberry Watermelon</p>
          <ul class="hydration-offer-benefits" role="list">
            <li>Renews as a Hydration Variety 36 Pack every 6 weeks</li>
            <li>Pause or cancel anytime</li>
          </ul>
        </div>
      </div>
      {% if hydration_can_checkout %}
        {% form 'product', hydration_product, id: hydration_form_id, return_to: hydration_checkout_url, data-hydration-checkout: 'true' %}
          <input type="hidden" name="id" value="{{ hydration_variant.id }}">
          <input type="hidden" name="quantity" value="{{ hydration_variant.quantity_rule.min | default: 1 }}">
          {% if hydration_selling_plan != blank %}
            <input type="hidden" name="selling_plan" value="{{ hydration_selling_plan.id }}">
          {% endif %}
          {% if form.errors %}
            <div role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}
          <button type="submit" class="hydration-offer-cta">CHECKOUT</button>
        {% endform %}
      {% else %}
        <button type="button" class="hydration-offer-cta" disabled>CHECKOUT</button>
      {% endif %}
      {% if hydration_product.metafields.custom.product_description_bullets.value != blank %}
        <ul class="product-description-bullets" role="list">
          {% for bullet in hydration_product.metafields.custom.product_description_bullets.value %}
            <li>{{ bullet | escape }}</li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if hydration_product == blank and request.design_mode %}
        <p>Select the Hydration Variety product in this section's settings.</p>
      {% endif %}
    </div>
  </div>
</section>
    <div class="section-wave-container">
      <div
        class="lazy-lottie-container section-wave"
        data-src="{{ 'wave-divider-left-to-right-2400px-light-blue.json' | asset_url }}"
        data-background="transparent"
        data-speed="1"
        data-autoplay="true"
        data-loop="true"
      >
      <!-- lottie-player will be injected here -->
    </div>
  </div>
{% style %}
  #shopify-section-{{ section.id }} {
    --hydration-light: {{ hydration_product.metafields.custom.color_3 | default: '#ffffff' }};
    --hydration-medium: {{ hydration_product.metafields.custom.color_2 | default: '#bfefff' }};
    --hydration-dark: {{ hydration_product.metafields.custom.color_1 | default: '#002657' }};
    color: #002657;
  }
  #shopify-section-{{ section.id }} > .section-wave-container { background-color: #E5FFFF; }
  #shopify-section-{{ section.id }} .hydration-landing-main { background-color: #E5FFFF; overflow: hidden; padding: 60px 20px 40px; }
  #shopify-section-{{ section.id }} .hydration-landing-columns { display: flex; max-width: 1440px; margin: auto; gap: 50px; align-items: flex-start; }
  #shopify-section-{{ section.id }} .product-media-container { width: 50%; min-width: 0; padding-right: 40px; }
  #shopify-section-{{ section.id }} .product-content-container { width: 50%; min-width: 0; padding-top: 12px; }
  #shopify-section-{{ section.id }} .pdp-images-section { max-width: 638px; width: 100%; display: flex; flex-direction: column; gap: 25px; margin-left: auto; }
  #shopify-section-{{ section.id }} .pdp-main-img-wrapper { position: relative; }
  #shopify-section-{{ section.id }} .pdp-main-img-container { overflow: hidden; position: relative; width: 100%; aspect-ratio: 1; border-radius: 30px; border: 2px solid #002657; background: linear-gradient(184deg, var(--hydration-light), var(--hydration-medium)); z-index: 1; }
  #shopify-section-{{ section.id }} .bg-img { position: absolute; object-fit: contain; }
  #shopify-section-{{ section.id }} .main-product-bg-img-1 { right: -66px; top: 12px; max-height: 200px; }
  #shopify-section-{{ section.id }} .main-product-bg-img-2 { bottom: -82px; left: -128px; max-height: 200px; }
  #shopify-section-{{ section.id }} .product-image { object-fit: cover; width: 100%; height: 100%; }
  #shopify-section-{{ section.id }} .pdp-secondary-images-container { position: relative; display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 2%; z-index: 1; }
  #shopify-section-{{ section.id }} .secondary-img-container { padding: 0; cursor: pointer; width: 32%; aspect-ratio: 1; border-radius: 20px; border: 2px solid #002657; background: linear-gradient(184deg, var(--hydration-light), var(--hydration-medium)); overflow: hidden; }
  #shopify-section-{{ section.id }} .secondary-img-container[aria-pressed="true"] { outline: 2px solid var(--hydration-dark); outline-offset: 2px; }
  #shopify-section-{{ section.id }} .product-title { color: #002657; font-family: Hornbill; font-size: 58px; font-weight: 900; letter-spacing: normal; text-align: left; line-height: 1.2; overflow-wrap: break-word; margin: 10px 0 0; }
  #shopify-section-{{ section.id }} .product-brief { font-family: Goldplay; font-size: 18px; font-weight: 500; letter-spacing: -0.11px; line-height: 1.6; margin: 20px 0; }
  #shopify-section-{{ section.id }} .product-description-bullets { list-style: disc; padding-left: 2rem; margin: 24px 0 20px; }
  #shopify-section-{{ section.id }} .hydration-offer { border: 2px solid #002657; border-radius: 18px; overflow: hidden; font-family: Goldplay; color: #002657; background: #FFFFFF; }
  #shopify-section-{{ section.id }} .hydration-offer-banner { background: #7FD0F4; border-bottom: 2px solid #002657; text-align: center; padding: 4px 10px; font-size: 24px; font-weight: 600; line-height: 1.2; }
  #shopify-section-{{ section.id }} .hydration-offer-body { background: #FFFFFF; padding: 16px 20px; }
  #shopify-section-{{ section.id }} .hydration-offer-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 2px; }
  #shopify-section-{{ section.id }} .hydration-offer-row h2 { font: 800 30px/36px Hornbill; margin: 0; }
  #shopify-section-{{ section.id }} .hydration-offer-price { display: flex; flex-wrap: wrap; gap: 3px; font-family: Goldplay; font-size: 26px; font-weight: 600; line-height: 1.2; }
  #shopify-section-{{ section.id }} .hydration-offer-price s { opacity: 0.4; }
  #shopify-section-{{ section.id }} .hydration-offer-price > * { white-space: nowrap; }
  #shopify-section-{{ section.id }} .hydration-offer-flavors { margin-top: 12px; overflow-wrap: break-word; }
  #shopify-section-{{ section.id }} .hydration-offer-benefits { margin-top: 16px; }
  #shopify-section-{{ section.id }} .hydration-offer-cta { display: block; width: 100%; height: 60px; margin-top: 16px; font: 600 20px/20px Goldplay; color: #fff; border-radius: 33px; border: 2px solid #002657; box-shadow: 2px 6px 0 #002657; background: #fe6b00; cursor: pointer; transition: box-shadow 0.4s ease; }
  #shopify-section-{{ section.id }} .hydration-offer-cta:not(:disabled):hover,
  #shopify-section-{{ section.id }} .hydration-offer-cta:not(:disabled):focus-visible { box-shadow: none; }
  #shopify-section-{{ section.id }} .hydration-offer-cta:disabled { cursor: not-allowed; opacity: 0.6; }
  #shopify-section-{{ section.id }} .hydration-offer-cta:focus-visible { outline: 2px solid #002657; outline-offset: 4px; }
  @media (max-width: 1023px) {
    #shopify-section-{{ section.id }} .hydration-landing-main { padding: 40px 20px 28px; }
    #shopify-section-{{ section.id }} .hydration-landing-columns { flex-direction: column; gap: 20px; }
    #shopify-section-{{ section.id }} .product-media-container, #shopify-section-{{ section.id }} .product-content-container { width: 100%; padding: 0; max-width: 638px; margin: auto; }
    #shopify-section-{{ section.id }} .pdp-images-section { margin: auto; }
    #shopify-section-{{ section.id }} .product-title { margin: 0; }
  }
  @media (max-width: 766px) { #shopify-section-{{ section.id }} .product-title { font-size: 40px; line-height: 1.2; } }
  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} .pdp-images-section { gap: 15px; }
    #shopify-section-{{ section.id }} .pdp-main-img-container { border-radius: 20px; }
    #shopify-section-{{ section.id }} .pdp-secondary-images-container { gap: 10px; }
    #shopify-section-{{ section.id }} .secondary-img-container { width: calc(33.33% - 10px); border-radius: 15px; }
    #shopify-section-{{ section.id }} .main-product-bg-img-1 { height: 150px; top: -24px; right: -76px; }
    #shopify-section-{{ section.id }} .main-product-bg-img-2 { bottom: -48px; left: -64px; width: 124px; }
    #shopify-section-{{ section.id }} .hydration-offer-row h2 { font-size: 24px; line-height: 1.2; }
  }
  #shopify-section-{{ section.id }} .hydration-reviews { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; color: #002657; font: 600 22px/1.4 Goldplay; }
  #shopify-section-{{ section.id }} .hydration-review-stars { width: 124px; height: 22px; object-fit: contain; }
  #shopify-section-{{ section.id }} .hydration-pack-details { color: #FE6B00; text-transform: uppercase; font: 600 20px/1.4 Goldplay; }
  #shopify-section-{{ section.id }} .hydration-offer-row > div { min-width: 0; overflow-wrap: break-word; }
  #shopify-section-{{ section.id }} .hydration-offer-benefits,
  #shopify-section-{{ section.id }} .product-description-bullets { color: #002657; font: 600 20px/1.4 Goldplay; }
  #shopify-section-{{ section.id }} .hydration-offer-benefits { list-style: none; padding-left: 0; }
  #shopify-section-{{ section.id }} .hydration-offer-benefits li { display: flex; align-items: baseline; gap: 5px; overflow-wrap: anywhere; }
  #shopify-section-{{ section.id }} .hydration-offer-benefits li::before { content: ""; flex: 0 0 17px; height: 10px; background: url('https://cdn.shopify.com/s/files/1/2340/1623/files/lp-tick.svg?v=1744287348') center / contain no-repeat; }
  @media (max-width: 529px) {
    #shopify-section-{{ section.id }} .hydration-reviews { font-size: 16px; }
    #shopify-section-{{ section.id }} .hydration-review-stars { height: 16px; width: auto; }
    #shopify-section-{{ section.id }} .hydration-offer-body { padding: 11px 14px; }
    #shopify-section-{{ section.id }} .hydration-offer-row h2 { font-size: 20px; line-height: 1.2; }
    #shopify-section-{{ section.id }} .hydration-pack-details,
    #shopify-section-{{ section.id }} .hydration-offer-benefits,
    #shopify-section-{{ section.id }} .product-description-bullets { font-size: 14px; }
    #shopify-section-{{ section.id }} .hydration-offer-banner { font-size: 16px; }
    #shopify-section-{{ section.id }} .hydration-offer-price { font-size: 18px; gap: 9px; }
    #shopify-section-{{ section.id }} .hydration-offer-benefits li::before { flex-basis: 12px; height: 7px; }
  }
{% endstyle %}
{% javascript %}
  (() => {
    function init(root) {
      root.querySelectorAll('[data-hydration-main]').forEach(section => {
        if (section.dataset.initialized) return;
        section.dataset.initialized = 'true';
        const hero = section.querySelector('[data-hydration-hero]');
        section.querySelectorAll('[data-hydration-image]').forEach(button => {
          button.addEventListener('click', () => {
            if (!hero) return;
            hero.src = button.dataset.hydrationImage;
            hero.alt = button.querySelector('img').alt;
            section.querySelectorAll('[data-hydration-image]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
          });
        });

        const checkoutForm = section.querySelector('[data-hydration-checkout]');
        const checkoutButton = checkoutForm?.querySelector('.hydration-offer-cta');
        if (checkoutForm && checkoutButton) {
          const submitCheckout = event => {
            event.preventDefault();
            event.stopImmediatePropagation();
            if (checkoutButton.disabled) return;

            checkoutButton.disabled = true;
            checkoutForm.setAttribute('aria-busy', 'true');
            // Native submission bypasses cart-drawer hooks and honors return_to.
            HTMLFormElement.prototype.submit.call(checkoutForm);
          };

          checkoutForm.addEventListener('click', event => {
            if (event.target.closest('.hydration-offer-cta')) submitCheckout(event);
          }, { capture: true });
          checkoutForm.addEventListener('submit', submitCheckout, { capture: true });

          window.addEventListener('pageshow', () => {
            checkoutButton.disabled = false;
            checkoutForm.removeAttribute('aria-busy');
          });
        }
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => init(document), { once: true });
    else init(document);
    document.addEventListener('shopify:section:load', event => init(event.target));
  })();
{% endjavascript %}
{% schema %}
{
  "name": "Hydration Landing Main",
  "settings": [
    { "type": "product", "id": "product", "label": "Hydration product", "info": "Checkout purchases this product's first available variant. The button is disabled when no product is selected or the product is unavailable." },
    { "type": "checkbox", "id": "show_customer_reviews", "label": "Show customer reviews", "default": true }
  ],
  "presets": [{ "name": "Hydration Landing Main" }]
}
{% endschema %}
