{% schema %}
{
  "name": "Variety Lander Main",
  "settings": [
    {
      "type": "product",
      "id": "main_product",
      "label": "Main Product"
    },
    {
      "type": "number",
      "id": "price_per_drink",
      "label": "Price Per Drink"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Variety Lander Main"
    }
  ]
}
{% endschema %}

{% style %}
section.landing-page-main {
  background-color: #ddf7f7;
  position: relative;
}

/* Hide carousel by default (desktop/tablet) */
.image-carousel-wrapper {
  display: none;
}

.lp-main-wrapper {
  max-width: 1400px;
  padding: 80px 20px 50px 20px;
  margin: 0 auto;
}

.flex-container {
  display: flex;
  flex-direction: row;
  align-items: start;
  justify-content: space-between;
  gap: 74px;
  margin-bottom: 40px;
}

.flex-item-left {
  width: 100%;
  display: flex;
  max-width: 776px;
  align-items: flex-start;
  align-content: flex-start;
  gap: 20px;
  flex-wrap: wrap;
}

.flex-item-right {
  max-width: 512px;
  width: 100%;
}

.lp_image_carousel_embla__viewport {
  overflow: hidden;
  width: 100%;
}

.lp_image_carousel_embla__container {
  display: flex;
  gap: 12px;
}

.lp_image_carousel_embla__slide {
  flex: 0 0 auto;
  height: auto;
  scroll-snap-align: center;
}
.lp_image_carousel_embla__slide:last-of-type {
  margin-right: 12px;
}
.small-img-container {
  border: 1px solid #002657;
  border-radius: 20px;
  overflow: hidden;
}
  
.lp-carousel-image {
  width: 100%;
  height: auto;
  display: block;
}

.img-lg-container {
  width: 100%;
  max-width: 774px;
  position: relative;
}


.img-wrapper-lg img {
  width: 100%;
  height: auto;
  display: block;
}

.imgs-sm-container {
  max-width: 776px;
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 17.839px;
  justify-content: space-between;
}

.img-wrapper-sm {
  width: calc(50% - 8.9195px);
  border: 2px solid #000; 
  border-radius: 26px;
  overflow: hidden;
}

.img-wrapper-sm img {
  width: 100%;
  height: auto;
  display: block;
}

.img-wrapper-lg,
.img-wrapper-sm {
  position: relative;
  border: 2px solid #002657;
  border-radius: 26px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-wrapper-lg img,
.img-wrapper-sm img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.lp-main-prev-btn,
.lp-main-next-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  z-index: 10;
  background-color: transparent;
  width: 62px;
  height: 62px;
}

.lp-main-prev-btn{
  left: 24px;
}

.lp-main-next-btn {
  right: 24px;
}

.lp-main-prev-btn img {
  transform: scaleX(-1);
}



.reviews {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  padding-bottom:12px;
}

.reviews .review-stars {
  height: 22px;
  margin-right:6px;
  width:auto;
}
.reviews .review-text {
  color: #002657;
  font-size: 16px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 30.8px;
  font-weight:normal;
}
.reviews .review-text-b{
  font-weight:600;
}
.review-text-separator{
  padding: 0 12px;
}
h1.heading-text {
  color: #002657;
  font-size: 44px;
  font-family: Hornbill;
  font-weight: 900;
  line-height: 1.2;
  margin-bottom: 24px;
}

p.paragraph-text {
  color: #002657;
  font-size: 24px;
  font-family: Goldplay;
  font-weight: 500;
  line-height: 33.6px;
  margin-bottom: 24px;
}

.buy-option-container {
  display: flex;
  flex-direction: column; 
  border-radius: 18px;
  border: 2px solid rgba(0, 38, 87, 0.1);
  background: rgba(255, 255, 255, 0.7);
  margin-bottom: 24px;
  cursor: pointer;
  overflow: hidden;
}

.buy-option-row {
  display: flex;
  flex-direction: row; /* row layout for the main content */
  align-items: flex-start;
  justify-content: space-between;
  padding: 16px 20px;
}
  
.buy-option-container-lg {
  border-radius: 18px;
  margin-bottom: 8px;
  border: 2px solid rgba(0, 38, 87, 0.1);
  overflow: hidden;
}

.buy-option-container-lg-product {
  display: flex;
  padding: 16px 20px;
  flex-direction: row;
  align-items: start;
  justify-content: space-between;
  background: rgba(255, 255, 255, 1);
  gap:2px;
}

.sale-bar {
  background-color: #7fd0f4;
  padding: 4px 10px;
  text-align: center;
  border-bottom: 2px solid rgba(0, 38, 87, 0.1)
}

.sale-bar-text {
  color: #002657;
  font-size: 24px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 28.8px;
}

.buy-option-container.selected,
.buy-option-container-lg.selected {
  border: 2px solid rgba(0, 38, 87, 1); 
}

.buy-option-container.selected .sale-bar,
.buy-option-container-lg.selected .sale-bar {
  border-bottom: 2px solid rgba(0, 38, 87, 1);
}

.buy-option-container-lg-footer {
  background: rgba(255, 255, 255, 1);
  padding: 0px 20px 16px 20px;
}

.club-benifits-items {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.club-benifits img {
  margin-right: 5px;
}

.club-benifits-items img {
  height: 10px;
  width: 17px;
}
.club-benifits span {
  color: #000;
  font-size: 20px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 28px;
}
.club-benifits-top,
.club-benifits-bottom {
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  gap: 24px;
}

.buy-option-info .product-name {
  color: #002657;
  font-size: 30px;
  font-family: Hornbill;
  font-weight: 800;
  line-height: 36px;
  padding-right:12px;
}
.buy-option-info .product-contents {
  color: #fe6b00;
  font-size: 20px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 28px;
}

.buy-option-pricing {
  display: flex;
  flex-direction: column;
}

.buy-option-pricing-comparison {
  display: flex;
  flex-direction: row;
  gap: 3px;
}

.buy-option-pricing-comparison-before {
  color: #002657;
  font-size: 26px;
  font-family: Goldplay;
  font-weight: 600;
  text-decoration: line-through;
  line-height: 31.2px;
  opacity: 0.4;
}
.buy-option-pricing-comparison-after {
  color: #002657;
  font-size: 26px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 31.2px;
}

.buy-option-pricing-per-drink-text {
  color: #002657;
  font-size: 20px;
  font-family: Goldplay;
  font-weight: 600;
  text-transform: uppercase;
  line-height: 28px;
  text-align: right;
  opacity: 0.4;
}

input[type="radio"] {
  appearance: none;
  -webkit-appearance: none;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 2px solid #002657;
  display: inline-block;
  position: relative;
  background: white;
  cursor: pointer;
}

input[type="radio"]::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12px; 
  height: 12px;
  background-color: #002657;
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.2s ease;
}

input[type="radio"]:checked::after {
  opacity: 1;
}

.buy-button {
  font-family: 'Goldplay';
  font-weight: 600;
  font-size: 22px;
  line-height: 140%;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 16px 12px;
  gap: 3px;
  max-width: 492px;
  width: 100%;
  height: 69px;
  background: #fe6b00;
  color: #fff;
  border: 2px solid #000000;
  box-shadow: 4px 4px 0px #000000;
  transition: box-shadow 0.4s ease;
  border-radius: 100px;
  margin: 0 auto;
  text-transform: uppercase;
  cursor: pointer;
  flex: none;
  order: 1;
  flex-grow: 0;
}

.buy-button:hover {
  box-shadow: none;
}

.flavor-container {
  margin: 24px 0px;
  padding: 16px 0px;
  max-width: 100%;
}

h2.flavor-heading {
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay' !important;
  font-size: 22px;
  font-weight: 600 !important;
  letter-spacing: 0.3px;
  text-align: left;
  line-height: 18px;
  margin-bottom: 10px;
}
/* FLAVOR GRID SMALL */
.flavor-card-grid-single-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
  justify-content: center;
  place-items: center;
  gap: 16px;
}



.flavor-card-single {
  border-radius: 12px;
  overflow: hidden;
  width:25%;
}

.flavor-card-single-image-container {
  max-width: 118px;
  max-height: 124px;
  background-color: #fff;
  border-radius: 12px;
  border: 1.5px solid rgba(0, 38, 87, 0.08);
  padding: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flavor-card-single-image {
  width: 100%;
  height: auto;
}

.flavor-card-single-heading {
  font-family: 'Goldplay';
  font-size: 15px;
  font-weight: 600;
  text-align: center;
  line-height: 16px;
  padding-top: 10px;
}
/* END FLAVOR GRID SMALL */

/* FLAVOR GRID LARGE */
.flavor-card-grid-double-row {
  display: grid;
   grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
  justify-content: center;
  place-items: center;
  gap: 10px;
}

.flavor-card-double {
  width: 90px;
  height: 130px;
  border-radius: 12px;
  overflow: hidden;
}

.flavor-card-double-image-container {
  width: 90px;
  height: 90px;
  background-color: #fff;
  border-radius: 12px;
  border: 1.5px solid rgba(0, 38, 87, 0.08);
  padding: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flavor-card-double-image {
  width: 100%;
  height: auto;
}

.flavor-card-double-heading {
  font-family: 'Goldplay';
  font-size: 12px;
  font-weight: 600;
  text-align: center;
  line-height: 16px;
  padding-top: 10px;
}
/* END FLAVOR GRID LARGE */

/* FOR GRID DISPLAY WITH JS */
.flavor-card-grid-single-row,
.flavor-card-grid-double-row {
  display: none;
}

.flavor-card-grid-single-row.active,
.flavor-card-grid-double-row.active {
  display: grid;
}  
/* END GRID DISPLAY WITH JS */  
  
.faq-container {
  max-width: 492px;
  width: 100%;
}

.faq-question-body {
  margin-bottom: 24px;
}

.faq-answer {
  display: none;
  margin-top: 8px;
}

.faq-question h6 {
  color: #002657;
  font-size: 24px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 28.8px;
}

.faq-answer p {
  color: #002657;
  font-size: 20px;
  font-family: Goldplay;
  font-weight: 500;
  line-height: 28px;
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
}

.faq-icon::before {
  content: '+';
  font-size: 18px;
  transition: transform 0.2s ease;
}

/* when open */
.faq-question.open + .faq-answer {
  display: block;
}

.faq-question.open .faq-icon::before {
  content: '−'; 
}

.landing-page-heading-section-marquee {
  position: absolute;
   top: auto !important;
  bottom: -50% !important;
  z-index:1;
  pointer-events: none;
  height:revert-layer !important;
}

/* Hide carousel by default (desktop/tablet) */
.image-carousel-wrapper {
  display: none;
}
.buy-options-wrapper [class*="buy-option-container"],
.buy-options-wrapper .buy-option-row{
  background-color:#f5fdfd;
}
.buy-options-wrapper .selected [class*="buy-option-container"],
.buy-options-wrapper .selected .buy-option-row{
  background-color:white !important;
}

/* Variety Lander CSS */

.variety-lander-benefits-header{
  font-family:Goldplay;
  font-weight:600;
  font-size:16px;
  text-transform:uppercase;
  text-align:center;
}

.variety-lander-benefits-container{
  display:flex;
  justify-content:space-between;
  gap:4px;
  padding-top:16px;
}
.variety-lander-benefit{
  position:relative;
  width:25%;
}

.benefit-included-price{
  background-color:#C8202F;
  font-size:10px;
  text-transform:uppercase;
  text-align: center;
  color: white;
  font-family: 'Goldplay';
  font-weight: bold;
  padding: 2px 6px;
  border-radius: 4px;
  position:absolute;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  top:-8px;
}
.benefit-img-container{
  border: 1px dashed #2a2552;
  border-radius:4px;
  max-height: 114px;
  display: flex;
  align-items: center;
}
.benefit-img{
  padding:8px 5px 0;
}
.benefit-img-3{
  /* padding-top: 10px; */
}
.benefit-text{
    font-family: 'Goldplay';
    font-size: 11px;
    font-weight: bold;
    text-align: center;
    padding-top: 4px;
}
.included-flavors{
  display: flex;
  /* justify-content: space-between; */
  max-width: 492px;
  gap:4px;
}
.buy-options-wrapper{
  margin-bottom:24px;
}
.flavor-title{
  font-family:Goldplay;
  font-size:16px;
  font-weight:600;
  text-align:center;
}
@media screen and (max-width:1120px){
  h1.heading-text{
    font-size:40px;
  }
}
@media (max-width: 1040px) {
  .flex-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom:40px;
  }
}
@media (max-width: 829px) {
  .flex-item-right,
  .flex-item-left {
    max-width: 492px;
  }
}


@media (max-width: 768px) {
  input[type="radio"] {
    width: 15px;
    height: 15px;
  }

  input[type="radio"]::after {
    width: 8px;
    height: 8px;
  }
}
/* Show on mobile */
@media (max-width: 529px) {
  .img-lg-container,
  .imgs-sm-container {
    display: none;
  }

  .image-carousel-wrapper {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin: 0; 
    padding: 24px 16px 0px 16px;
  }

  .image-carousel-wrapper::-webkit-scrollbar {
    display: none;
  }

  .lp-image-carousel {
    display: flex;
    gap: 12px;
    scroll-snap-type: x mandatory;
    margin-right: 16px;
  }

  .lp-carousel-image {
    flex: 0 0 auto;
    height: 260px;
    width: auto;
    scroll-snap-align: center;
    object-fit: cover;
  }

  .lp-main-wrapper {
    padding: 25px 16px;
    margin: 0 auto;
  }

  .flex-container {
    gap: 0px;
  }

  .reviews .review-stars {
    height: 16px;
  }

  .reviews .review-text {
    font-size: 12px;
    line-height: 140%;
  }

  h1.heading-text {
    color: #002657;
    font-size: 28px;
    font-family: Hornbill;
    font-weight: 900;
    line-height: 120%;
    margin-bottom: 16px;
  }

  p.paragraph-text {
    font-size: 18px;
    line-height: 140%;
    margin-bottom: 16px;
  }

  .buy-option-row,
  .buy-option-container-lg-product {
    padding: 11px 14px;
  }

  .buy-option-info .product-name {
    font-size: 20px;
    line-height: 120%;
  }
  .buy-option-info .product-contents {
    font-size: 12px;
    line-height: 140%;
  }

  .buy-option-pricing {
    display: flex;
    flex-direction: column;
  }

  .buy-option-pricing-comparison {
    display: flex;
    flex-direction: row;
    gap: 9px;
  }

  .buy-option-pricing-comparison-before {
    color: #002657;
    font-size: 18px;
    font-family: Goldplay;
    font-weight: 600;
    text-decoration: line-through;
    line-height: 120%;
    opacity: 0.4;
  }
  .buy-option-pricing-comparison-after {
    color: #002657;
    font-size: 18px;
    font-family: Goldplay;
    font-weight: 600;
    line-height: 120%;
  }

  .buy-option-pricing-per-drink-text {
    font-size: 14px;
    line-height: 140%;
  }

  .sale-bar {
    padding: 4px 10px;
  }

  .sale-bar-text {
    font-size: 16px;
    line-height: 120%;
  }

  .buy-option-container-lg-footer {
    background: rgba(255, 255, 255, 1);
    padding: 0px 16px 11px 16px;
  }

  .club-benifits-top,
  .club-benifits-bottom {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    gap: 16px;
  }

  .club-benifits-items img {
    width: 12px;
    height: 7px;
  }

  .club-benifits span {
    font-size: 14px;
    line-height: 140%;
  }

  .buy-button {
    font-size: 18px;
    line-height: 140%;
    padding: 11px 8px;
    gap: 3px;
    max-width: 492px;
    width: 100%;
    height: 50px;
  }

  .flavor-heading {
    font-size: 16px;
    line-height: 120%;
    margin-bottom: 20px;
    text-align: center;
  }

  .faq-question h6 {
    font-size: 18px;
    line-height: 120%;
  }

  .faq-answer p {
    font-size: 16px;
    line-height: 140%;
  }
  
  /* Variety Lander Mobile CSS */
  .flavor-title{
    font-size:12px;
  }
  .benefit-included-price{
    white-space:unset;
    font-size:8px;
    top:-14px;
  }
  .variety-lander-benefits-container{
    padding-top:20px;
  }
  .review-text-separator{
    padding: 0 4px;
  }
  .reviews .review-stars {
    margin-right:0;
  }
  h2.flavor-heading{
    font-size:18px;
  }
  .reviews{
    gap:4px;
  }
  .variety-lander-benefits-header{ 
    font-size:13px;
  }
}
@media screen and (max-width:399px){
  .buy-option-info .product-name {
    font-size: 18px;
  }
  .buy-option-info .product-contents{
    font-size:12px;
  }
}

{% endstyle %}
{% assign main_product = section.settings.main_product %}
<section class="landing-page-main">
  <div class="image-carousel-wrapper embla">
    <div class="lp_image_carousel_embla__viewport">
      <div class="lp_image_carousel_embla__container">
        {% for image in main_product.images %}
          <div class="lp_image_carousel_embla__slide small-img-container">
            <img
              class="lp-carousel-image"
              src="{{ image | image_url: width: 520, height: 520, crop: 'center' }}"  {# 2x for crisp 260px square #}
              alt="{{ image.alt | escape | default: p.title }}"
              width="260" height="260"
              loading="lazy" decoding="async"
            >
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="lp-main-wrapper ">
    <div class="flex-container">
      <div class="flex-item-left">
        {% assign raw = page.metafields.custom.photos %}
        {% assign cleaned = raw 
          | remove: '[' 
          | remove: ']' 
          | remove: '"' 
        %}
        {% assign image_urls = cleaned | split: ',' %}
        <div class="img-lg-container">
          <div id="lander-featured-image" class="img-wrapper-lg">
            <img src="{{ main_product.featured_image | img_url: 'original' }}"
              alt='A variety of colorful cocktails in different glasses with fruit garnishes are displayed on a light blue background; text reads “60 Drinks, 10 Flavors.”.' width="704" height="704">
            </div>
            <button class="lp-main-prev-btn" aria-label="Previous slide">
              <img src="{{ 'lp-carousel-btn.svg' | asset_url }}" alt="Left facing arrow icon inside circle" width="62" height="62">
            </button>

            <button class="lp-main-next-btn" aria-label="Next slide">
              <img src="{{ 'lp-carousel-btn.svg' | asset_url }}" alt="Right facing arrow icon inside circle"" width="62" height="62">
            </button>
          </div>
       <div class="imgs-sm-container">
          <div class="img-wrapper-sm"><img
              src="{{ main_product.images[1] | img_url: 'original' }}"
              alt='A Craftmix Variety 60 Pack with individual drink mix packets in assorted flavors displayed in front of the main package.' width="770" height="770"></div>
          <div class="img-wrapper-sm"><img
              src="{{ main_product.images[2] | img_url: 'original' }}"
