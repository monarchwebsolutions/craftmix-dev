              <input
                id="x-cart-custom-field"
                type="text"
                {% if settings.cart_custom_field_required %}
                  :class="custom_field_error && 'border-[rgba(var(--color-error))] shadow-[0_0_0_1px_rgba(var(--color-error))]'"
