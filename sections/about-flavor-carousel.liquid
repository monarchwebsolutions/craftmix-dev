<div class="custom-carousel-container about-carousel-container">
  {% render 'custom-carousel-inner' %}

  <div class="section-wave-container lottie-player">
    <lottie-player class="section-wave" src="{{ 'wave-divider-l2r-off-white.json' | asset_url }}" background="{{section.settings.background_color}}"  speed="1"  loop autoplay></lottie-player>
  </div>
</div>
<style>
  .about-carousel-container{
    padding-top:30px;
  }
  .about-carousel-container .section-wave-container {
    aspect-ratio: unset;
    position: relative;
    z-index:0;
    bottom:-1px;
  }
  .about-carousel-container .custom-flavor-carousel-container {
    padding-bottom: 60px;
  }
</style>
{% schema %}
  {
    "name": "about flavor carousel",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading Text",
        "default": "Find Your Flavor" 
      }, 
       {
        "type": "color",
        "id": "background_color",
        "label": "Background color",
        "default": "#ffffff"
      }
    ],
     "presets": [{"name": "about flavor carousel"}]
   }
{% endschema %}