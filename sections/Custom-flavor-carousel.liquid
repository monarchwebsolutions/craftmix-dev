.product-card-title {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 18px;
  font-weight: 700;
  font-style: Bold;
  letter-spacing: -0.47px;
  text-align: center;
  line-height: 30px;
}

.product-card-image {
  width: 278px;
  height: 278px;
  margin: 0 auto;
  margin-bottom: 28px;
