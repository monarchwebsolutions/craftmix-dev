{{- 'flickity.css' | asset_url | stylesheet_tag -}}
{{- 'flickity.pkgd.min.js' | asset_url | script_tag -}}
<script src="{{ 'custom-carousel.js' | asset_url }}" defer='defer'></script>

<div> 
  <div style="background-color: {{ section.settings.background_color }} !important;" class="custom-flavor-carousel-section">
    <div class="custom-flavor-carousel-header">
      <h3 class="custom-flavor-carousel-heading">{{ section.settings.heading }}</h3>
    </div>
  
    <div class="custom-flavor-carousel-container">
      <div class="custom-carousel">
  
        <!-- Carousel Items Start  -->
        
          
      {% for product in collections['find-your-flavor-carousel'].products %}
        {% unless product.tags contains "price_test" %}
    


          <div class="cell-container">
            <div class="custom-flavor-carousel-cell ">
              <div class="product-carousel-card">
                <div class="product-card-container">

                  <div class="product-card-container">
                   <div class="product-card"
                         data-color1="{{ product.metafields.custom.color_1 | default: '#8c4a84' }}"
                         data-color2="{{ product.metafields.custom.color_2 | default: '#e6dbf7' }}"
                         data-color3="{{ product.metafields.custom.color_3 | default: '#f8f3fa' }}"
                         style="background-color: {{ product.metafields.custom.color_3 | default: '#f8f3fa' }};">
                      <div class="product-card-info">
                        <div class="product-card-stars">
                          <!-- <img src=""> -->
                          <p>4.9</p>
                        </div>
                       <h3 class="product-card-title">{{ product.title | replace_first: "2025 - ", "" }}</h3>
                      </div>
                      <div class="product-card-image">
                        {% if product.featured_image %}
                          {{ product.featured_image | img_url: '278x278' | img_tag: product.title }}
                        {% else %}
                          {{ 'product-placeholder.png' | asset_url | img_tag: 'Placeholder image' }}
                        {% endif %}
                      </div>
                    
                     <div class="product-card-footer">
                           <div class="product-card-variant-size custom-select" style="background-color: {{ product.metafields.custom.color_2 | default: '#e6dbf7' }};">
                           <select name="product-variant-size" id="product-variant-size-{{ product.id }}" style="background-color: {{ product.metafields.custom.color_2 | default: '#e6dbf7' }};">
                            {% for variant in product.variants %}
                              <option value="{{ variant.id }}" data-price="{{ variant.price }}" {% if forloop.first %}selected{% endif %}>
                                {{ variant.title }}
                              </option>
                            {% endfor %}
                          </select>
                            <span class="custom-arrow"></span>
                          </div>
                           <div class="product-card-add-to-cart" style="background-color: {{ product.metafields.custom.color_1 | default: '#8c4a84' }};">
                            <button class="product-card-add-btn" data-product-id="{{ product.id }}">
                              Add - <span class="variant-price igPrice" data-product-id="{{product.id }}">{{ product.price | money }}</span>
                            </button>
                          </div>
                        </div>
                    
                     
                    </div>
                  </div> 
                  
                </div>
              </div>
            </div>
          </div>
        {% endunless %}
        {% endfor %}

        <!-- Carousel Items End  -->
       </div>   
    </div>

      <div class="section-wave-container lottie-player">
      <lottie-player class="section-wave" src="{{ 'wave-divider-right-to-left-offwhite-1440px.json' | asset_url }}" background="transparent"  speed="1"  loop autoplay></lottie-player>
    </div>
    
  </div>
  
</div> 
 
        
        
        
        


{% style %}
*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

ul {
  list-style: none;
}

a {
  text-decoration: none;
}

img {
  max-width: 100%;
}

.custom-flavor-carousel-section {
  padding-top: 50px;
  padding-bottom: 50px;
  position: relative;
  /* background-color: #fff9f5; */
}

.custom-flavor-carousel-container {
  margin-bottom: 60px;
  position: relative;
  padding-top: 86px; /* Add padding to make room for the buttons */
}

.custom-flavor-carousel-heading {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 64px;
  font-weight: 700;
  font-style: Bold;
  letter-spacing: -1.68px;
