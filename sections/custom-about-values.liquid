<section class="about-values">
    <img class="background-fruit fruit-pineapple" src="https://cdn.shopify.com/s/files/1/2340/1623/files/pineapple.svg?v=1738879807" width="470" height="450" loading="lazy" alt="Pinapple" role="presentation">
     <img class="background-fruit fruit-tropical-leaf" src="https://cdn.shopify.com/s/files/1/2340/1623/files/tropical-leaf.svg?v=1738880888 " width="332" height="320" loading="lazy" alt="tropical leaf" role="presentation">
     <img class="background-fruit fruit-mint" src="https://cdn.shopify.com/s/files/1/2340/1623/files/mint.svg?v=1738881269" width="382" height="350" loading="lazy" alt="mint" role="presentation">
      <div class="about-values-container">
        <img class="background-fruit fruit-blueberry" src="https://cdn.shopify.com/s/files/1/2340/1623/files/blueberry.png?v=1739183661" width="127" height="130" loading="lazy" alt="blueberry" role="presentation">      
        <img class="background-fruit fruit-cherry" src="https://cdn.shopify.com/s/files/1/2340/1623/files/cherrycherry.png?v=1739182967" width="161" height="206" loading="lazy" alt="cherry" role="presentation">
        <img class="background-fruit fruit-passionfruit" src="{{ 'passionfruit.png' | asset_url }}" width="206" height="210" loading="lazy" alt="passionfruit" role="presentation">
        <img class="background-fruit fruit-orange-peel" src="https://cdn.shopify.com/s/files/1/2340/1623/files/orangepeel.svg?v=1738880141" width="273" height="240" loading="lazy" alt="orange peel" role="presentation">
       
        <!-- Our values -->
        <div class="our-values">
          <div class="our-values-text">
            <h2 class="our-values-heading">Our Values</h2>
            <p>Craftmix is all about real ingredients, convenience, and flavor. We believe in single-serve mixers—for less waste, more portability, and maximum fun. We also believe in choice, which is why every flavor is vegan, gluten-free, and perfect for alcohol-free drinks. Cheers to happy hour, any hour.</p>
          </div>
          <div class="our-values-badges">
            <div class="badges">
              <img src="https://cdn.shopify.com/s/files/1/2340/1623/files/hero-badges-small-min.png?v=1733988545" alt="row of badges" class="badges-image" width="450" height="95" loading="lazy">
            </div>
          </div>
        </div>

        <!-- Why Craftmix -->
        <div class="why-craftmix">
          <div class="why-craftmix-text">
            <h5 class="subheading">How We Compare</h5>
            <h2 class="heading">Why Craftmix</h2>
          </div>
          <div class="why-craftmix-table">

            <div class="lg-table">
              <table>
                <tr>
                  <th><span class="visually-hidden">Blank header</span></th>
                  <th><span class="visually-hidden">Blank header</span></th>
                  <th class="right-item table-top-right"><img class="mix-bottle table-mix_icon"
                    src="{{ 'mix-bottle.png' | asset_url }}"  alt="Bottle illustration" width="27" height="48" >
                    <span class="table-top-right-text">Other Mixes</span>
                  </th>
                </tr>
                <tr>
                  <td>Bar Fresh Taste</td>
                  <td></td>
                  <td><img class="table-cross_icon" src="{{ 'red-cross.png' | asset_url }}" alt="red cross" width="34" height="33" loading="lazy"></td>
                </tr>
                <tr>
                  <td>Great for Mocktails</td>
                  <td></td>
                  <td><img class="table-cross_icon" src="{{ 'red-cross.png' | asset_url }}" alt="red cross"width="34" height="33" loading="lazy"></td>
                </tr>
                <tr>
                  <td>Calories</td>
                  <td></td>
                  <td>280</td>
                </tr>
                <tr>
                  <td>Sugar</td>
                  <td></td>
                  <td>58g</td>
                </tr>
                <tr>
                  <td>No artificial ingredients</td>
                  <td></td>
                  <td><img class="table-cross_icon" src="{{ 'red-cross.png' | asset_url }}" alt="red cross"width="34" height="33" loading="lazy"></td>
                </tr>
                <tr>
                  <td>~$1 per drink</td>
                  <td></td>
                  <td><img class="table-cross_icon" src="{{ 'red-cross.png' | asset_url }}" alt="red cross"width="34" height="33" loading="lazy"></td>
                </tr>
              </table>
            </div>


            <div class="sm-table">
              <table>
                <tr class="tall-row">
                  <td><img class="table-logo" src="{{ 'table-craftmix-logo.png' | asset_url }}" alt="Craftmix logo" width="180" height="34" loading="lazy"></td>
                </tr>
                <tr>
                  <td><img class="table-tick_icon" src="{{ 'green-tick.png' | asset_url }}" alt="green tick" width="44" height="36" loading="lazy"></td>
                </tr>
                <tr>
                  <td><img class="table-tick_icon" src="{{ 'green-tick.png' | asset_url }}" alt="green tick" width="44" height="36" loading="lazy"></td>
                </tr>
                <tr>
                  <td>25 or less</td>
                </tr>
                <tr>
                  <td>5g or less</td>
                </tr>
                <tr>
                  <td><img class="table-tick_icon" src="{{ 'green-tick.png' | asset_url }}" alt="green tick" width="44" height="36" loading="lazy"></td>
                </tr>
                <tr class="tall-row">
                  <td><img class="table-tick_icon" src="{{ 'green-tick.png' | asset_url }}" alt="green tick" width="44" height="36" loading="lazy"></td>
                </tr>
              </table>
            </div>



          </div>
        </div>

        <!-- Sustainability -->
        <div class="sustainability">
          <div class="sustainability-text">
            
            <h2 class="sustainability-heading">Sustainability</h2>

            <div class="sustainability-images-sm">
              <div class="sustainability-images-container-sm">
                <img src="{{ 'sustainability-img-sm.svg' | asset_url }}" alt="Craftmix Packet and Glass Bottle" class="img-craftmix-packet-sm" width="270" height="270" loading="lazy">
              </div>
            </div>

            <p class="sustainability-paragraph">Craftmix’s single-serving packets are designed to reduce plastic waste and promote fuel efficiency. Compact and lightweight, they take up less space, making shipping more efficient and environmentally friendly.</p>
          </div>
         
          <div class="sustainability-lower">
            <div class="sustainability-info">
              <div class="sustainability-card">
                <div class="img-container">
                  <img class="plastic" src="{{ 'plastic-bottle.png' | asset_url }}" alt="Plastic Bottle" width="47" height="79" loading="lazy">
                </div>
                <div class="text-box">
                  <h6>Less Plastic</h6>
                  <p>Our packaging uses 95% less plastic than traditional bottled mixers</p>
                </div>
              </div>
              <div class="sustainability-card">
                <div class="img-container">
                 <img class="chimney" src="{{ 'chimney.png' | asset_url }}" alt="Smoking Chimney" width="101" height="83" loading="lazy">
                </div>
                <div class="text-box">
                  <h6>Fewer emissions</h6>
                  <p>95% more fuel efficiency compared to traditional bottled mixers</p>
                </div>
              </div>
              <div class="sustainability-card">
                <div class="img-container">
                  <img class="waste" src="{{ 'trash-bag.png' | asset_url }}" alt="Trash Bag" width="72" height="72" loading="lazy">
                </div>
                <div class="text-box">
                  <h6>Less Plastic = Less waste</h6>
                  <p>Generating less waste helps conserve natural resources</p>
                </div>
              </div>
            </div>
            <div class="sustainability-images">
              <div class="sustainability-images-container">
                <img src="{{ 'sustainability-img-lg.svg' | asset_url }}" alt="Craftmix Packet and Glass Bottle" class="img-craftmix-packet-lg" width="500" height="500" loading="lazy">
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

{% style %}
*,
*::after,
*::before {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* img {
  width: 100%;
} */

.about-values {
  background-color: #bfefff;
  position: relative;
  /* For the lottie scroller  */
  z-index: -1;
  /* For the lottie scroller  */
}
.about-values-container {
  position: relative;
  max-width: 1100px;
  margin: 0 auto;
  padding: 70px 20px 50px 20px;
}

h2.heading,
h2.our-values-heading {
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 4rem;
  font-weight: 700;
  letter-spacing: -1.68px;
  text-align: center;
  line-height: 3.375rem;
  margin-bottom: 42px;
}
h2.sustainability-heading {
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 4rem;
  font-weight: 700;
  letter-spacing: -1.68px;
  text-align: center;
  line-height: 3.375rem;
  margin-bottom: 42px;
  position: relative;
  z-index: 1;
}
h5.subheading {
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 1.125rem;
  font-weight: 700;
  letter-spacing: 0.43px;
  text-align: center;
  line-height: 17px;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.our-values {
  margin-bottom: 72px;
}

.our-values-text p,
.sustainability-text p {
  opacity: 0.9;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 1.125rem;
  font-weight: 500;
  letter-spacing: -0.11px;
  text-align: center;
  line-height: 1.5rem;
}

.our-values-text p {
  max-width: 534px;
  margin: 0 auto;
  margin-bottom: 42px;
}

.our-values-badges {
  margin: 0 auto;
}

.badges {
  max-width: 450px;
  width: 100%;
  margin: 0 auto;
}

.badge {
  width: 100%;
  height: auto;
}

.why-craftmix {
  margin-bottom: 113px;
}

.why-craftmix-text .heading {
  margin-bottom: 80px;
}

.why-craftmix-table {
  max-width: 828px;
  margin: 0 auto;
  position: relative;
  height: auto;
}

/* LARGE TABLE */

.lg-table {
  position: relative;
  border-radius: 30px;
  border: 1.5px solid rgba(0, 38, 87, 1);
  background-color: rgba(255, 255, 255, 1);
  overflow: hidden;
  z-index: 1;
}

.lg-table table {
  width: 100%;
  height: 556px;
  border-collapse: separate;
  border-spacing: 0;
}

.lg-table th,
.lg-table td {
  width: 33.33%;
  text-align: center;
  vertical-align: middle;
  border: none;
  border-bottom: 1px solid #002657;
  height: 93.5px;
}

.lg-table tr:last-child td {
  border-bottom: none;
}

.lg-table th {
  background-color: #fff;
  font-weight: bold;
}
.lg-table tr {
  background-color: #fff;
  font-weight: bold;
}
/* SMALL TABLE */
.sm-table {
  width: 100%;
  max-width: 303px;
  margin: 0 auto;
  overflow-x: auto;
  background-color: #60d3f8;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border-radius: 30px;
  border: 1.5px solid rgba(0, 38, 87, 1);
  box-shadow: 4px 4px 0px rgba(0, 38, 87, 1);
  opacity: 1;
  z-index: 2;
}

.sm-table table {
  width: 100%;
  height: 570px;
  border-collapse: collapse;
}

.sm-table td {
  text-align: center;
  vertical-align: middle;
  border: 1px solid #002657;
}

.sm-table tr:first-child td {
  height: 97px;
}

.sm-table tr:last-child td {
  height: 97px;
}

.sm-table tr:not(:first-child):not(:last-child) td {
  height: 93.5px; /* (570px - 103px - 105px) / 4 middle rows */
}

.table-logo {
  height: 34px;
  width: auto;
  margin: 0 auto;
}
.table-tick_icon {
  height: 36px;
  width: auto;
  margin: 0 auto;
}
.table-cross_icon {
  height: 33px;
  width: auto;
  margin: 0 auto;
}
.table-minus_icon {
  height: 10px;
  width: auto;
  margin: 0 auto;
}
.table-mix_icon {
  height: 48px;
  width: auto;
  margin: 0 auto;
}

.lg-table td,
.sm-table td {
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -0.13px;
  text-align: center;
  line-height: 20px;
}

.sustainability {
  margin-bottom: 98px;
}

.sustainability-lower {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.sustainability-text p {
  max-width: 424px;
  margin: 0 auto;
}

.sustainability-text {
  margin-bottom: 60px;
}
.sustainability-card {
  background-color: #bfefff;
  display: flex;
  flex-direction: row;
  border-radius: 30px;
  border: 1.5px solid rgba(0, 38, 87, 1);
  max-width: 437px;
  margin-bottom: 20px;
  min-height: 146px;
}

.sustainability-card .text-box {
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
}

.sustainability-card .text-box h6 {
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.58px;
  text-align: left;
  line-height: 30px;
}
.sustainability-card .text-box p {
  opacity: 0.9;
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 500;
  letter-spacing: -0.11px;
  text-align: left;
  line-height: 24px;
}

.sustainability-card .text-box {
  padding: 20px;
}

.sustainability-card .img-container {
  display: flex;
  justify-content: center; 
  align-items: center; 
  flex-shrink: 0; /* Prevents the image container from shrinking */
}

.sustainability-card .img-container .plastic {
  width: auto;
  padding: 29px 0px 29px 29px;
}
.sustainability-card .img-container .chimney {
  width: auto;
  padding: 29px 0px 29px 18px; 
}
.sustainability-card .img-container .waste {
  width: auto;
  margin-left: 0px;
  padding: 29px 0px 29px 29px; 
}



.sustainability-images-sm {
  display: none;
}


.sustainability-images-container {
  display: flex;
  justify-content: center;
  align-items: center;
}

.img-craftmix-packet-lg {
  height: 500px;
  width: auto;
  position: relative; 
  z-index: 2; 
}




