<script>
  document.addEventListener('DOMContentLoaded', () => {
    const selectors = document.querySelectorAll('.nutrition-card-selector');
    const containers = document.querySelectorAll('.nutrition-facts-container');

    selectors.forEach(button => {
      button.addEventListener('click', () => {
        // remove selected from all buttons
        selectors.forEach(btn => btn.classList.remove('selected'));

        // remove active from all containers
        containers.forEach(container => container.classList.remove('active'));

        // add selected to clicked button
        button.classList.add('selected');

        // find the shared product slug
        const slugClass = Array.from(button.classList)
          .find(cls => cls.endsWith('-nutrition-card-selector'));

        if (!slugClass) return;

        const slug = slugClass.replace('-nutrition-card-selector', '');

        // activate the matching container
        const target = document.querySelector(
          `.${slug}-nutrition-facts-container`
        );

        if (target) {
          target.classList.add('active');
        }
      });
    });
  });
</script>

{% javascript %}
// // Flavor Bar
document.addEventListener('DOMContentLoaded', function () {
  const flavorBars = document.querySelectorAll('.flavor-bar');

  flavorBars.forEach(flavorBar => {
    let sweetnessPercentage = parseInt(flavorBar.dataset.flavor, 10) || 0;

    // Clamp to 0–100
    sweetnessPercentage = Math.max(0, Math.min(100, sweetnessPercentage));

    setFlavorRange(flavorBar, sweetnessPercentage);
  });
});

function setFlavorRange(flavorBar, percentage) {
  const fillElement = flavorBar.querySelector('.flavor-range-fill');
  const iconElement = flavorBar.querySelector('.flavor-icon');
  
  if (fillElement && iconElement) {
    fillElement.style.width = `${percentage}%`;
    iconElement.style.left = `${percentage}%`;
  }
}

