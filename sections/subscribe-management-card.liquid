{% style %}
  *,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

ul {
  list-style: none;
}

a {
  text-decoration: none;
}

img {
  max-width: 100%;
}

.custom-management-card-section {
  padding-top: 50px;
  padding-bottom: 100px;
  background-color: #bfefff;
}

.custom-management-card-section-container {
  max-width: 1400px;
  padding: 0 45px;
  margin: 0 auto;
}

.subscription-management-card {
  max-width: 1300px;
  min-height: 564px;
  background-color: #ffffff;
  border-radius: 30px;
  box-shadow: 10px 10px 20px rgba(0, 0, 0, 0.13);
  overflow: hidden;
  margin: 0 auto;
  /* padding: 20px; */
}

.subscription-management-card .card-content {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.subscription-management-card .text-box {
  max-width: 400px;
  min-height: 564px;
  padding-top: 66px;
  padding-left: 50px;
  padding-bottom: 50px;
  /* padding-right: auto; */
}

.subscription-management-card .text-box h2 {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 40px;
  font-weight: 700;
  font-style: Bold;
  letter-spacing: -1.05px;
  text-align: left;
  line-height: 46px;
  margin-bottom: 30px;
}
.subscription-management-card .text-box p {
  opacity: 0.9;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 500;
  font-style: Medium;
  letter-spacing: -0.11px;
  text-align: left;
  line-height: 24px;
  margin-bottom: 30px;
}
.subscription-management-card .text-box ul li {
  display: flex;
  flex-direction: row;
  align-items: center;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 15px;
  font-weight: 600;
  font-style: SemiBold;
  letter-spacing: -0.09px;
  text-align: left;
  line-height: 16px;
  margin-bottom: 10px;
}

.subscription-management-card .text-box ul li .list-icon {
  width: 23px;
  height: 23px;
  margin-right: 10px;
}

.subscription-management-card .img-box {
  max-width: 750px;
  min-height: 100%;
  border-radius: 30px;
  margin: 15px;
  border: 1.5px solid rgba(0, 38, 87, 1);
  background-color: rgba(0, 169, 224, 1);
  overflow: hidden;
  opacity: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.subscription-management-card-cta {
  display: inline-block;
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 20px;
  font-weight: 600;
  font-style: SemiBold;
  letter-spacing: -0.13px;
  text-align: center;
  line-height: 20px;
  border-radius: 33px;
  border: 1.5px solid rgba(0, 38, 87, 1);
  box-shadow: 2px 6px 0px rgba(0, 38, 87, 1);
  opacity: 1;
  background-color: rgba(96, 211, 248, 1);
  padding: 20px 35px;
  margin-top: 50px;
}

.img-box img {
  height: 100%;
  width: auto;
  object-fit: cover;
}

@media screen and (max-width: 1100px) {
  .custom-management-card-section-container {
    padding: 0 25px;
  }
}
@media screen and (max-width: 1050px) {
  .custom-management-card-section {
    padding-top: 75px;
    padding-bottom: 75px;
  }
  .custom-management-card-section-container {
    padding: 0 25px;
  }
  .subscription-management-card .card-content {
    display: flex;
    flex-direction: column-reverse;
  }
  .subscription-management-card {
    max-width: 800px;
    height: auto;
    padding: 10px;
  }

  .subscription-management-card .img-box {
    max-width: 800px;
    margin: 0px;
  }

  .subscription-management-card .text-box {
    max-width: 400px;
    min-height: 100%;
    padding-top: 12px;
    padding-left: 10px;
    padding-bottom: 40px;
    margin-top: 20px;
  }
}

{% endstyle %}

{% schema %}
  {
    "name": "subscribe management card",
    "settings": [],
    "presets": [
      {
        "name": "subscribe management card"
      }
    ]
  }
{% endschema %}