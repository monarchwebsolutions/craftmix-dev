{% schema %}
{
  "name": "Variety Lander Nutrition",
  "tag": "section",
  "class": "landing-page-nutrition",
  "settings": [],
  "presets": [
    {
      "name": "Variety Lander Nutrition"
    }
  ]
}
{% endschema %}

<section class="landing-page-nutrition">
  <!-- Background Images -->
  <img class="lp-bg-img pinkleaf-2" src="https://cdn.shopify.com/s/files/1/2340/1623/files/lp-bg-pinkleaf-2.png?v=1744316162" width="229" height="577" alt="Pink leaf" role="presentation" loading="lazy">
  <img class="lp-bg-img lime-1" src="https://cdn.shopify.com/s/files/1/2340/1623/files/lp-bg-lime-1.png?v=1744316308" width="229" height="577" alt="Lime" role="presentation" loading="lazy">
  <img class="lp-bg-img mango-2" src="https://cdn.shopify.com/s/files/1/2340/1623/files/lp-bg-mango-2.png?v=1744316510" width="229" height="577" alt="Mango" role="presentation" loading="lazy">
  <img class="lp-bg-img pinkleaf-3" src="https://cdn.shopify.com/s/files/1/2340/1623/files/lp-bg-pinkleaf-3.png?v=1744316199" width="229" height="577" alt="Pink leaf" role="presentation" loading="lazy">
   <div class="section-wave-container lottie-player rotated-wave">
      <lottie-player class="section-wave" src="{{ 'lp-Wave-divider-right-to-left-light-blue-2400px.json' | asset_url }}" background="transparent"  speed="1"  loop autoplay></lottie-player>
    </div>
  <div class="landing-page-nutrition-section-wrapper">

    <div class="whats-in-a-craftmix-card">
      <div class="whats-in-a-craftmix-card-image-container">
        <img class="whats-in-a-craftmix-card-image" src="https://cdn.shopify.com/s/files/1/2340/1623/files/lp-whats-in-craftmix.png?v=1744241173" width="508" height="590" alt="Craftmix drink mix packet being poured into a glass" loading="lazy">
      </div>
      <div class="whats-in-a-craftmix-card-text-container">
        <h2>What's in Craftmix?</h2>
        <p>We thought you'd never ask! We pride ourselves on using only the best ingredients for the best customers (you!)</p>
        <p>Our products are crafted with real fruit juice powders! In addition to what's listed below, our products are also low sugar, dairy free, fat free, soy free, and cholesterol free, so that you can enjoy conscious free!</p>
        <a href="/pages/about-us">Learn more</a>
      </div>
    </div>
  </div>

  <div class="nutrition-cards-section">
    <h2 class="nutrition-cards-heading">Nutrition Facts</h2>
    <!-- DESKTOP GRID -->
    <div class="nutrition-cards-grid">
      <div class="nutrition-cards-container">
        {% assign main_product = page.metafields.custom.main_product.value %}
        {% if main_product and main_product.metafields.custom.variety_pack_products != blank %}
          {% assign variety_products = main_product.metafields.custom.variety_pack_products.value %}
          {% for p in variety_products %}
            {% assign card_image = p.metafields.custom.nutrition_card.value %}
            {% if card_image %}
              <img
                class="nutrition-card"
                src="{{ card_image | image_url: width: 512 }}"
                width="256"
                height="290"
                alt="{{ p.title }} nutrition card"
                loading="lazy"
              >
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
    </div>


   <!-- MOBILE CAROUSEL -->
    <div class="nutrition-cards-carousel embla">
      <div class="embla__viewport">
        <div class="embla__container">
          {% assign main_product = page.metafields.custom.main_product.value %}
          {% if main_product and main_product.metafields.custom.variety_pack_products != blank %}
            {% assign variety_products = main_product.metafields.custom.variety_pack_products.value %}
            {% for p in variety_products %}
              {% assign card_image = p.metafields.custom.nutrition_card.value %}
              {% if card_image %}
                <div class="nutrition-card embla__slide">
                  <img
                    src="{{ card_image | image_url: width: 756 }}"
                    width="378"
                    height="429"
                    alt="{{ p.title }} nutrition card"
                    loading="lazy"
                  >
                </div>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <div class="lp-copyright"><span>&copy</span>Craftmix Inc. All Rights Reserved</div>
  <div class="lp-craftmix-footer_logo">
    <img src="https://cdn.shopify.com/s/files/1/2340/1623/files/lp-craftmix-footer__logo.png?v=1744326199" width="864" height="161" alt="Purple Craftmix Logo" role="presentation" loading="lazy">
  </div>
</section>
<script src="{{ 'lp-embla.js' | asset_url }}" defer='defer'></script>
{% javascript %}
 
  document.addEventListener('DOMContentLoaded', () => {
    const emblaRoot = document.querySelector('.nutrition-cards-carousel');
    if (!emblaRoot) return;

    const viewport = emblaRoot.querySelector('.embla__viewport');
    EmblaCarousel(viewport, {
      dragFree: true,
      loop: true
    });
  });

{% endjavascript %}
{% stylesheet %}
  *,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

a {
  text-decoration: none;
}

img {
  max-width: 100%;
}

section.landing-page-nutrition {
  background-color: #c9eefd;
  padding: 0px 0px 48px 0px;
  position: relative;
}

.landing-page-nutrition-section-wrapper {
  margin: 0 auto;
  max-width: 1400px;
  padding: 50px 20px;
  overflow: hidden;
}

.why-join-craftmix-club-card,
.whats-in-a-craftmix-card {
  max-width: 1200px;
  position: relative;
  padding: 48px;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 auto;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  border-radius: 38px;
  background-color: #fff;
  margin-bottom: 50px;
  z-index: 2;
}

.why-join-craftmix-club-card {
  flex-direction: row;
}
.whats-in-a-craftmix-card {
  flex-direction: row-reverse;
}

.why-join-craftmix-club-card-image-container,
.whats-in-a-craftmix-card-image-container {
  max-width: 508px;
  width: 100%;
  height: auto;
  flex-shrink: 0;
}
.why-join-craftmix-club-card-text-container,
.whats-in-a-craftmix-card-text-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48px;
  gap: 32px;
  flex: 1 0 0;
}

.why-join-craftmix-club-card-text-container h2,
.whats-in-a-craftmix-card-text-container h2 {
  font-family: 'Hornbill';
  font-weight: 800;
  font-size: 72px;
  line-height: 79px;
  letter-spacing: -0.03em;
  color: #002657;
}

.why-join-craftmix-club-card-text-container p,
.whats-in-a-craftmix-card-text-container p {
  font-family: 'Goldplay';
  font-weight: 500;
  font-size: 25px;
  line-height: 35px;
  color: #002657;
}

.why-join-craftmix-club-card-text-container p span {
  font-family: 'Goldplay';
  font-weight: 800;
  font-size: 25px;
  line-height: 35px;
  color: #002657;
}

.why-join-craftmix-club-card-text-container a,
.whats-in-a-craftmix-card-text-container a {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 16px 12px;
  gap: 3px;
  font-family: 'Goldplay';
  font-size: 22px;
  text-transform: uppercase;
  font-weight: 600;
  line-height: 140%;
  max-width: 492px;
  width: 100%;
  height: 69px;
  background: #fe6b00;
  color: #fff;
  border: 2px solid #000000;
  box-shadow: 4px 4px 0px #000000;
  border-radius: 100px;
  /* Inside auto layout */
  flex: none;
  order: 1;
  flex-grow: 0;
  transition: box-shadow 0.4s ease; 
}

.why-join-craftmix-club-card-text-container a:hover,
.whats-in-a-craftmix-card-text-container a:hover {
  box-shadow: none;
}

.nutrition-cards-heading {
  font-family: 'Hornbill';
  font-style: normal;
  font-weight: 800;
  font-size: 72px;
  line-height: 86px;
  text-align: center;
  letter-spacing: -0.03em;
  color: #002657;
  margin-bottom: 40px;
}

/* Show grid on desktop, hide carousel */
.nutrition-cards-grid {
  display: block;
}

.nutrition-cards-carousel {
  display: none;
}

.nutrition-cards-container {
  max-width: 1370px;
  width: 100%;
  margin: 0 auto 140px;
  padding: 12px;
  display: grid;
  grid-template-columns: repeat(auto-fit, 256px);
  gap: 12px;
  justify-content: center;
}

.nutrition-cards-container img {
  max-width: 256px;
  height: auto;
  display: block;
}

.lp-copyright {
  margin: 0 auto;
  text-align: center;
}

.lp-craftmix-footer_logo {
  max-width: 896px;
  margin: 75px auto;
  padding: 0 16px;
}

.craftmix-footer_logo img {
  width: 100%;
}

/* Rotate the  wave */
.rotated-wave .section-wave {
  transform: rotate(180deg);
}

.rotated-wave {
    bottom: 2px;
}

/* Background Fruits */
.lp-bg-img {
  position: absolute;
  z-index: 2;
}

/* left */
.lp-bg-img.pinkleaf-2 {
  top: 85px;
  left: 0;
}
.lp-bg-img.lime-1 {
  top: 310px;
  left: -100px;
}
.lp-bg-img.coconut-1 {
  top: 870px;
  left: 0;
}
.lp-bg-img.passionfruit-1 {
  top: 1000px;
  left: 0;
}
/* right */
.lp-bg-img.mango-2 {
  top: 90px;
  right: -20px;
}
.lp-bg-img.pinkleaf-3 {
  top: 430px;
  right: 0;
}
.lp-bg-img.palmtree-1 {
  top: 910px;
  right: 0;
}

@media (max-width: 1270px) {
  .why-join-craftmix-club-card-text-container {
    padding: 0 0 0 48px;
    gap: 24px;
  }
  .whats-in-a-craftmix-card-text-container {
    padding: 0 48px 0 0;
    gap: 24px;
  }
  .why-join-craftmix-club-card-text-container h2,
  .whats-in-a-craftmix-card-text-container h2 {
    font-size: 55px;
    line-height: 120%;
  }
}
@media (max-width: 1120px) {
  .why-join-craftmix-club-card-text-container h2,
  .whats-in-a-craftmix-card-text-container h2 {
    font-size: 40px;
    line-height: 120%;
  }
  .why-join-craftmix-club-card-text-container p,
  .whats-in-a-craftmix-card-text-container p {
    font-size: 20px;
    line-height: 140%;
  }
  .why-join-craftmix-club-card-text-container p span {
    font-size: 20px;
    line-height: 140%;
  }
}

@media (max-width: 1068px) {
  .why-join-craftmix-club-card-image-container,
  .whats-in-a-craftmix-card-image-container {
    max-width: 600px;
    width: 100%;
  }
  .why-join-craftmix-club-card,
  .whats-in-a-craftmix-card {
    max-width: 600px;
    flex-direction: column;
    padding: 24px;
    gap: 20px;
  }
  .why-join-craftmix-club-card-text-container {
    padding: 0;
    gap: 24px;
  }
  .whats-in-a-craftmix-card-text-container {
    padding: 0;
    gap: 24px;
  }
}

@media (max-width: 529px) {
  .why-join-craftmix-club-card,
  .whats-in-a-craftmix-card {
    position: relative;
    padding: 24px;
    display: flex;
    gap: 20px;
    margin: 0 auto;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    border-radius: 20px;
    background-color: #fff;
    margin-bottom: 50px;
  }
  .whats-in-a-craftmix-card {
    margin-bottom: 0;
  }
  .why-join-craftmix-club-card-text-container,
  .whats-in-a-craftmix-card-text-container {
    align-items: flex-start;
  }
  .why-join-craftmix-club-card-text-container h2,
  .whats-in-a-craftmix-card-text-container h2 {
    text-align: left;
    font-size: 32px;
    line-height: 120%;
    letter-spacing: -0.96px;
  }

  .why-join-craftmix-club-card-text-container a,
  .whats-in-a-craftmix-card-text-container a {
    padding: 12px 8px;
    max-width: 492px;
    width: 100%;
    height: 50px;
    font-family: 'Goldplay';
    font-size: 18px;
  }

  .nutrition-cards-heading {
    font-family: 'Hornbill';
    font-style: normal;
    font-weight: 800;
    font-size: 32px;
    line-height: 120%;
    text-align: center;
    letter-spacing: -0.03em;

    margin-bottom: 17px;
  }

  /* Flip visibility on small screens */

  .nutrition-cards-grid {
    display: none;
  }

  .nutrition-cards-carousel {
    display: block;
  }

  .embla__container {
    display: flex;
    gap: 12px;
  }

  .embla__slide {
    flex: 0 0 85%;
    scroll-snap-align: start;
  }

  .nutrition-card:last-of-type {
    margin-right: 12px;
  }

}


@media (max-width: 860px) {
/* left */
.lp-bg-img.pinkleaf-2 {
  top: 110px;
  left: 0;
  height: 300px;
  width: auto;
}
.lp-bg-img.lime-1 {
  top: 530px;
  left: -100px;
  height: 300px;
  width: auto;
}
.lp-bg-img.coconut-1 {
  top: 1200px;
  left: 0;
   height: 300px;
  width: auto;
}
.lp-bg-img.passionfruit-1 {
  top: 1430px;
  left: 0;
  height: 380px;
  width: auto;
}
/* right */
.lp-bg-img.mango-2 {
  top: 300px;
  right: -20px;
  height: 250px;
}
.lp-bg-img.pinkleaf-3 {
  top: 580px;
  right: 0;
  height: 275px;
  width: auto;
}
.lp-bg-img.palmtree-1 {
  top: 1260px;
  right: 0;
  height: 400px;
  width: auto;
}

}

{% endstylesheet %}


