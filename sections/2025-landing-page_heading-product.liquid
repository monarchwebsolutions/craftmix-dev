{% schema %}
{
  "name": "Landing Page Main",
  "settings": [],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}
section.landing-page-main {
  background-color: #ddf7f7;
  position: relative;
}

/* Hide carousel by default (desktop/tablet) */
.image-carousel-wrapper {
  display: none;
}

.lp-main-wrapper {
  max-width: 1400px;
  padding: 80px 20px 50px 20px;
  margin: 0 auto;
}

.flex-container {
  display: flex;
  flex-direction: row;
  align-items: start;
  justify-content: space-between;
  gap: 74px;
  margin-bottom: 100px;
}

.flex-item-left {
  width: 100%;
  display: flex;
  max-width: 776px;
  align-items: flex-start;
  align-content: flex-start;
  gap: 20px;
  flex-wrap: wrap;
}

.flex-item-right {
  max-width: 512px;
  width: 100%;
}

.lp_image_carousel_embla__viewport {
  overflow: hidden;
  width: 100%;
}

.lp_image_carousel_embla__container {
  display: flex;
  gap: 12px;
}

.lp_image_carousel_embla__slide {
  flex: 0 0 auto;
  height: auto;
  scroll-snap-align: center;
}
.lp_image_carousel_embla__slide:last-of-type {
  margin-right: 12px;
}
.small-img-container {
  border: 1px solid #002657;
  border-radius: 20px;
  overflow: hidden;
  width: 250px;
  height: 260px;
}
  
.lp-carousel-image {
  width: 100%;
  height: auto;
  display: block;
}

.img-lg-container {
  width: 100%;
  max-width: 774px;
  position: relative;
}


.img-wrapper-lg img {
  width: 100%;
  height: auto;
  display: block;
}

.imgs-sm-container {
  max-width: 776px;
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 17.839px;
  justify-content: space-between;
}

.img-wrapper-sm {
  width: calc(50% - 8.9195px);
  max-width: 379px;
  max-height: 401px;
  border: 2px solid #000; 
  border-radius: 26px;
  overflow: hidden;
}

.img-wrapper-sm img {
  width: 100%;
  height: auto;
  display: block;
}

.img-wrapper-lg,
.img-wrapper-sm {
  position: relative;
  border: 2px solid #002657;
  border-radius: 26px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-wrapper-lg {
  max-width: 774px;
  max-height: 710px;
  width: 100%;
  aspect-ratio: 774 / 710;
}

.img-wrapper-sm {
  max-width: 379px;
  max-height: 401px;
  width: calc(50% - 8.9195px);
  aspect-ratio: 379 / 401;
}

.img-wrapper-lg img,
.img-wrapper-sm img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.lp-main-prev-btn,
.lp-main-next-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  z-index: 10;
  background-color: transparent;
  width: 62px;
  height: 62px;
}

.lp-main-prev-btn{
  left: 24px;
}

.lp-main-next-btn {
  right: 24px;
}

.lp-main-prev-btn img {
  transform: scaleX(-1);
}



.reviews {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
}

.reviews .review-stars {
  height: 22px;
}
.reviews .review-text {
  color: #002657;
  font-size: 22px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 30.8px;
}

h1.heading-text {
  color: #002657;
  font-size: 58px;
  font-family: Hornbill;
  font-weight: 900;
  line-height: 69.6px;
  margin-bottom: 24px;
}

p.paragraph-text {
  color: #002657;
  font-size: 24px;
  font-family: Goldplay;
  font-weight: 500;
  line-height: 33.6px;
  margin-bottom: 24px;
}

.buy-option-container {
  display: flex;
  flex-direction: column; 
  border-radius: 18px;
  border: 2px solid rgba(0, 38, 87, 0.1);
  background: rgba(255, 255, 255, 0.7);
  margin-bottom: 24px;
  cursor: pointer;
  overflow: hidden;
}

.buy-option-row {
  display: flex;
  flex-direction: row; /* row layout for the main content */
  align-items: flex-start;
  justify-content: space-between;
  padding: 16px 20px;
}
  
.buy-option-container-lg {
  border-radius: 18px;
  margin-bottom: 8px;
  border: 2px solid rgba(0, 38, 87, 0.1);
  overflow: hidden;
  cursor: pointer;
}

.buy-option-container-lg-product {
  display: flex;
  padding: 16px 20px;
  flex-direction: row;
  align-items: start;
  justify-content: space-between;
  background: rgba(255, 255, 255, 1);
  cursor: pointer;
  gap:2px;
}

.sale-bar {
  background-color: #7fd0f4;
  padding: 4px 10px;
  text-align: center;
  border-bottom: 2px solid rgba(0, 38, 87, 0.1)
}

.sale-bar-text {
  color: #002657;
  font-size: 24px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 28.8px;
}

.buy-option-container.selected,
.buy-option-container-lg.selected {
  border: 2px solid rgba(0, 38, 87, 1); 
}

.buy-option-container.selected .sale-bar,
.buy-option-container-lg.selected .sale-bar {
  border-bottom: 2px solid rgba(0, 38, 87, 1);
}

.buy-option-container-lg-footer {
  background: rgba(255, 255, 255, 1);
  padding: 0px 20px 16px 20px;
}

.club-benifits-items {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.club-benifits img {
  margin-right: 5px;
}

.club-benifits-items img {
  height: 10px;
  width: 17px;
}
.club-benifits span {
  color: #000;
  font-size: 20px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 28px;
}
.club-benifits-top,
.club-benifits-bottom {
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  gap: 24px;
}

.buy-option-info .product-name {
  color: #002657;
  font-size: 30px;
  font-family: Hornbill;
  font-weight: 800;
  line-height: 36px;
}
.buy-option-info .product-contents {
  color: #fe6b00;
  font-size: 20px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 28px;
}

.buy-option-pricing {
  display: flex;
  flex-direction: column;
}

.buy-option-pricing-comparison {
  display: flex;
  flex-direction: row;
  gap: 3px;
}

.buy-option-pricing-comparison-before {
  color: #002657;
  font-size: 26px;
  font-family: Goldplay;
  font-weight: 600;
  text-decoration: line-through;
  line-height: 31.2px;
  opacity: 0.4;
}
.buy-option-pricing-comparison-after {
  color: #002657;
  font-size: 26px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 31.2px;
}

.buy-option-pricing-per-drink-text {
  color: #002657;
  font-size: 20px;
  font-family: Goldplay;
  font-weight: 600;
  text-transform: uppercase;
  line-height: 28px;
  text-align: right;
  opacity: 0.4;
}

input[type="radio"] {
  appearance: none;
  -webkit-appearance: none;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 2px solid #002657;
  display: inline-block;
  position: relative;
  background: white;
  cursor: pointer;
}

input[type="radio"]::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12px; 
  height: 12px;
  background-color: #002657;
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.2s ease;
}

input[type="radio"]:checked::after {
  opacity: 1;
}

.buy-button {
  font-family: 'Goldplay';
  font-weight: 600;
  font-size: 22px;
  line-height: 140%;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 16px 12px;
  gap: 3px;
  max-width: 492px;
  width: 100%;
  height: 69px;
  background: #fe6b00;
  color: #fff;
  border: 2px solid #000000;
  box-shadow: 4px 4px 0px #000000;
  transition: box-shadow 0.4s ease;
  border-radius: 100px;
  margin: 0 auto;
  text-transform: uppercase;
  cursor: pointer;
  flex: none;
  order: 1;
  flex-grow: 0;
}

.buy-button:hover {
  box-shadow: none;
}

.flavor-container {
  margin: 24px 0px;
  padding: 16px 0px;
  max-width: 100%;
}

.flavor-heading {
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 24px;
  font-weight: 700;
  letter-spacing: 0.3px;
  text-align: left;
  line-height: 18px;
  margin-bottom: 10px;
}

/* FLAVOR GRID SMALL */
.flavor-card-grid-single-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
  justify-content: center;
  place-items: center;
  gap: 16px;
}



.flavor-card-single {
  width: 110px;
  height: 156px;
  border-radius: 12px;
  overflow: hidden;
}

.flavor-card-single-image-container {
  width: 110px;
  height: 112px;
  background-color: #fff;
  border-radius: 12px;
  border: 1.5px solid rgba(0, 38, 87, 0.08);
  padding: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flavor-card-single-image {
  width: 100%;
  height: auto;
}

.flavor-card-single-heading {
  font-family: 'Goldplay';
  font-size: 15px;
  font-weight: 600;
  text-align: center;
  line-height: 16px;
  padding-top: 10px;
}
/* END FLAVOR GRID SMALL */

/* FLAVOR GRID LARGE */
.flavor-card-grid-double-row {
  display: grid;
   grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
  justify-content: center;
  place-items: center;
  gap: 10px;
}

.flavor-card-double {
  width: 90px;
  height: 130px;
  border-radius: 12px;
  overflow: hidden;
}

.flavor-card-double-image-container {
  width: 90px;
  height: 90px;
  background-color: #fff;
  border-radius: 12px;
  border: 1.5px solid rgba(0, 38, 87, 0.08);
  padding: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flavor-card-double-image {
  width: 100%;
  height: auto;
}

.flavor-card-double-heading {
  font-family: 'Goldplay';
  font-size: 12px;
  font-weight: 600;
  text-align: center;
  line-height: 16px;
  padding-top: 10px;
}
/* END FLAVOR GRID LARGE */

/* FOR GRID DISPLAY WITH JS */
.flavor-card-grid-single-row {
  display: none;
}

.flavor-card-grid-single-row.active,
.flavor-card-grid-double-row.active {
  display: grid;
}  
/* END GRID DISPLAY WITH JS */  
  
.faq-container {
  max-width: 492px;
  width: 100%;
}

.faq-question-body {
  margin-bottom: 24px;
}

.faq-answer {
  display: none;
  margin-top: 8px;
}

.faq-question h6 {
  color: #002657;
  font-size: 24px;
  font-family: Goldplay;
  font-weight: 600;
  line-height: 28.8px;
}

.faq-answer p {
  color: #002657;
  font-size: 20px;
  font-family: Goldplay;
  font-weight: 500;
  line-height: 28px;
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
}

.faq-icon::before {
  content: '+';
  font-size: 18px;
  transition: transform 0.2s ease;
}

/* when open */
.faq-question.open + .faq-answer {
  display: block;
}

.faq-question.open .faq-icon::before {
  content: '−'; 
}

.landing-page-heading-section-marquee {
  position: absolute;
   top: auto !important;
  bottom: -50% !important;
  z-index:1;
  pointer-events: none;
  height:revert-layer !important;
}

/* Hide carousel by default (desktop/tablet) */
.image-carousel-wrapper {
  display: none;
}
.buy-options-wrapper [class*="buy-option-container"],
.buy-options-wrapper .buy-option-row{
  background-color:#f5fdfd;
}
.buy-options-wrapper .selected [class*="buy-option-container"],
.buy-options-wrapper .selected .buy-option-row{
  background-color:white !important;
}
@media (max-width: 1040px) {
  .flex-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom:40px;
  }
}
@media (max-width: 829px) {
  .flex-item-right,
  .flex-item-left {
    max-width: 492px;
  }
}


@media (max-width: 768px) {
  input[type="radio"] {
    width: 15px;
    height: 15px;
  }

  input[type="radio"]::after {
    width: 8px;
    height: 8px;
  }
}
/* Show on mobile */
@media (max-width: 529px) {
  .img-lg-container,
  .imgs-sm-container {
    display: none;
  }

  .image-carousel-wrapper {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin: 0; 
    padding: 24px 16px 0px 16px;
  }

  .image-carousel-wrapper::-webkit-scrollbar {
    display: none;
  }

  .lp-image-carousel {
    display: flex;
    gap: 12px;
    scroll-snap-type: x mandatory;
    margin-right: 16px;
  }

  .lp-carousel-image {
    flex: 0 0 auto;
    height: 260px;
    width: auto;
    scroll-snap-align: center;
    object-fit: cover;
  }

  .lp-main-wrapper {
    padding: 25px 16px;
    margin: 0 auto;
  }

  .flex-container {
    gap: 0px;
  }

  .reviews .review-stars {
    height: 16px;
  }

  .reviews .review-text {
    font-size: 16px;
    line-height: 140%;
  }

  h1.heading-text {
    color: #002657;
    font-size: 40px;
    font-family: Hornbill;
    font-weight: 900;
    line-height: 120%;
    margin-bottom: 16px;
  }

  p.paragraph-text {
    font-size: 18px;
    line-height: 140%;
    margin-bottom: 16px;
  }

  .buy-option-row,
  .buy-option-container-lg-product {
    padding: 11px 14px;
  }

  .buy-option-info .product-name {
    font-size: 20px;
    line-height: 120%;
  }
  .buy-option-info .product-contents {
    font-size: 14px;
    line-height: 140%;
  }

  .buy-option-pricing {
    display: flex;
    flex-direction: column;
  }

  .buy-option-pricing-comparison {
    display: flex;
    flex-direction: row;
    gap: 9px;
  }

  .buy-option-pricing-comparison-before {
    color: #002657;
    font-size: 18px;
    font-family: Goldplay;
    font-weight: 600;
    text-decoration: line-through;
    line-height: 120%;
    opacity: 0.4;
  }
  .buy-option-pricing-comparison-after {
    color: #002657;
    font-size: 18px;
    font-family: Goldplay;
    font-weight: 600;
    line-height: 120%;
  }

  .buy-option-pricing-per-drink-text {
    font-size: 14px;
    line-height: 140%;
  }

  .sale-bar {
    padding: 4px 10px;
  }

  .sale-bar-text {
    font-size: 16px;
    line-height: 120%;
  }

  .buy-option-container-lg-footer {
    background: rgba(255, 255, 255, 1);
    padding: 0px 16px 11px 16px;
  }

  .club-benifits-top,
  .club-benifits-bottom {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    gap: 16px;
  }

  .club-benifits-items img {
    width: 12px;
    height: 7px;
  }

  .club-benifits span {
    font-size: 14px;
    line-height: 140%;
  }

  .buy-button {
    font-size: 18px;
    line-height: 140%;
    padding: 11px 8px;
    gap: 3px;
    max-width: 492px;
    width: 100%;
    height: 50px;
  }

  .flavor-heading {
    font-size: 16px;
    line-height: 120%;
    margin-bottom: 20px;
    text-align: center;
  }

  .faq-question h6 {
    font-size: 18px;
    line-height: 120%;
  }

  .faq-answer p {
    font-size: 16px;
    line-height: 140%;
  }
}

@media screen and (max-width:399px){
    .buy-option-info .product-name {
      font-size: 18px;
    }
    .buy-option-info .product-contents{
      font-size:12px;
    }
  }
{% endstyle %}

<section class="landing-page-main">
  <div class="image-carousel-wrapper embla">
    <div class="lp_image_carousel_embla__viewport">
      <div class="lp_image_carousel_embla__container">
        <div class="lp_image_carousel_embla__slide small-img-container">
          <img class="lp-carousel-image"
            src="https://cdn.shopify.com/s/files/1/2340/1623/files/landing-page-img_1.png?v=1746201247" alt="Row of Craftmix Coctails in glasses" width="248" height="260">
        </div>
        <div class="lp_image_carousel_embla__slide small-img-container">
          <img class="lp-carousel-image"
            src="https://cdn.shopify.com/s/files/1/2340/1623/files/landing-page-img_7.jpg?v=1746201408" alt="Craftmix Packs on a picnic blanket" width="248" height="260">
        </div>
        <div class="lp_image_carousel_embla__slide small-img-container">
          <img class="lp-carousel-image"
            src="https://cdn.shopify.com/s/files/1/2340/1623/files/landing-page-img_10.jpg?v=1746200825" alt="Craftmix variety pack and cocktails on a picnic table" width="248" height="260">
        </div>
        <div class="lp_image_carousel_embla__slide small-img-container">
          <img class="lp-carousel-image"
            src="https://cdn.shopify.com/s/files/1/2340/1623/files/landing-page-img_6.jpg?v=1746201033" alt="Mint mojito cocktail" width="248" height="260">
        </div>
        <div class="lp_image_carousel_embla__slide small-img-container">
          <img class="lp-carousel-image"
            src="https://cdn.shopify.com/s/files/1/2340/1623/files/landing-page-img_8.png?v=1746200967" alt="Friends enjoying cocktails" width="248" height="260">
        </div>
      </div>
    </div>
  </div>

  <div class="lp-main-wrapper ">
    <div class="flex-container">
      <div class="flex-item-left">
        {% assign raw = page.metafields.custom.photos %}
        {% assign cleaned = raw 
          | remove: '[' 
          | remove: ']' 
          | remove: '"' 
        %}
        {% assign image_urls = cleaned | split: ',' %}
        <div class="img-lg-container">
          <div id="lander-featured-image" class="img-wrapper-lg">
            <img src="{{ image_urls[0] }}"
              alt='A variety of colorful cocktails in different glasses with fruit garnishes are displayed on a light blue background; text reads “60 Drinks, 10 Flavors.”.' width="770" height="706">
            </div>
            <button class="lp-main-prev-btn" aria-label="Previous slide">
              <img src="{{ 'lp-carousel-btn.svg' | asset_url }}" alt="Left facing arrow icon inside circle" width="62" height="62">
            </button>

            <button class="lp-main-next-btn" aria-label="Next slide">
              <img src="{{ 'lp-carousel-btn.svg' | asset_url }}" alt="Right facing arrow icon inside circle" width="62" height="62">
            </button>
          </div>
       <div class="imgs-sm-container">
          <div class="img-wrapper-sm"><img
              src="{{ image_urls[1] }}"
              alt='A Craftmix Variety 60 Pack with individual drink mix packets in assorted flavors displayed in front of the main package.' width="770" height="706"></div>
          <div class="img-wrapper-sm"><img
              src="{{ image_urls[2] }}"
              alt="Craftmix cocktail drink mixes with colorful drinks and fresh fruit garnishes on a pink marble background." width="770" height="706"></div>
          <div id="lander-image-4" class="img-wrapper-sm"><img
              src="{{ image_urls[3] }}"
              alt="Group of friends holding colorful Craftmix cocktails in blue cups with striped straws, featuring fresh garnishes and a Craftmix Variety Pack pouch." width="770" height="706"></div>
          <div class="img-wrapper-sm"><img
              src="{{ image_urls[4] }}"
              alt="Craftmix Espresso Martini and Strawberry Mule cocktails with drink mix packets, fresh fruit, and garnishes on a cream-colored surface." width="770" height="706"></div>
         <div class="img-wrapper-sm"><img
              src="{{ image_urls[5] }}"
              alt="Craftmix cocktails with drink mix packets, cupcakes, and bridal party accessories on a pink confetti background with a 'bride to be' sash." width="770" height="706"></div>
         <div class="img-wrapper-sm"><img
              src="{{ image_urls[6] }}"
              alt="Group of friends smiling and enjoying Craftmix cocktails around a dining table with a Craftmix Variety Pack on display." width="770" height="706"></div>
        </div>
      </div>


      <div class="flex-item-right">
        <div class="reviews">
          <img class="review-stars"
            src="https://cdn.shopify.com/s/files/1/2340/1623/files/stars-dark-blue.svg?v=1743061692" width="124" height="22" alt="Review stars" role="presentation">
          <span class="review-text">3000+ 5-Star Reviews</span>
        </div>
        <div class="heading">
          <h1 class="heading-text">The #1 Instant Cocktail & Mocktail Mixer</h1>
        </div>
        <div class="paragraph">
          <p class="paragraph-text">Make a delicious cocktail or mocktail in seconds with just liquor, water & ice</p>
        </div>

      

        <form method="post" action="/cart/add">
