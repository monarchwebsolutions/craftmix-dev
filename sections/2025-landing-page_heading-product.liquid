    const image4 = document.querySelector('#lander-image-4 img');

    // Replace these with actual Starter Pack image URLs
    const starterFeatured = "https://cdn.shopify.com/s/files/1/2340/1623/files/1-_36.jpg?v=1751582660";
    const starterImage4 = "https://cdn.shopify.com/s/files/1/2340/1623/files/4_-_Starter-min.jpg?v=1751583804";

    // Original image URLs rendered from Liquid
    const originalFeatured = "{{ image_urls[0] }}";
    const originalImage4 = "{{ image_urls[3] }}";

    const ultimateVariantId = {{ all_products['ultimate-variety-pack-60'].variants.first.id }};
    const craftmixClubVariantId = {{ all_products['craftmix-club-60-drinks'].variants.first.id }};
    const planId = "4832002286";

    // Assign real variant IDs to radios (overwrite placeholders)
    if (radios[0]) radios[0].value = craftmixClubVariantId;
    if (radios[1]) radios[1].value = ultimateVariantId;

    // On load, make sure everything is synced
    const checked = document.querySelector('input[name="product_pack_selector"]:checked');
    if (checked) {
      setInputs(checked.value);
    }

    // Update on radio change
    radios.forEach((radio, index) => {
      radio.addEventListener("change", () => {
        setInputs(radio.value);
        console.log("Radio button updated")
      });
    });

    function setInputs(variantId) {
      variantInput.value = variantId;

      if (variantId == craftmixClubVariantId) {
        sellingPlanInput.value = planId;
        sellingPlanInput.disabled = false;
      } else {
        sellingPlanInput.disabled = true;
      }
    }

    function isCraftmixClubSelected() {
      const selectedRadio = document.querySelector('input[name="product_pack_selector"]:checked');
      const container = selectedRadio?.closest('.buy-option-container-lg');
      return Boolean(container);
    }
  });

  // Border on load
  document.addEventListener('DOMContentLoaded', () => {
    const checked = document.querySelector('input[type="radio"]:checked');
    if (checked) {
      const outer = checked.closest('.buy-option-container') || checked.closest('.buy-option-container-lg');
      if (outer) {
        outer.classList.add('selected');
      }
    }
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const radios = document.querySelectorAll('input[name="product_pack_selector"]');
    const flavorHeader = document.querySelector('.flavor-heading');
    const singleGrid = document.querySelector('.flavor-card-grid-single-row');
    const doubleGrid = document.querySelector('.flavor-card-grid-double-row');

    const ultimateVariantId = {{ all_products['ultimate-variety-pack-60'].variants.first.id }};
    const craftmixClubVariantId = {{ all_products['craftmix-club-60-drinks'].variants.first.id }};

    // On load, apply correct UI state
    const checked = document.querySelector('input[name="product_pack_selector"]:checked');
    if (checked) updateFlavorDisplay(checked.value);

    radios.forEach(radio => {
      radio.addEventListener("change", () => {
        updateFlavorDisplay(radio.value);
      });
    });

    function updateFlavorDisplay(variantId) {
      if (variantId == starterVariantId.toString()) {
        flavorHeader.innerHTML = 'YOU GET 9x PACKETS FOR 4x FLAVORS';

        // Show 4-card grid
        singleGrid.classList.add('active');
        doubleGrid.classList.remove('active');
      } else if (
        variantId == ultimateVariantId.toString() ||
        variantId == craftmixClubVariantId.toString()
      ) {
        flavorHeader.innerHTML = 'YOU GET 6x PACKETS FOR 10x FLAVORS';

        // Show 10-card grid
        singleGrid.classList.remove('active');
        doubleGrid.classList.add('active');
      }
    }
  });
</script>