<script>
  document.addEventListener('DOMContentLoaded', function () {
    function updateCustomStampedInfo() {
      const containers = document.querySelectorAll('.product-card-stars-container');
      // console.log('[Stamped Debug] Found', containers.length, 'containers');

      containers.forEach(container => {
        const productId = container.dataset.productId;
        // console.log('[Stamped Debug] Checking product ID:', productId);

        const badgeEl = document.querySelector(`.stamped-product-reviews-badge[data-id="${productId}"] .stamped-badge`);
        if (!badgeEl) {
          // console.warn(`[Stamped Debug] No badge found for product ID ${productId}`);
          return;
        }

        const avg = badgeEl.getAttribute('data-rating') || '0.0';
        const label = badgeEl.getAttribute('aria-label') || '';
        const match = label.match(/(\d+)\s+review/);
        const count = match ? match[1] : '0';

        const ratingEl = container.querySelector('.product-review-rating-number');
        const countEl = container.querySelector('.product-card-reviews');

        if (ratingEl) {
          if (count === '0') {
            ratingEl.style.display = 'none';
          } else {
            ratingEl.textContent = avg;
            ratingEl.style.display = 'inline'; // In case it was previously hidden
          }
        }
                
        if (countEl) {
          if (count === '0') {
            countEl.textContent = 'No reviews yet!';
          } else {
            countEl.textContent = `${count} review${count !== '1' ? 's' : ''}`;
          }
        }
      });
    }

    const observer = new MutationObserver(() => {
      // console.log('[Stamped Debug] Badge DOM changed — updating UI');
      updateCustomStampedInfo();
    });

    const badgeContainers = document.querySelectorAll('.stamped-product-reviews-badge');
    badgeContainers.forEach(container => {
      observer.observe(container, { childList: true, subtree: true });
    });

    // Fallback: manually trigger update after delay
    setTimeout(() => {
      // console.log('[Stamped Debug] Manual fallback update');
      updateCustomStampedInfo();
    }, 1500);
  });
</script>

{% javascript %}

document.addEventListener('DOMContentLoaded', function() {
  document.body.classList.add('page-loaded');

  const addToCartButtons = document.querySelectorAll('.product-card-add-btn');
  // console.log(`Found ${addToCartButtons.length} Add to Cart buttons`);

  document.body.addEventListener('click', function(event) {
    const button = event.target.closest('.product-card-add-btn');
    if (button) {
      event.preventDefault();

     let variantId = button.getAttribute('data-product-id');

      if (variantId) {
        addToCart(variantId, 1);
      }
    }
  });

  document.body.addEventListener('change', function(event) {
    if (event.target.matches('select[name="product-variant-size"]')) {
      const select = event.target;
      const productCard = select.closest('.product-card');
      const selectedOption = select.options[select.selectedIndex];
      const variantPrice = selectedOption.getAttribute('data-price');
      const variantid = selectedOption.getAttribute('data-id');
      const priceElement = productCard.querySelector('.variant-price');

      if (priceElement) {
        priceElement.textContent = formatMoney(variantPrice);
        priceElement.setAttribute('data-product-id', variantid);
      }
    }
  });

  // Custom Variant Dropdown Handler
  document.querySelectorAll('.custom-variant-trigger').forEach(trigger => {
    const dropdownId = trigger.getAttribute('data-dropdown-id');
    const dropdown = document.getElementById(dropdownId);
    const selectedText = trigger.querySelector('.selected-variant');

    if (!dropdown || !selectedText) return;

    function focusSelectedOrFirstOption() {
      const options = Array.from(dropdown.querySelectorAll('.variant-option'));
      if (!options.length) return;

      // Make options programmatically focusable (safe even if repeated)
      options.forEach(opt => {
        if (!opt.hasAttribute('tabindex')) opt.setAttribute('tabindex', '-1');
      });

      const selectedLabel = (selectedText.textContent || '').trim();
      const targetOption =
        options.find(o => (o.textContent || '').trim() === selectedLabel) || options[0];

      requestAnimationFrame(() => {
        try { targetOption.focus({ preventScroll: true }); } catch (e) {}
      });
    }

    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        e.stopPropagation();
        trigger.click();
      }
    });

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();

      // Close all other dropdowns
      document.querySelectorAll('.variant-options-container').forEach(d => {
        if (d !== dropdown) d.style.display = 'none';
      });

      // Toggle visibility
      const isOpening = dropdown.style.display !== 'block';

      if (!isOpening) {
        dropdown.style.display = 'none';
        dropdown.classList.remove('below');
      } else {
        dropdown.classList.remove('above');
        dropdown.classList.add('below');
        dropdown.style.display = 'block';

        focusSelectedOrFirstOption();
      }
    });

    dropdown.querySelectorAll('.variant-option').forEach(option => {
      option.addEventListener('keydown', (e) => {
        // Enter/Space selects option AND moves focus to ATC
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          e.stopPropagation();

          option.click();

          const container = option.closest('.variant-options-container');
          const trig = container
            ? document.querySelector(`.custom-variant-trigger[data-dropdown-id="${container.id}"]`)
            : null;

          const cardRoot = trig ? trig.closest('.product-card') : null;
          const addBtn = cardRoot ? cardRoot.querySelector('.product-card-add-btn') : null;

          requestAnimationFrame(() => {
            if (addBtn) addBtn.focus({ preventScroll: true });
          });

          return;
        }

        // Escape exits back to trigger
        if (e.key === 'Escape') {
          e.preventDefault();
          e.stopPropagation();

          const container = option.closest('.variant-options-container');
          if (container) container.style.display = 'none';

          const trig = document.querySelector(
            `.custom-variant-trigger[data-dropdown-id="${container ? container.id : ''}"]`
          );
          if (trig) trig.focus({ preventScroll: true });
          return;
        }

        // Tab routing: Tab goes to ATC, Shift+Tab goes back to trigger
        if (e.key === 'Tab') {
          e.preventDefault();
          e.stopPropagation();

          const container = option.closest('.variant-options-container');
          if (container) container.style.display = 'none';

          const trig = container
            ? document.querySelector(`.custom-variant-trigger[data-dropdown-id="${container.id}"]`)
            : null;

          const cardRoot = trig ? trig.closest('.product-card') : null;
          const addBtn = cardRoot ? cardRoot.querySelector('.product-card-add-btn') : null;

          if (e.shiftKey) {
            requestAnimationFrame(() => {
              if (trig) trig.focus({ preventScroll: true });
            });
          } else {
            requestAnimationFrame(() => {
              if (addBtn) addBtn.focus({ preventScroll: true });
            });
          }
          return;
        }

        // Up/Down arrow navigation between options
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          e.stopPropagation();

          const container = option.closest('.variant-options-container');
          if (!container) return;

          const options = Array.from(container.querySelectorAll('.variant-option'));
          const currentIndex = options.indexOf(option);
          if (currentIndex === -1) return;

          const nextIndex =
            e.key === 'ArrowDown'
              ? Math.min(options.length - 1, currentIndex + 1)
              : Math.max(0, currentIndex - 1);

          const nextOption = options[nextIndex];
          if (nextOption) nextOption.focus({ preventScroll: true });
        }
      });

      option.addEventListener('click', () => {
        const variantId = option.dataset.id;
        const variantPrice = option.dataset.price;
        const title = option.textContent;

        selectedText.textContent = title;
        dropdown.style.display = 'none';

        const productCard = trigger.closest('.product-card');
        const addBtn = productCard ? productCard.querySelector('.product-card-add-btn') : null;
        const priceEl = productCard ? productCard.querySelector('.variant-price') : null;

        if (addBtn) addBtn.setAttribute('data-product-id', variantId);
        if (priceEl) {
          priceEl.textContent = formatMoney(variantPrice);
          priceEl.setAttribute('data-product-id', variantId);
        }

        // After selection via click, land on ATC (same method as carousel)
        requestAnimationFrame(() => {
          if (addBtn) addBtn.focus({ preventScroll: true });
        });
      });
    });
  });


  // Close dropdowns when clicking outside
  document.addEventListener('click', () => {
    document.querySelectorAll('.variant-options-container').forEach(dropdown => {
      dropdown.style.display = 'none';
    });
  });

  // Init filters
  initProductFilter();

  function initProductFilter() {
    const filterLinks = document.querySelectorAll('.filter-link');
    const productCards = document.querySelectorAll('.product-card-container');
    const pinkLeaf = document.querySelector('.mint_pink-bg');
    const blueberry = document.querySelector('.blueberry-bg');

    filterLinks.forEach(link => {
      link.addEventListener('click', function(event) {
  
        const selectedTag = this.getAttribute('data-tag');

        // Update active state
        filterLinks.forEach(l => {
          l.classList.remove('active');
          l.removeAttribute('aria-pressed');
        });
        this.classList.add('active');
        this.setAttribute('aria-pressed', 'true');
        
        // Show/hide cards
        productCards.forEach(card => {
          const cardTags = card.getAttribute('data-tags').split(',');
          const show = selectedTag === 'all' || cardTags.includes(selectedTag);
          card.style.display = show ? 'block' : 'none';

          // Reset SVG (if needed)
          if (show) {
            const svg = card.querySelector('svg');
            if (svg) {
              const clone = svg.cloneNode(true);
              svg.replaceWith(clone);
            }
          }
        });

        pinkLeaf.style.display = selectedTag === 'all' ? 'block' : 'none';
        blueberry.style.display = selectedTag === 'all' ? 'block' : 'none';
      });
    });
  }

  function addToCart(variantId, quantity) {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: variantId, quantity: quantity }] })
    })
    .then(response => response.json())
    .then(data => {
      if (data.status && data.status !== 200) {
        alert(`Error: ${data.message || 'Could not add to cart'}`);
      } else {
        console.log('Product added to cart:', data);
      }
    })
    .catch(error => {
      console.error('Error adding product to cart:', error);
    });
  }

  function formatMoney(cents) {
    const dollars = (cents / 100).toFixed(2);
    return `$${dollars}`;
  }
});

{% endjavascript %}


