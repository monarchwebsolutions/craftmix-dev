            <div class="product-card"
                  data-color1="{{ product.metafields.custom.color_1 | default: '#8c4a84' }}"
                  data-color2="{{ product.metafields.custom.color_2 | default: '#e6dbf7' }}"
                  data-color3="{{ product.metafields.custom.color_3 | default: '#f8f3fa' }}"
                  style="background-color: {{ product.metafields.custom.color_3 | default: '#f8f3fa' }};">
                <a href="{{ product.url }}" class="product-card-img-link">
                <div class="product-card-main product-card-main-{{ product.id }}"  style="--bg-image: url('{{ product.metafields.custom.product_card_bg_image | img_url: '600x' }}');">
                  <div class="product-card-info {% if product.title contains 'Happy Hour Kit' %} happy-hour{% endif %}">
                  <!-- 🔒 Hidden stamped widget ( for stamped data) -->
                  <div 
                    class="stamped-product-reviews-badge" 
                    data-id="{{ product.id }}" 
                    data-name="{{ product.title | escape }}" 
                    data-url="{{ shop.url }}{{ product.url }}"
                    style="display: none;">
                  </div>
                  
                  <!-- ✅ Styled layout -->
                  <div class="product-card-stars-container" data-product-id="{{ product.id }}">
                    <div class="product-card-stars">
                      <img src="{{ 'stars-dark.svg' | asset_url }}" alt="Rating stars" width="105" height="18">
                      <p class="product-review-rating-number">5.0</p>
                    </div>
                    <p class="product-card-reviews">0 reviews</p>
                    <h2 class="product-card-title">{{ product.title | replace_first: "2025 - ", "" }}</h2>
                  </div>

                  </div>
    
                  {% assign index = forloop.index0 %}

                  <div class="product-card-image{% if product.title contains 'Happy Hour Kit' %} happy-hour{% endif %}">
                    {% if product.images.size > 0 %}
                      <img 
                        src="{{ product.images.last | img_url: '361x309' }}" 
                        alt="{{ product.title }}" 
                        width="361" 
                        height="309"
                        {% if index > 3 %}loading="lazy"{% else %}loading="eager"{% endif %}>
                    {% else %}
                      <img 
                        src="{{ 'product-placeholder.png' | asset_url }}" 
                        alt="Placeholder image" 
                        width="800" 
                        height="800"
                        {% if index > 3 %}loading="lazy"{% else %}loading="eager"{% endif %}>
                    {% endif %}
                  </div>

                </div>
              </a>
              <div class="product-card-footer {% if product.variants.size == 1 %}single-variant{% endif %}">
                {% if product.variants.size > 1 %}
                  <div class="product-card-variant-size custom-select" style="background-color: {{ product.metafields.custom.color_2 | default: '#e6dbf7' }};">
                    <div class="custom-variant-trigger" data-dropdown-id="variant-options-{{ product.id }}" tabindex="0">
                      <div class="selected-variant" style="background-color: {{ product.metafields.custom.color_2 | default: '#e6dbf7' }};">
                        {{ product.variants.first.title }}
                      </div>
                      <span class="custom-arrow"> 
                        <img src="{{ 'custom-select-arrow.svg' | asset_url }}" alt="Dropdown arrow" width="12" height="8" />
                      </span>
                    </div>
                  </div>
                {% endif %}
              
                <div class="product-card-add-to-cart"
                      style="background-color: {{ product.metafields.custom.color_1 | default: '#8c4a84' }};
                            color: {{ product.metafields.custom.btn_text_color | default: '#ffffff' }};">
                  <button class="product-card-add-btn"
                          data-product-id="{{ product.variants.first.id }}"
                          data-variants='{{ product.variants | json }}'>
                    Add - <span class="variant-price igPrice" data-product-id="{{product.id  }}">{{ product.price | money }}</span>
                  </button>
                </div>
              </div>

              {% if product.variants.size > 1 %}
                <div class="variant-options-container" 
                  id="variant-options-{{ product.id }}"  
                  style="background-color: {{ product.metafields.custom.color_3 | default: '#ffffff' }};
                          --variant-hover: {{ product.metafields.custom.color_2 | default: '#f0f0f0' }};">
                  {% for variant in product.variants %}
                    <div class="variant-option"
                          data-id="{{ variant.id }}"
                          data-price="{{ variant.price }}">
                      {{ variant.title }}
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
              
            </div>
        </div>
        {% endunless %}
      {% endfor %}
    </div>
