<link rel="stylesheet" href="{{ 'make-craft-drinks-custom.css' | asset_url }}">
<div class="make-craft-drinks-wrapper" id="make-craft-drinks">
  <div class="make-craft-drinks-section make-craft-drinks-pdp page-max-width">
    <div class="craft-drinks-card-container">
      <div class="craft-drinks-card">
        <div class="craft-drinks-card-header">
          <span class="card-subheading">How to Make</span>
          <h3 class="card-title">Craft Drinks</h3>
          <p class="card-paragraph card-paragraph-1">in under 30 seconds</p>
          <p class="card-paragraph card-paragraph-2">Each packet makes 1 drink</p>
        </div>
        <div class="craft-drinks-card-list-container">
          <ul class="craft-drinks-card-list">
            <li class="craft-drinks-card-list-item">
              <div class="circle"><span>1</span></div>Pour 4oz water & optionally 1oz liquor
            </li>
            <li class="craft-drinks-card-list-item">
              <div class="circle"><span>2</span></div>Stir in 1 Craftmix packet (30-60s)
            </li>
            <li class="craft-drinks-card-list-item">
              <div class="circle"><span>3</span></div>Serve over a lot of ice and enjoy
            </li>
          </ul>
        </div>
  
        <div class="craft-drinks-card-cta">
          <a class="craft-drinks-card-cta-btn" href="/collections/flavors-2024">Find your flavor</a>
        </div>
      </div>
    </div>
  
    <div class="craft-drinks-image-container">
      <div
        class="lazy-lottie-container preparation-animation"
        data-src="{{ 'preparation-animation.json' | asset_url }}"
        data-background="transparent"
        data-speed="0.6"
        data-autoplay="true"
        data-loop="true"
      >
        <!-- lottie-player will be injected here -->
      </div>
    </div>
  
  </div>
  <div class="section-wave-container">
      <div
        class="lazy-lottie-container section-wave pdp-faq-wave"
        data-src="{{ product.metafields.custom.secondary_product_wave | asset_url }}"
        data-background="transparent"
        data-speed="1"
        data-autoplay="true"
        data-loop="true"
      >
      <!-- lottie-player will be injected here -->
    </div>
  </div>
</div>
{% schema %}
  {
    "name": "PDP - Make Craft Drinks",
    "settings": [],
    "presets": [
      {
        "name": "PDP - Make Craft Drinks"
      }
    ]
  }
{% endschema %}