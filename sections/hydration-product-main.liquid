  .change-flavor-body {
    height: 176px;
    margin-bottom: 23px;
    overflow-x: auto;
    overflow-y: hidden; /* Hide vertical scrollbar */
    cursor: grab;
    -webkit-overflow-scrolling: touch;
    
    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    position: relative; /* for blur overlay */
    mask-image: linear-gradient(
      to right,
      black calc(100% - 200px),
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      black calc(100% - 200px),
      transparent 100%
    );
  }
  
  .change-flavor-body:active {
    cursor: grabbing;
  }

  .change-flavor-body::-webkit-scrollbar {
    width: 0.375rem;
    height:0.375rem;
    background:rgba(0, 38, 87, 0.16);
    border-radius:1rem;
  }
  .change-flavor-body::-webkit-scrollbar-thumb {
    background: var(--craftmix-dark-blue);
    opacity:0.1;
    border-radius:1rem;
  }
  
  .change-flavor-list {
    display: flex;
    gap: 10px;
    padding-bottom: 6px; /* Reduced padding to account for scrollbar height */
    padding-right: 50px; /* Add padding to prevent content from being cut off */
