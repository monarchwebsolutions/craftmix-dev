    margin-top: 10px;
    margin-bottom: 12px;
  }
  
  .flavor-card img {
    pointer-events: none; /* Prevents image dragging */
    -webkit-user-drag: none; /* For Safari */
    user-select: none; /* Standard syntax for preventing selection */
    -webkit-user-select: none; /* For older WebKit browsers */
    -moz-user-select: none; /* For Firefox */
    -ms-user-select: none; /* For Internet Explorer/Edge */
