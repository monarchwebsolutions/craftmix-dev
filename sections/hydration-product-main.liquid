{% schema %}
{
  "name": "Hydration Product - Main",
  "tag": "section",
  "class": "x-section section-product-info",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "product_name",
      "name": "t:sections.featured-product.blocks.product_name.name",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "title_size",
          "min": 50,
          "max": 200,
          "step": 10,
          "unit": "%",
          "label": "t:sections.featured-product.settings.title_size.label",
          "default": 100
        },
        {
          "type": "select",
          "id": "heading_tag",
          "default": "h1",
          "label": "t:sections.all.text.heading_tag",
          "options": [
            {
