<script defer>
// Wrap in a DOMContentLoaded event in case script is in the <head>
document.addEventListener('DOMContentLoaded', function () {
  const cartIcon = document.querySelector('a#cart-icon');

  if (!cartIcon) return;

  const originalHref = cartIcon.getAttribute('href');

  // ✅ IMMEDIATELY disable the cart
  cartIcon.removeAttribute('href');
  // cartIcon.classList.add('cart-temp-disabled');
  cartIcon.style.pointerEvents = 'none';
  // cartIcon.style.opacity = '0.5';
  cartIcon.title = 'Cart loading...';

  // ✅ Re-enable after 2 seconds
  setTimeout(() => {
    cartIcon.setAttribute('href', originalHref);
    // cartIcon.classList.remove('cart-temp-disabled');
    cartIcon.style.pointerEvents = '';
    // cartIcon.style.opacity = '';
    cartIcon.removeAttribute('title');

    console.log('✅ Cart link re-enabled after delay');
  }, 2000);
});

</script>
<script defer>
 document.addEventListener("DOMContentLoaded", function () {
    const customCheckmarkSVG = `
        <svg width="9" height="8" viewBox="0 0 9 8" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2.82415 6.15237L0.726419 4.05464L0.012085 4.76395L2.82415 7.57601L8.86078 1.53938L8.15147 0.830078L2.82415 6.15237Z" fill="currentColor"></path>
        </svg>
    `;

    function updateIcons() {
        document.querySelectorAll(".rebuy-cart__progress-step-icon").forEach(iconDiv => {
            iconDiv.innerHTML = customCheckmarkSVG; // Force the checkmark SVG every time
        });

        document.querySelectorAll(".rebuy-cart__progress-step").forEach(stepDiv => {
            stepDiv.style.opacity = stepDiv.classList.contains("complete") ? "1" : "0.5"; // Adjust opacity
        });
    }

    function observeStepChanges(stepDiv) {
        const stepObserver = new MutationObserver(() => {
            updateIcons(); // Ensure all icons reset every time "complete" is added or removed
        });

        // Observe only class changes on each progress step
        stepObserver.observe(stepDiv, { attributes: true, attributeFilter: ["class"] });
    }

    // Observer to detect when Rebuy's Smart Cart appears
    const rebuyObserver = new MutationObserver((mutations, observer) => {
        const progressSteps = document.querySelectorAll(".rebuy-cart__progress-step");

        if (progressSteps.length > 0) {
            updateIcons(); // Initial update to checkmarks
            observer.disconnect(); // Stop once Smart Cart is loaded

            // Observe each step for class changes
            progressSteps.forEach(observeStepChanges);
        }
    });

    // Start observing the document for when Rebuy's Smart Cart appears
    rebuyObserver.observe(document.body, { childList: true, subtree: true });
});
</script>

<script defer>
document.addEventListener("DOMContentLoaded", () => {
  const shopButton = document.querySelector("#header-shop-button");
  const megaMenuContainer = document.querySelector(".mega-menu-container");

  // Create dark overlay element
  const overlay = document.createElement("div");
  overlay.className = "dark-overlay";
  document.body.appendChild(overlay);

  // Function to show overlay and disable scroll
  function showOverlay() {
    overlay.classList.add("visible");
    document.body.style.overflow = "hidden"; // Disable scrolling
  }

  // Function to hide overlay and enable scroll
  function hideOverlay() {
    overlay.classList.remove("visible");
    document.body.style.overflow = ""; // Enable scrolling
    document.querySelector("#header-shop-button svg").style.transform = "unset";
  }

  // Add click event listener to shop button
  shopButton.addEventListener("click", () => {
    if (shopButton.classList.contains("dropdown-selected")) {
      // If dropdown is already selected, show overlay
      
      showOverlay();
    } else {
      // If dropdown is not selected, hide overlay
      hideOverlay();
    }
  });

  // Add click event listener to overlay to close mega menu
  overlay.addEventListener("click", () => {
    // Hide mega menu
    megaMenuContainer.style.visibility = "hidden";
    // Remove dropdown-selected class from shop button
    shopButton.classList.remove("dropdown-selected");
    // Hide overlay and enable scroll
    hideOverlay();
  });
});
</script>

<script defer>
document.addEventListener('keydown', (e) => {
  if (e.key !== 'Escape' && e.keyCode !== 27) return;

  // Find any visible/open dropdown menus
  const openMenus = Array.from(document.querySelectorAll('li.tree-menu.has-dropdown .toggle-menu'))
    .filter(menu => {
      const cs = getComputedStyle(menu);
      const isVisible = menu.offsetParent !== null && cs.display !== 'none' && cs.visibility !== 'hidden' && cs.opacity !== '0';
      const isNotHiddenClass = !menu.classList.contains('toggle-menu-hidden');
      return isVisible && isNotHiddenClass;
    });

  if (!openMenus.length) return;

  e.preventDefault();

  // Close only the open ones
  openMenus.forEach(menu => {
    menu.classList.add('toggle-menu-hidden');

    const li = menu.closest('li.tree-menu.has-dropdown');
    if (!li) return;

    // Reset pill styling (match your existing click-away behavior)
    const relativeDiv = li.querySelector('div.relative');
    if (relativeDiv) {
      relativeDiv.style.background = '';
      relativeDiv.style.border = '2px solid transparent';
      relativeDiv.style.borderRadius = '';
    }

    // Unrotate caret + remove clicked class
    const trigger = li.querySelector('a.tree-menu-item');
    if (trigger) {
      trigger.classList.remove('clicked');
      const svg = trigger.querySelector('svg');
      if (svg) svg.classList.remove('rotated');
      trigger.focus();
    }
  });
}, true);
</script>


{%- liquid
  assign areas = "heading navigation icons"
  assign areas2 =  ". . ."
  assign class_grid = "col-span-full col-start-1 order-1 lg:mb-3"
  assign class = 'w-full justify-end'
  assign logo_above = false
  assign logo_center = false
  assign columns = 'auto 1fr auto'
  if section.settings.logo_position == 'above-center'
    assign areas =  "iconsRight heading icons" 
    assign areas2 =  "navigation navigation navigation"
    assign class_grid = '[grid-area:iconsRight] hidden lg:block'
    assign class = 'w-full'
    assign columns = '4fr 2fr 4fr'
    assign logo_above = true
  endif
  if section.settings.logo_position == 'left-center'
    assign columns = '1fr 4fr 1fr'
  endif
  if section.settings.logo_position == 'center-left'
    assign columns = '4fr 2fr 4fr'
    assign areas = ". . ."
    assign areas2 =  "navigation heading icons"
    assign logo_center = true
  endif
  assign transparent = false
  if section.settings.enable_on_homepage and template.name == "index"
    assign transparent = true
  endif
  if section.settings.enable_on_collection_page and template.name == "collection"
    assign transparent = true
  endif
  assign class_logo = "w-[" | append: section.settings.logo_width_mobile | append: "px] md:w-[" | append: section.settings.logo_width | append: "px] h-auto"
  assign logo_name = settings.heading_base_size | times: 0.0225
  if section.settings.header_show_currency_selector or section.settings.show_social_icons or section.settings.header_show_language_selector
    assign headerTop = true 
  else 
    assign headerTop = false
  endif

  if section.settings.mobile_header_layout == 'center-left'
    assign mobile_layout = 'drawer heading icons'
  elsif section.settings.mobile_header_layout == 'center-right'
    assign mobile_layout = 'icons heading drawer'
  else
    assign mobile_layout = 'heading drawer'
  endif
-%}
{%- style -%}
  {% unless section.settings.enable_sticky_header %}
    :root{
      --height-header: 0px;
    }
  {% endunless %}
  {%- if transparent -%}
    section:first-child {
      margin-top: 0;
    }
    #sticky-header-content {
      background: linear-gradient(to top, transparent 0%, rgba({{ section.settings.shadow_color.red }},{{ section.settings.shadow_color.green }},{{ section.settings.shadow_color.blue }}, {{ section.settings.shadow }}%) 100%);
    }
    .dark #sticky-header-content {
      {% if section.settings.shadow_color_dark.alpha != 0.0 %}
        background: linear-gradient(to top, transparent 0%, rgba({{ section.settings.shadow_color_dark.red }},{{ section.settings.shadow_color_dark.green }},{{ section.settings.shadow_color_dark.blue }}, {{ section.settings.shadow }}%) 100%);
      {% else %}
        background: transparent;
      {% endif %}
    }
    #sticky-header-content.background-header {
      background: rgb(var(--background-color-header));
    }
    #sticky-header-content:hover header,
    #sticky-header-content:hover {
      background: rgba(var(--background-color-header))
    }
    #sticky-header-content:hover .divider {
      -colors-line-and-border: var(--background-color-header);
      --colors-line-header: var(--background-color-header);
    }
    .transparent-header .sticky-header-content:not(.sticky-header-active) .header {
      {% unless section.settings.textlink_color_light.alpha == 0.0 %}
        --colors-text-link: {{ section.settings.textlink_color_light.red }},{{ section.settings.textlink_color_light.green }},{{ section.settings.textlink_color_light.blue }};
      {% endunless %}
    }
    .dark .sticky-header-content:not(.sticky-header-active) .header {
      {%- unless section.settings.textlink_color_dark.alpha == 0.0 -%}
        --colors-text-link: {{ section.settings.textlink_color_dark.red }},{{ section.settings.textlink_color_dark.green }},{{ section.settings.textlink_color_dark.blue }};
      {% else %}  
        --colors-text-link: {{ settings.colors_dark_text_link.red }}, {{ settings.colors_dark_text_link.green }}, {{ settings.colors_dark_text_link.blue }};
      {% endunless %}
    }
  {%- endif -%}
  .logo-name {
    font-size: {{ logo_name | times: 0.5 }}rem;
  }
  .transparent-header .logo-name,
  .transparent-header header {
    {% unless section.settings.text_color_light.alpha == 0.0 %}
      color: {{ section.settings.text_color_light }};
    {% endunless %}
  }
  .dark .transparent-header .logo-name,
  .dark .transparent-header header {
    {% unless section.settings.text_color_dark.alpha == 0.0 %}
      color: {{ section.settings.text_color_dark }};
    {% else %}
      color: rgba(var(--colors-text));
    {% endunless %}
    
  }
  header {
    grid-template-areas: "{{ mobile_layout }}";
    {% if section.settings.mobile_header_layout == 'left-right' %}
      grid-template-columns: 3fr 3fr;
    {% endif %}
  }
  @media (min-width: 1024px) {
    header {
      grid-template-areas: "{{ areas }}" "{{ areas2 }}";
      grid-template-columns: {{ columns }};
    } 
    .logo-name {
      font-size: {{ logo_name }}rem;
    }
    .pt-header {
      padding-top: {{ section.settings.padding_top }}px;
    }
    .pb-header {
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
