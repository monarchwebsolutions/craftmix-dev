<script defer>
// Redo: ensure Enter/Space triggers click for focusable controls inside the widget
(() => {
  if (window.__redoEnterClickPatchInstalled) return;
  window.__redoEnterClickPatchInstalled = true;

  function isTextInput(el) {
    if (!el) return false;
    const tag = el.tagName;
    return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || el.isContentEditable;
  }

  function isClickable(el) {
    if (!el || el.nodeType !== 1) return false;
    const tag = el.tagName;
    if (tag === 'BUTTON' || tag === 'A') return true;
    const role = el.getAttribute('role');
    if (role === 'button' || role === 'link') return true;
    if (el.hasAttribute('data-target')) return true; // common in this widget
    return false;
  }

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;

    // Only inside Redo widget (key events are composed across shadow DOM)
    const path = (typeof e.composedPath === 'function') ? e.composedPath() : [];
    const redoHost = path.find(n => n && n.nodeType === 1 && n.tagName === 'REDO-SHOPIFY-TOGGLE');
    if (!redoHost || !redoHost.shadowRoot) return;

    // Don’t interfere with typing
    const t = e.target;
    if (isTextInput(t)) return;

    // Determine the actual focused element inside the shadow root
    const sr = redoHost.shadowRoot;
    const active = sr.activeElement;

    // Prefer the real active element in the shadow root; fallback to event target
    const el = (active && active.nodeType === 1) ? active : (t && t.nodeType === 1 ? t : null);
    if (!el) return;

    // Respect disabled states
    if (el.hasAttribute('disabled')) return;
    if (el.getAttribute('aria-disabled') === 'true') return;

    // Only click things that are meant to be clicked
    if (!isClickable(el)) return;

    // Prevent page-level handlers from eating Enter/Space and ensure click happens
    e.preventDefault();
    e.stopPropagation();

    // Native click
    el.click();
  }, true); // capture so we run before other handlers
})();
</script>

<script defer>
// Prevent focus on cart drawer elements when cart drawer is closed
(() => {
  const CART_SELECTOR = '#rebuy-cart';
  const OPEN_CLASS = 'is-visible';

  const FOCUSABLE = [
    'a[href]',
    'button:not([disabled])',
    'input:not([disabled])',
    'select:not([disabled])',
    'textarea:not([disabled])',
    '[tabindex]'
  ].join(',');

  function isCartOpen(cart) {
    return cart.classList.contains(OPEN_CLASS);
  }

  function disableCartTabbing(cart) {
    cart.querySelectorAll(FOCUSABLE).forEach((el) => {
      // Store original tabindex once
      if (!el.hasAttribute('data-prev-tabindex')) {
        const current = el.getAttribute('tabindex');
        if (current !== null) el.setAttribute('data-prev-tabindex', current);
        else el.setAttribute('data-prev-tabindex', '__none__');
      }
      el.setAttribute('tabindex', '-1');
    });
  }

  function restoreCartTabbing(cart) {
    cart.querySelectorAll('[data-prev-tabindex]').forEach((el) => {
      const prev = el.getAttribute('data-prev-tabindex');
      el.removeAttribute('data-prev-tabindex');

      if (prev === '__none__') {
        // Return to natural behavior
        if (el.getAttribute('tabindex') === '-1') el.removeAttribute('tabindex');
      } else {
        el.setAttribute('tabindex', prev);
      }
    });
  }

  function enforce(cart) {
    if (isCartOpen(cart)) restoreCartTabbing(cart);
    else disableCartTabbing(cart);
  }

  function attach(cart) {
    if (cart.__rebuyA11yAttached) return;
    cart.__rebuyA11yAttached = true;

    // Enforce now and whenever Rebuy mutates class or subtree
    enforce(cart);

    new MutationObserver(() => enforce(cart)).observe(cart, {
      attributes: true,
      attributeFilter: ['class']
    });

    new MutationObserver(() => enforce(cart)).observe(cart, {
      childList: true,
      subtree: true
    });

    // Critical: if focus lands inside the cart while CLOSED, remove focus.
    // Do NOT redirect to "skip to content" or any other element (no wrapping).
    document.addEventListener('focusin', (e) => {
      const currentCart = document.querySelector(CART_SELECTOR);
      if (!currentCart) return;

      if (!isCartOpen(currentCart) && currentCart.contains(e.target)) {
        e.preventDefault();
        // Remove focus so the browser can proceed to its own UI when tabbing continues
        if (document.activeElement) document.activeElement.blur();
      }
    }, true);
  }

  // Rebuy may inject/replace the cart node; watch the document and attach when found
  const docObs = new MutationObserver(() => {
    const cart = document.querySelector(CART_SELECTOR);
    if (cart) attach(cart);
  });
  docObs.observe(document.documentElement, { childList: true, subtree: true });

  // Initial attempt
  const cart = document.querySelector(CART_SELECTOR);
  if (cart) attach(cart);
})();
</script>

