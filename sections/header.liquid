<script defer>
// Force focus outlines on redo elements in cart drawer (keyboard only)
(() => {
  const STYLE_ID = 'info-card-focus-ring';

  const css = `
    button:focus-visible{
      outline: 3px solid var(--craftmix-orange) !important;
      outline-offset: 1px !important;
      box-shadow: 0 0 0 3px var(--craftmix-orange) !important;
    }
    button[data-target="coverage-button"]:focus-visible {
      outline: 3px solid var(--craftmix-dark-blue) !important;
    }
    button:focus:not(:focus-visible){
      outline: none !important;
      box-shadow: none !important;
    }
  `;

  function inject(shadowRoot) {
    if (!shadowRoot || shadowRoot.getElementById?.(STYLE_ID)) return;
    const style = document.createElement('style');
    style.id = STYLE_ID;
    style.textContent = css;
    shadowRoot.appendChild(style);
  }

  function scanAndInject() {
    document.querySelectorAll('*').forEach(el => {
      if (el.shadowRoot) inject(el.shadowRoot);
    });
  }

  function setupTabOverride() {
    if (window.__redoTabOverrideInstalled) return;
    window.__redoTabOverrideInstalled = true;

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;

      const path = (typeof e.composedPath === 'function') ? e.composedPath() : [];
      const host = path.find(n => n && n.nodeType === 1 && n.tagName === 'REDO-SHOPIFY-TOGGLE');

      if (!host || !host.shadowRoot) return;

      const sr = host.shadowRoot;

      const coverageBtn = sr.querySelector('button[data-target="coverage-button"]');
      const nonCoverageBtn = sr.querySelector('button[data-target="non-coverage-button"]');

      if (!coverageBtn || !nonCoverageBtn) return;

      nonCoverageBtn.tabIndex = 0;
      if (nonCoverageBtn.hasAttribute('disabled')) nonCoverageBtn.removeAttribute('disabled');
      if (nonCoverageBtn.getAttribute('tabindex') === '-1') nonCoverageBtn.removeAttribute('tabindex');
      if (nonCoverageBtn.getAttribute('aria-disabled') === 'true') nonCoverageBtn.setAttribute('aria-disabled', 'false');

      const active = sr.activeElement;

      if (!e.shiftKey && active === coverageBtn) {
        e.preventDefault();
        e.stopPropagation();
        nonCoverageBtn.focus();
        return;
      }

      if (e.shiftKey && active === nonCoverageBtn) {
        e.preventDefault();
        e.stopPropagation();
        coverageBtn.focus();
        return;
      }
    }, true);
  }

  function runAll() {
    scanAndInject();
    setupTabOverride();
  }

  runAll();

  const obs = new MutationObserver(runAll);
  obs.observe(document.documentElement, { childList: true, subtree: true });
})();
