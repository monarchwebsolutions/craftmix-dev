{% assign product = section.settings.product | default: all_products['hydration-variety'] %}
{% if product != blank %}
{% assign section_bg = product.metafields.custom.color_3 | default: '#ffffff' %}
{% assign icon_color = product.metafields.custom.color_1 | default: '#000000' %}

<div class="custom-product-faq-section" data-hydration-faq style="background-color: {{ section_bg }};">
       <img src="{{ 'pink-umbrella.svg' | asset_url }}" width="246" height="296" alt="Decorative background image of pink unbrella"  class="faq-fruit bg-pink-umbrella" loading="lazy">

  <div class="custom-product-faq-section-container">

    <div class="product-faq-body">
      <h2 class="product-faq-heading">{{ section.settings.heading }}</h2>



        {% assign faqs = product.metafields.custom.faqs.value %}
            {% if faqs != blank %}
              {% for faq in faqs limit:5 %}
                <div class="faq{% if forloop.index == 1 %} faq-active{% endif %}">
                  <div class="question" tabindex="0">
                    <h3 class="question-title">{{ faq.question }}</h3>
                    <div class="question-icon">
                      <div class="icon-circle" style="background-color: {{ icon_color }}">
                        <div class="icon-line horizontal"></div>
                        <div class="icon-line vertical"></div>
                      </div>
                    </div>
                  </div>
                  <div class="answer">
                    <div class="answer-inner"><p>{{ faq.answer }}</p></div>
                  </div>
                </div>
              {% endfor %}
            {% else %}
              <p>No FAQs available for this product.</p>
            {% endif %}

    </div>



    <div class="product-faq-image-container">

      {% if product.metafields.custom.pdp_faq_image %}
        <img class="product-faq-image" src="{{ product.metafields.custom.pdp_faq_image | image_url }}" width="811" height="811" alt="{{ product.metafields.custom.pdp_faq_image.value.alt | default: product.title | escape }}" loading="lazy">
      {% endif %}

    </div>

  </div>
  <div class="section-wave-container">
      <div
        class="lazy-lottie-container section-wave"
        data-src="{{ 'wave-divider-left-to-right-2400px-purple.json' | asset_url }}"
        data-background="transparent"
        data-speed="1"
        data-autoplay="true"
        data-loop="true"
      >
      <!-- lottie-player will be injected here -->
    </div>
  </div>
</div>

{% endif %}
{% style %}

#shopify-section-{{ section.id }} *,
#shopify-section-{{ section.id }} *::before,
#shopify-section-{{ section.id }} *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
#shopify-section-{{ section.id }} ul {
  list-style: none;
}
#shopify-section-{{ section.id }} a {
  text-decoration: none;
}
#shopify-section-{{ section.id }} img {
  max-width: 100%;
}
#shopify-section-{{ section.id }} .custom-product-faq-section {
  padding-top: 100px;
  position: relative;
  width: 100%;
  z-index: 0;
}
#shopify-section-{{ section.id }} .custom-product-faq-section-container {
  min-height: 820px;
  width: 100%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: start;
}
#shopify-section-{{ section.id }} .product-faq-body {
  position: relative;
  max-width: 568px;
  width: 100%;
  z-index: 2;
  margin-left: 290px;
}
#shopify-section-{{ section.id }} .product-faq-heading {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 40px;
  font-weight: 700;
  letter-spacing: -1.05px;
  text-align: left;
  line-height: 46px;
  margin-bottom: 45px;
}
#shopify-section-{{ section.id }} .faq {
  border-bottom: 1.5px solid rgba(0, 38, 87, 1);
  opacity: 1;
  margin-bottom: 5px;
}
#shopify-section-{{ section.id }} .faq .question {
  min-height: 70px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  cursor: pointer;
}
#shopify-section-{{ section.id }} .faq .question-title {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 600;
  letter-spacing: -0.11px;
  text-align: left;
  line-height: 22px;
}
#shopify-section-{{ section.id }} .question-icon {
  min-width: 30px;
  min-height: 30px;
}
#shopify-section-{{ section.id }} .icon-circle {
  width: 100%;
  height: 100%;
  border: 1px solid #002657;
  border-radius: 50%;
  position: relative;
  transition: all 0.3s ease;
}
#shopify-section-{{ section.id }} .icon-line {
  position: absolute;
  background-color: #fff;
  transition: all 0.3s ease;
}
#shopify-section-{{ section.id }} .icon-line.horizontal {
  width: 60%;
  height: 2px;
  top: 50%;
  left: 20%;
  transform: translateY(-50%);
}
#shopify-section-{{ section.id }} .icon-line.vertical {
  width: 2px;
  height: 60%;
  left: 50%;
  top: 20%;
  transform: translateX(-50%);
}
#shopify-section-{{ section.id }} .faq.faq-active .icon-circle {
  background-color: #00965e;
  border-color: #fff;
}
#shopify-section-{{ section.id }} .faq.faq-active .icon-line {
  background-color: #fff;
}
#shopify-section-{{ section.id }} .faq.faq-active .icon-line.vertical {
  transform: translateX(-50%) rotate(90deg);
  opacity: 0;
}
#shopify-section-{{ section.id }} .faq .question-icon:hover {
  cursor: pointer;
}
#shopify-section-{{ section.id }} .faq .answer {
  display: grid;
  grid-template-rows: 0fr;
  overflow: hidden;
  transition: grid-template-rows 0.3s ease-out, padding 0.3s ease-out;
  padding-right: 80px;
  padding-bottom: 0;
}
#shopify-section-{{ section.id }} .answer-inner {
  min-height: 0;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .faq.faq-active .answer {
  grid-template-rows: 1fr;
  transition: grid-template-rows 0.5s ease-in, padding 0.5s ease-in;
  padding-bottom: 26px;
}
#shopify-section-{{ section.id }} .faq .question-icon {
  width: 30px;
  height: 30px;
  transition: transform 0.3s ease;
}
#shopify-section-{{ section.id }} .faq.faq-active .question-icon {
  transform: rotate(180deg);
}
#shopify-section-{{ section.id }} .faq .answer p {
  opacity: 0.9;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 500;
  letter-spacing: -0.11px;
  text-align: left;
  line-height: 24px;
  padding-bottom: 26px;
}
#shopify-section-{{ section.id }} .icon-open,
#shopify-section-{{ section.id }} .faq.active .icon-close {
  display: none;
}
#shopify-section-{{ section.id }} .icon-close,
#shopify-section-{{ section.id }} .faq.active .icon-open {
  display: block;
}
#shopify-section-{{ section.id }} .faq-cta {
  text-align: center;
}
#shopify-section-{{ section.id }} .product-faq-image-container {
  position: absolute;
  top: 0;
  right: 0;
  height: 811px;
  width: 811px;
  overflow: hidden;
  z-index: 1;

}
#shopify-section-{{ section.id }} .product-faq-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

#shopify-section-{{ section.id }} .faq-fruit.bg-pink-umbrella {
  position: absolute !important;
  z-index: 2;
  top: -32px;
  left: -60px;
  transform: rotate(359deg) scaleX(-1);
}


@media screen and (max-width: 1550px) {
#shopify-section-{{ section.id }} .product-faq-body {
  position: relative;
  max-width: 568px;
  width: 100%;
  z-index: 2;
  margin-left: 190px;
}
}


@media screen and (max-width: 1350px) {
#shopify-section-{{ section.id }} .product-faq-image-container {
    position: absolute;
    top: 50% ;
    transform: translateY(-50%);
    height: 600px;
    width: 600px;
  }
}

@media screen and (max-width: 1250px) {
#shopify-section-{{ section.id }} .product-faq-body {
    max-width: 388px;
  }
}

@media (max-width: 1023px) {
#shopify-section-{{ section.id }} .custom-product-faq-section-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height:unset;
  }
#shopify-section-{{ section.id }} .product-faq-body {
    margin-left: 0;
    padding: 40px 16px;
    max-width: 95%;
    width: 600px;
    z-index: 0;
  }
#shopify-section-{{ section.id }} .product-faq-image-container {
    display:none;
  }
#shopify-section-{{ section.id }} .faq-fruit.bg-pink-umbrella {
    display: none;
  }
#shopify-section-{{ section.id }} .custom-product-faq-section {
    min-height:unset;
    padding-top:0
  }
}

@media screen and (max-width: 900px) {
#shopify-section-{{ section.id }} .product-faq-heading {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.79px;
    text-align: left;
    line-height: 35px;
  }
#shopify-section-{{ section.id }} .faq .question-title {
    font-size: 16px;
    letter-spacing: -0.1px;
    text-align: left;
    line-height: 20px;
  }
#shopify-section-{{ section.id }} .faq .answer p {
    font-size: 16px;
    letter-spacing: -0.1px;
    text-align: left;
    line-height: 19px;
  }
#shopify-section-{{ section.id }} .faq-cta-btn {
    padding: 20px 23px;
    margin-top: 62px;
    margin-bottom: 62px;
  }
}



{% endstyle %}




{% schema %}
{
  "name": "Hydration Landing FAQs",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Hydration product",
      "info": "Uses hydration-variety when empty."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "Got Questions"
    }
  ],
  "presets": [
    {
      "name": "Hydration Landing FAQs"
    }
  ]
}
{% endschema %}

{% javascript %}
(() => {
 function init(root) { root.querySelectorAll('[data-hydration-faq]').forEach(section => {
 if (section.dataset.hydrationInitialized) return;
 section.dataset.hydrationInitialized = 'true';
 const faqs = section.querySelectorAll('.faq');
 faqs.forEach(faq => {
  const question = faq.querySelector('.question');
  question.setAttribute('role','button');
  question.setAttribute('aria-expanded',String(faq.classList.contains('faq-active')));
  question.addEventListener('click', () => {
   const open = !faq.classList.contains('faq-active');
   faqs.forEach(item => { const active = item === faq && open; item.classList.toggle('faq-active',active); item.querySelector('.question').setAttribute('aria-expanded',String(active)); });
  });
  question.addEventListener('keydown', event => { if(event.key === 'Enter' || event.key === ' ') { event.preventDefault(); question.click(); } });
 });
 }); }
 if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => init(document), {once:true}); else init(document);
 document.addEventListener('shopify:section:load', event => init(event.target));
})();
{% endjavascript %}
