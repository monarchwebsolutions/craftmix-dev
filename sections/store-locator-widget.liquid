<script>
  document.addEventListener('DOMContentLoaded', function () {
    // ---- reset-search handling ----
    const TARGET_ID = 'reset-search';

    function enhanceReset(el) {
      if (!el || el.dataset.kbEnhanced === 'true') return;
      if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', '0');
      if (!el.hasAttribute('role')) el.setAttribute('role', 'button');
      el.dataset.kbEnhanced = 'true';
    }

    // Keydown delegation for #reset-search
    document.addEventListener('keydown', function (e) {
      const el =
        (e.target && e.target.id === TARGET_ID)
          ? e.target
          : e.target?.closest?.('#' + TARGET_ID);

      if (!el) return;

      enhanceReset(el);

      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        e.stopPropagation();
        el.click();
      }
    }, true);

    // ---- Store locator tabs (#sl-tab-list, #sl-tab-map) ----
    const TAB_SELECTOR = '#sl-tab-list, #sl-tab-map';

    function enhanceTabs() {
      document.querySelectorAll(TAB_SELECTOR).forEach((tab) => {
        // Only add tabindex. Do NOT add role to avoid style collisions.
        if (!tab.hasAttribute('tabindex')) tab.setAttribute('tabindex', '0');
        tab.dataset.kbEnhancedTab = 'true';
      });
    }

    // Keydown delegation for tabs (Enter/Space triggers native click)
    document.addEventListener('keydown', function (e) {
      const tab = e.target?.closest?.(TAB_SELECTOR);
      if (!tab) return;

      // If user is actually focused on a nested interactive control, don't override it
      const nestedInteractive = e.target?.closest?.('a[href], button, input, select, textarea');
      if (nestedInteractive && nestedInteractive !== tab) return;

      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        e.stopPropagation();

        tab.click();

        // Keep focus on the tab after any DOM changes
        requestAnimationFrame(() => {
          tab.focus();
        });
      }
    }, true);

    // ---- Store locator cards keyboard behavior ----
    const ITEM_SELECTOR = '#main-slider-storelocator .inner-item';
    const ACTIVE_CLASS = 'inner-item-active';

    // Flag used to suppress link navigation caused by our synthetic "select card" action
    let suppressLinkNavigation = false;

    function makeItemsFocusable() {
      document.querySelectorAll(ITEM_SELECTOR).forEach((item) => {
        if (!item.hasAttribute('tabindex')) item.setAttribute('tabindex', '0');
        // Intentionally NOT adding role="button" to avoid global role-based styling collisions
      });
    }

    function setActiveItem(activeItem) {
      document.querySelectorAll(ITEM_SELECTOR).forEach((item) => {
        item.classList.toggle(ACTIVE_CLASS, item === activeItem);
      });
    }

    // Block Directions (or any link) from opening a new tab when activation came from the card keydown
    document.addEventListener('click', function (e) {
      if (!suppressLinkNavigation) return;

      const link = e.target?.closest?.('a[href]');
      if (!link) return;

      if (link.closest(ITEM_SELECTOR)) {
        e.preventDefault();
        e.stopPropagation();
        if (typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
      }
    }, true);

    // Keydown on the card should "select" it (same as clicking the card) without activating nested links
    document.addEventListener('keydown', function (e) {
      const item = e.target?.closest?.(ITEM_SELECTOR);
      if (!item) return;

      // If focus is actually on an interactive element inside the card, let it behave normally
      const interactive = e.target?.closest?.('a[href], button, input, select, textarea, [role="button"]');
      if (interactive && interactive !== item) return;

      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        e.stopPropagation();

        setActiveItem(item);

        suppressLinkNavigation = true;
        item.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window }));
        suppressLinkNavigation = false;

        // Prevent focus from being stolen by the map iframe/popup
        requestAnimationFrame(() => {
          item.focus();
        });
      }
    }, true);

    // Keep active class synced for actual mouse clicks too
    document.addEventListener('click', function (e) {
      const item = e.target?.closest?.(ITEM_SELECTOR);
      if (!item) return;

      const link = e.target?.closest?.('a[href]');
      if (link) return;

      setActiveItem(item);
    }, true);

    // ---- Observe rerenders (Storeify injects/updates DOM) ----
    const observer = new MutationObserver(() => {
      const el = document.getElementById(TARGET_ID);
      if (el) enhanceReset(el);

      makeItemsFocusable();
      enhanceTabs();
    });

    observer.observe(document.documentElement, { childList: true, subtree: true });

    // Initial run
    enhanceReset(document.getElementById(TARGET_ID));
    makeItemsFocusable();
    enhanceTabs();
  });
</script>

<script>
	document.addEventListener('DOMContentLoaded', function () {
		const RESULTS_ID = 'results-slt';
		const SKIP_BTN_ID = 'skip-store-results-btn';
		const MAP_CONTAINER_SELECTOR = '.map-tab-ggmap';
		const MOBILE_SHOP_SELECTOR = 'a.shop-now-card-btn';
		const DESKTOP_MIN_WIDTH = 993;

		function focusDesktopTarget() {
			const mapContainer = document.querySelector(MAP_CONTAINER_SELECTOR);
			if (!mapContainer) return false;

			if (!mapContainer.hasAttribute('tabindex')) {
				mapContainer.setAttribute('tabindex', '0');
			}

			mapContainer.focus();
			return true;
		}

		function focusMobileTarget() {
			const shopBtn = document.querySelector(MOBILE_SHOP_SELECTOR);
			if (!shopBtn) return false;

			shopBtn.focus();
			return true;
		}

		function handleSkipAction() {
			const isDesktop = window.innerWidth >= DESKTOP_MIN_WIDTH;

			if (isDesktop) {
				if (focusDesktopTarget()) return;
			} else {
				if (focusMobileTarget()) return;
			}

			// Final fallback: do nothing (focus remains on skip button)
		}

		function injectSkipButton() {
			const results = document.getElementById(RESULTS_ID);
			if (!results) return;

			if (document.getElementById(SKIP_BTN_ID)) return;

			const btn = document.createElement('button');
			btn.type = 'button';
			btn.id = SKIP_BTN_ID;
			btn.className = 'skip-results-btn';
			btn.textContent = 'Skip store results';

			btn.addEventListener('click', handleSkipAction);

			results.insertAdjacentElement('beforebegin', btn);
		}

		injectSkipButton();

		const observer = new MutationObserver(injectSkipButton);
		observer.observe(document.documentElement, { childList: true, subtree: true });
	});
</script>

