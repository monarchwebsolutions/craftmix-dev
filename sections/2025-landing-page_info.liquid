/* Default: desktop visible, mobile hidden */
.info-carousel-desktop {
  display: block;
  position: relative;
  z-index: 2;
}

.info-carousel-mobile {
  display: none;
}

.info-scroll-container {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 20px;
  padding-left: 16px;
  scroll-padding-left: 16px;

/* Hide scrollbars */
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none;  /* IE + Edge */
}

.info-scroll-container::-webkit-scrollbar {
  display: none; /* Chrome, Safari */
}


.info-scroll-slide {
  flex: 0 0 auto;
  scroll-snap-align: start;
}

/* Mobile: Embla visible, scroll version hidden */
@media (max-width: 767px) {
  .info-carousel-desktop {
    display: none;
  }

  .info-carousel-mobile {
    display: block;
  }
}
  

