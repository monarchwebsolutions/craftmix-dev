{{- 'flickity.css' | asset_url | stylesheet_tag -}}
{{- 'flickity.pkgd.min.js' | asset_url | script_tag -}}
{{ 'custom-carousel-card-video.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-carousel-card-video.js' | asset_url }}" defer></script>
<script src="{{ 'custom-carousel.js' | asset_url }}" defer='defer'></script>
<link rel="stylesheet" href="{{ 'people-love-it-custom.css' | asset_url }}">

{% schema %}
{
  "name": "Landing Page Info Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "single_packet_image",
      "label": "Single Packet Image",
      "info": "Upload an image for the single packet display"
    }
  ],
  "blocks": [
    {
      "type": "carousel_card",
      "name": "Carousel Card",
      "settings": [
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL",
          "info": "Upload video to Content > Files, then paste the link here (e.g., .mp4, .mov)"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail Image"
        },
        {
          "type": "product",
          "id": "linked_product",
          "label": "Linked Product"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Landing Page Info Section"
    }
  ]
}
{% endschema %}

