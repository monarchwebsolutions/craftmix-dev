{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    const carouselRoot = document.querySelector('.landing-page_info_carousel');
    if (!carouselRoot) return;

    const viewport = carouselRoot.querySelector('.info_carousel_embla__viewport');
    EmblaCarousel(viewport, {
      loop: true,
      dragFree: true
    });
  });

{% endjavascript %}
{% style %}
  *,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

a {
  text-decoration: none;
}

img {
  max-width: 100%;
}

ul {
  list-style: none;
}

section.landing-page_info-section {
  background-color: #bfefff;
  position: relative;
  padding-top: 80px;
}

.landing-page_info-wrapper {
  max-width: 1400px;
  padding: 25px;
  margin: 0 auto;
}

h2.landing-page_info-heading {
  color: #002657;
  font-size: 72px;
  font-family: Hornbill;
  font-weight: 800;
  line-height: 86.4px;
  text-align: center;
  margin-bottom: 50px;
  position:relative;
}

.landing-page_info-section_cta-btn {
  font-family: 'Goldplay';
  font-weight: 600;
  font-size: 22px;
  text-transform: uppercase;
  line-height: 140%;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 16px 12px;
  gap: 3px;
  max-width: 492px;
  height: 69px;
  background: #fe6b00;
  color: #fff;
  border: 2px solid #000000;
  box-shadow: 4px 4px 0px #000000;
  border-radius: 100px;
  margin: 0 auto;
  margin-top: 80px;
  /* Inside auto layout */
  flex: none;
  order: 1;
  flex-grow: 0;
  z-index: 2;
  margin-bottom: 150px;
  transition: box-shadow 0.4s ease;
}

.landing-page_info-section_cta-btn:hover {
  box-shadow: none;
}

.info-top-heading {
  max-width: 803px;
  margin: 0 auto;
  margin-bottom: 40px;
}

.landing-page_info-images {
  position: relative;
  /* border: 1px solid red; */
}

.images-left,
.images-right {
  position: absolute;
  max-width: 300px;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  /* border: 1px solid red; */
}


.images-left {
  top: 0;
  left: 0;
}
.images-right {
  top: 0;
  right: 0;
}
.images-left img,
.images-right img {
  max-width: 200px;
  height: auto;
}

.images-left-1,
.images-left-3,
.images-right-2 {
  align-self: flex-end;
}

.image-center {
  text-align: center;
}

.image-center .image-center-main {
  max-width: 561px;
  width: 100%;
  height: auto;
  margin: 0 auto;
}

/* Carousel */
.landing-page_info_carousel {
  width: 100%;
  overflow: hidden;
  padding: 16px 0;
}

/* Scoped Embla for landing-page_info_carousel */
.landing-page_info_carousel {
  overflow: hidden;
  width: 100%;
  margin-bottom: 60px;
}

.info_carousel_embla__viewport {
  overflow: hidden;
  width: 100%;
}

.info_carousel_embla__container {
  display: flex;
  gap: 41px;
}


.info_carousel_embla__slide {
  flex: 0 0 80%;
  scroll-snap-align: center;
}

.landing-page_info_carousel-card {
  position: relative;
  flex: 0 0 auto;
  width: 508px; /* exact width */
  height: 647px; /* exact height */
  border-radius: 23px;
  overflow: hidden;
  background-color: #f9f9f9;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.landing-page_info_carousel-card:last-of-type {
    margin-right: 41px;
}

.landing-page_info_carousel-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.landing-page_info_carousel-card .card-label {
  position: absolute;
  top: 0;
  right: 0;
  background-color: rgba(255, 255, 255, 1);
  padding: 4px 10px;
  text-align: center;
  font-weight: 600;
  margin-top: 20px;
  margin-right: 20px;
  border-radius: 100px;
  z-index: 2;
}

.landing-page_info_carousel-wrapper {
  cursor: grab;
  cursor: -webkit-grab;
}

.landing-page_info_carousel-wrapper.dragging {
  cursor: grabbing;
  cursor: -webkit-grabbing;
}

/* Table */
.craftmix-love-table-card {
  position: relative;
  max-width: 1050px;
  width: 100%;
  margin: 0 auto;
  padding-top: 102px;
  transform-origin: top center;
}

.table-card-lg {
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  width: 100%;
  height: 616px;
  background-color: #ddf7f7;
  border-radius: 32px;
  border: 3px solid #000000;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.table-card-sm {
  position: absolute;
  width: 300px;
  height: 753px;
  background-color: #fff;
  border: 3px solid #002657;
  border-radius: 26px;
  top: 0px;
  right: 300px;
  z-index: 2;
  box-shadow: 3px 4px 0px 0px #002657;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.table-text-box {
  position: absolute;
  top: 0;
  right: 0;
  width: 300px;
  height: 102px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.table-text-box-text {
  font-family: "Goldplay";
  font-size: 28px;
  font-weight: 700;
  line-height: 140%;
  text-transform: uppercase;
  color: #000;
}
  
.table-row {
  display: flex;
  justify-content: space-between;
  align-items: center; /* vertical centering */
  height: calc(616px / 6); /* makes all rows exactly even */
  border-bottom: 2px solid #000;
  padding: 0 0; /* no vertical padding needed */
  font-size: 20px;
  font-weight: 500;
}

.table-row .left-item {
  padding-left: 24px;
}

.table-row .right-item,
.table-row .left-item,
.table-row .row-item {
  font-family: 'Hornbill';
  font-size: 32px;
  font-weight: 800;
  line-height: 120%;
}

.table-row .right-item {
  max-width: 300px;
  width: 100%;
  text-align: center;
  color: #8a8989;
}
.table-row .left-item {
  color: #000000;
}
.table-row .row-item {
  color: #00945e;
}

.table-card-sm .table-row {
  height: 101.67px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 2px solid #000;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.table-row:last-child {
  border-bottom: none;
}

.left-item,
.right-item {
  flex: 0 0 auto;
}

/* Last row - takes remaining height */
.table-card-sm .extra-row {
  height: auto;
  flex: 1; /* take up remaining space */
  border-bottom: none;
}

.row-item {
  font-size: 18px;
  font-weight: 500;
  text-align: center;
  width: 100%;
}


img.craftmix-table-logo {
  max-width: 243px;
  width: 100%;
  padding: 0 15px;
  margin: 0 auto;
}

img.row-item.tick,
img.cross {
  width: 43px;
  height: 43px;
}
img.cross {
 margin: 0 auto;
}

lottie-player.marquee.landing-page-info-section-marquee{
  position: absolute;
   top: auto !important;
  bottom: -50% !important;
  z-index:1;
  pointer-events: none;
  height:revert-layer !important;
}

@media (max-width: 1050px) {
  .table-card-sm {
    width: 200px;
    right: 200px;
  }
  .table-row .right-item {
    max-width: 200px;
  }
  .table-text-box {
    width: 200px;
  }
  .table-text-box-text {
    font-size: 22px;
    font-weight: 700;
    line-height: 140%;
  }
  .images-left img,
  .images-right img {
    max-width: 180px;
    height: auto;
  }
  .images-left, 
