<section class="custom-review-header">
   
   <div class="custom-review-header-wrapper">
      <h1 class="review-header-title">What Customers & Press Are Saying</h1>
      <p class="review-header-text">Whether it’s cocktails or mocktails, our customers can’t stop talking about how delicious and easy-to-make Craftmix is. Join the conversation and see what all the buzz is about!</p>
    </div>

    <div class="review-header-logo-carousel">
      <div class="review-header-logo-carousel-track">
         <img src="{{ 'GMA_logo.png' | asset_url }}" width="89" height="39" alt="GMA Logo">
         <img src="{{ 'billboard_logo.png' | asset_url }}" width="179" height="39" alt="Billboard Logo">
         <img src="{{ 'eat-this-not-that_logo.png' | asset_url }}" width="340" height="39" alt="Eat This Not That Logo">
         <img src="{{ 'taste-of-home_logo.png' | asset_url }}" width="265" height="39" alt="Taste Of Home Logo">
         <img src="{{ 'thrillist_logo.png' | asset_url }}" width="149" height="39" alt="Thrillist Logo">
          <!-- Duplicate for smooth scrolling -->
        <img src="{{ 'GMA_logo.png' | asset_url }}" width="89" height="39" alt="GMA Logo">
         <img src="{{ 'billboard_logo.png' | asset_url }}" width="179" height="39" alt="Billboard Logo">
         <img src="{{ 'eat-this-not-that_logo.png' | asset_url }}" width="340" height="39" alt="Eat This Not That Logo">
         <img src="{{ 'taste-of-home_logo.png' | asset_url }}" width="265" height="39" alt="Taste Of Home Logo">
         <img src="{{ 'thrillist_logo.png' | asset_url }}" width="149" height="39" alt="Thrillist Logo">
      </div>
    </div>

   <div class="review-header-stories">
    <div class="custom-review-header-wrapper">
      <h5 class="review-header-stories-subheader">A Few Of Our</h5>
      <h4 class="review-header-stories-heading">Customer Stories</h4>

      <div class="review-header-stories-cards">
       
        <!-- Review Card -->

         {% for block in section.blocks %}
          {% if block.type == "review_card"  %}
            <div class="review-header-stories-card" {{ block.shopify_attributes }}>
              <div class="review-header-stories-card-title">
                {{ block.settings.card_title }}
              </div>
              <div class="review-header-stories-card-body" style="background-color: {{ block.settings.background_color }};">
                <div class="review-header-stories-card-body-image">
                  {% if block.settings.review_image %}
                    <img src="{{ block.settings.review_image | img_url: 'medium' }}" width="157" height="225" alt="Review Image">
                  {% endif %}
                </div>
                <div class="review-header-stories-card-body-text">
                  <img class="review-header-stories-card-body-text-stars" src="{{ 'stars-dark.png' | asset_url }}" width="80" height="14" alt="review stars">
                  <p class="review-header-stories-card-body-text-review">"{{ block.settings.review_text }}"</p>
                  <p class="review-header-stories-card-body-text-reviewer">{{ block.settings.reviewer_name }} - {{ block.settings.review_date }}</p>
                </div>
              </div>
              <div class="review-header-stories-card-product">
                {% if block.settings.linked_product != blank %}
                  <a href="{{ block.settings.linked_product.url }}">
                    <img src="{{ block.settings.linked_product.images.last | img_url: 'medium' }}" width="50" height="43" alt="Product Image" class="review-header-stories-card-product-img">
                  </a>
                  <div class="review-header-stories-card-product-product-info">
                    <a href="{{ block.settings.linked_product.url }}">
                      <h4 class="review-header-stories-card-product-product-info-title">
                        {{ block.settings.linked_product.title | remove_first: "2025 - "}}
                      </h4>
                    </a>
                    <p class="review-header-stories-card-product-product-info-price">
                      {{ block.settings.linked_product.variants.first.title }} - {{ block.settings.linked_product.price | money }}
                    </p>
                  </div>
                  <div class="review-header-stories-card-product-product-cta">
                    <form method="post" action="/cart/add">
                      <input type="hidden" name="id" value="{{ block.settings.linked_product.variants.first.id }}">
                      <button type="submit" style="background-color: {{ block.settings.button_color }}; color: {{ block.settings.button_text_color }};">Add</button>
                    </form>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}

        <!--End Review Card -->
      </div>
    </div>
  </div>
    
  <div class="custom-sub-carousel-section">
    <div>
      <div class="custom-sub-carousel-header">
        <h5 class="custom-sub-carousel-subheader">customer Favorites </h5>
        <h3 class="custom-sub-carousel-heading">What Our Fans Say</h3>
      </div>
      <div class="custom-video-review-carousel-nav">
        <button class="flickity-button flickity-prev-next-button custom-carousel-prev previous disabled" type="button" aria-label="Previous" disabled=""><svg class="flickity-button-icon" viewBox="0 0 100 100"><path d="M 10,50 L 60,100 L 70,90 L 30,50  L 70,10 L 60,0 Z" class="arrow"></path></svg></button>
        <button class="flickity-button flickity-prev-next-button custom-carousel-next next" type="button" aria-label="Next"><svg class="flickity-button-icon" viewBox="0 0 100 100"><path d="M 10,50 L 60,100 L 70,90 L 30,50  L 70,10 L 60,0 Z" class="arrow" transform="translate(100, 100) rotate(180) "></path></svg></button>
      </div>
      <div class="custom-sub--carousel-container">
        
        <div class="custom-video-review-carousel-container">
          {% render 'review-video-carousel-inner' %}
        </div>
  
      </div>
    </div>
  </div>
  <img class="background-fruit pineapple-bg" alt="Pinapple" width="222" height="286" src="{{ 'pineapple.svg' | asset_url }}" role="presentation">
   <img class="background-fruit mint-leaf-bg" alt="Mint leaf" width="264" height="315" src="{{ 'mint-leaf.svg' | asset_url }}" role="presentation">
   <img class="background-fruit mint_pink-bg" alt="Pink leaf" width="180" height="214" src="{{ 'mint_pink.png' | asset_url }}" role="presentation">
   <img class="background-fruit blueberry-bg" alt="Balueberry" width="105" height="111" src="{{ 'blueberry.svg' | asset_url }}" role="presentation">
</section>


{% javascript %}
document.addEventListener('DOMContentLoaded', () => {
  const cards = document.querySelectorAll('.custom-sub-review-carousel-card');
  const videos = document.querySelectorAll('.custom-video-review-carousel-video');

  cards.forEach(card => {
    const video = card.querySelector('.custom-video-review-carousel-video');
    const playBtn = card.querySelector('.play-btn');
    const volumeBtn = card.querySelector('.volume-btn');
    const volumeIcon = volumeBtn.querySelector('.volume-icon');
    const muteIcon = volumeBtn.querySelector('.mute-icon');

    // Fade-in fix: Add 'ready' class once video is actually rendering a frame
    video.addEventListener('playing', () => {
      video.classList.add('ready');
    });

    // Play/Pause Button Click
    playBtn.addEventListener('click', () => {
      if (video.paused) {
        pauseAllVideos(video); // Ensure only one video plays
        video.play();
        playBtn.style.display = 'none';
      } else {
        video.pause();
        playBtn.style.display = 'block';
      }
    });

    // Video Click to Play/Pause
    video.addEventListener('click', () => {
      if (video.paused) {
        pauseAllVideos(video);
        video.play();
        playBtn.style.display = 'none';
      } else {
        video.pause();
        playBtn.style.display = 'block';
      }
    });

    // Reset Play Button when Video Ends
    video.addEventListener('ended', () => {
      playBtn.style.display = 'block';
    });

    // Volume Control Button
    volumeBtn.addEventListener('click', () => {
      if (video.muted) {
        video.muted = false;
        volumeIcon.style.display = 'block';
        muteIcon.style.display = 'none';
      } else {
        video.muted = true;
        volumeIcon.style.display = 'none';
        muteIcon.style.display = 'block';
      }
    });
  });

  // Function to Pause All Other Videos
  function pauseAllVideos(currentVideo) {
    videos.forEach(video => {
      if (video !== currentVideo) {
        video.pause();
      }
    });
  }

  // Pause Videos When They Go Out of View
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) {
        entry.target.pause();
      }
    });
  }, { threshold: 0.1 });

  videos.forEach(video => observer.observe(video));
});
{% endjavascript %}
