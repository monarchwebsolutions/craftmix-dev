}
  
/* Media Queries */
@media (max-width: 1300px) {
  .review-header-stories-cards {
    display: flex;
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
  }
  .review-header-stories-cards .item:last-child {
    width: 100%;
    text-align: center;
  }
}



@media (max-width: 876px) {
  .review-header-stories-cards {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
}

@media (max-width: 768px) {
  .review-header-logo-carousel {
    height: 60px; 
    margin-bottom: 80px;
  }
  
  .review-header-logo-carousel-track {
      display: flex;
      gap: 70px; 
      animation: scrollLogos 20s linear infinite;
      align-items: center; 
  }
  
  .review-header-logo-carousel-track img {
    max-height: 26px; 
    width: auto; 
    object-fit: contain; 
  }

  .custom-sub-carousel-heading {
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -1.05px;
    text-align: center;
    line-height: 40px;
    margin-bottom:30px;
  }  
  .custom-review-header .custom-video-review-carousel-nav{
    top:310px;
  }
}
  
@media (max-width: 528px) {
  .review-header-title {
    font-size: 40px;
    letter-spacing: -1.05px;
    line-height: 40px;
    margin-bottom: 20px;
  }
  .review-header-text {
    margin-bottom: 21px;
  }
  .review-header-carousel {
    width: 100%;
    height: 60px;
    margin-bottom: 68px;
    background-color: #ddf7f7;
  }
  .review-header-stories-heading {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.79px;
    line-height: 35px;
    margin-bottom: 37px;
  }
  .custom-sub-review-carousel-card.first-card {
  margin-left: 0px;
}
}
@media (max-width: 400px) {
  .review-header-stories-card-body-text {
    flex-grow: 1;
    padding: 15px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
}

@media (max-width: 360px) {
  .review-header-stories-card-body-text-review {
    font-size: 12px;
    font-weight: 500;
    line-height: 15px;
  }
}





