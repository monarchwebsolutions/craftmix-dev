/* first-card class added to first card in carousel for margin */
.custom-video-review-carousel-card {
  margin-left: 25px;
}

.custom-sub-review-carousel-card.first-card {
  margin-left: 25px;
}

.custom-video-review-carousel-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 68px;
  height: 68px;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.play-btn img {
  width: 68px;
  height: 68px;
}

.volume-btn {
  position: absolute;
  top: 10px;
  right: 10px;
  background-color: #fff;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  transition: background-color 0.3s ease;
  border: 2px solid rgba(0, 38, 87, 1);
}

.volume-btn:hover {
  background-color: rgba(255, 255, 255, 0.9);
}

.volume-btn img {
  width: 20px;
  height: 20px;
}

.product-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 12px 15px 10px 15px ;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
  margin-left: 10px;
  margin-right: 10px;
  border-radius: 20px;
}

.product-info-text {
  flex-grow: 1;
}

.stars img {
  width: 55px;
  height: auto;
}

.product-title {
  margin: 5px 0 0 0;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 15px;
  font-weight: 600;
  letter-spacing: -0.09px;
  text-align: left;
  line-height: 16px;
}

.product-variant {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: "Goldplay";
  font-size: 15px;
  font-weight: 500;
  font-style: Medium;
  letter-spacing: -0.09px;
  text-align: left;
  line-height: 19px;
}

.product-info-cta-btn {
  font-family: "Goldplay";
  background-color: rgba(96, 211, 248, 1);
  color: rgba(0, 38, 87, 1);
  padding: 10px 28px;
  border-radius: 20px;
  text-decoration: none;
  font-weight: 600;
  font-size: 18px;
  line-height: 22px;
  border-radius: 23px;
  border: 1.5px solid rgba(0, 38, 87, 1);

}

.custom-video-review-carousel-cta {
  text-align: center;
}

.custom-video-review-carousel-cta-btn {
  display: inline-block;
  border: 1.5px solid rgba(0, 38, 87, 1);
  box-shadow: 2px 2px 0px rgba(0, 38, 87, 1);
  border-radius: 30px;
  opacity: 1;
  background-color: rgba(96, 211, 248, 1);
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
