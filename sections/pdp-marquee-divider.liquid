{% assign top_section_bg = '#EAD1FA' | default: '#ffffff' %}
<!-- {% assign bottom_section_bg = product.metafields.custom.color_3 | default: '#ffffff' %} -->
{% assign bottom_section_bg = '#333333' %}


<div class="marquee-container pdp-marquee-divider">
  <div class="marquee-top" style="background-color: {{ top_section_bg }}"></div>
  <div class="marquee-bottom" style="background-color: {{ bottom_section_bg }}"></div>
  {% if section.settings.lottie_file %}
    <lottie-player class="section-wave marquee" 
      src="{{ section.settings.lottie_file | asset_url }}" 
      background="transparent"  
      speed="0.6"  
      loop autoplay>
    </lottie-player>
  {% endif %}
</div>

