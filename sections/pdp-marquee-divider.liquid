{% schema %}
{
  "name": "PDP Marquee Divider",
  "tag": "section",
  "class": "section",
  "presets": [
    {
      "name": "PDP Marquee Divider"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "lottie_file",
      "label": "Lottie Animation File Name (from assets)"
    }
  ]
}
{% endschema %}